{
  "schemaVersion": 1,
  "nodes": [
    {
      "id": "official-node",
      "executor": "electron.ensure-carrier",
      "dependsOn": [],
      "blocking": true,
      "label": "Verifying the official Node carrier…",
      "timeoutMs": 300000
    },
    {
      "id": "standalone-generation",
      "executor": "standalone.resolve",
      "dependsOn": ["official-node"],
      "blocking": true,
      "label": "Resolving the Standalone generation…",
      "timeoutMs": 30000
    },
    {
      "id": "standalone-ready",
      "executor": "standalone.await-ready",
      "dependsOn": ["standalone-generation"],
      "blocking": true,
      "label": "Waiting for explicit readiness…",
      "timeoutMs": 30000
    },
    {
      "id": "placeholder-renderer",
      "executor": "electron.mount-renderer",
      "dependsOn": ["standalone-ready"],
      "blocking": true,
      "label": "Opening the placeholder renderer…",
      "timeoutMs": 20000
    }
  ]
}
