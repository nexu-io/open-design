{
  "name": "@open-design/shell-electron",
  "version": "0.19.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./standalone-launcher": {
      "default": "./dist/standalone-launcher.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @open-design/standalone build && node ./esbuild.config.mjs && tsc -p tsconfig.json",
    "test": "pnpm --filter @open-design/standalone build && vitest run -c vitest.config.ts",
    "typecheck": "pnpm --filter @open-design/standalone build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@open-design/contracts": "workspace:*",
    "@open-design/diagnostics": "workspace:*",
    "@open-design/download": "workspace:*",
    "@open-design/host": "workspace:*",
    "@open-design/platform": "workspace:*",
    "@open-design/release": "workspace:*",
    "@open-design/sidecar": "workspace:*",
    "@open-design/standalone": "workspace:*"
  },
  "devDependencies": {
    "@open-design/closure": "workspace:*",
    "@types/node": "24.12.2",
    "electron": "41.3.0",
    "esbuild": "0.28.0",
    "jszip": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
