{
  "name": "@open-design/shell-electron",
  "version": "0.16.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./standalone-launcher": {
      "default": "./dist/standalone-launcher.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @open-design/standalone-proto build && pnpm --filter @open-design/standalone-runtime build && node ./esbuild.config.mjs && tsc -p tsconfig.json",
    "test": "pnpm --filter @open-design/standalone-proto build && pnpm --filter @open-design/standalone-runtime build && vitest run -c vitest.config.ts",
    "typecheck": "pnpm --filter @open-design/standalone-proto build && pnpm --filter @open-design/standalone-runtime build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@open-design/closure-store": "workspace:*",
    "@open-design/closure-update": "workspace:*",
    "@open-design/contracts": "workspace:*",
    "@open-design/daemon": "workspace:*",
    "@open-design/diagnostics": "workspace:*",
    "@open-design/download": "workspace:*",
    "@open-design/host": "workspace:*",
    "@open-design/standalone-runtime": "workspace:*",
    "@open-design/launcher-proto": "workspace:*",
    "@open-design/platform": "workspace:*",
    "@open-design/release": "workspace:*",
    "@open-design/sidecar": "workspace:*",
    "@open-design/sidecar-proto": "workspace:*",
    "@open-design/standalone-proto": "workspace:*",
    "@open-design/web": "workspace:*"
  },
  "devDependencies": {
    "@open-design/closure-proto": "workspace:*",
    "@types/node": "24.12.2",
    "electron": "41.3.0",
    "esbuild": "0.28.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
