{
  "schemaVersion": 1,
  "shutdown": {
    "gracefulTimeoutMs": 75000
  },
  "rendererRecovery": {
    "policy": {
      "crashLimit": 5,
      "windowMs": 60000,
      "cooldownMs": 300000
    },
    "prompt": {
      "title": "OpenDesign renderer recovery",
      "message": "The application window has crashed repeatedly.",
      "detail": "Automatic recovery is paused. You can retry now or quit. Another recovery attempt will run after five minutes.",
      "retryLabel": "Retry",
      "quitLabel": "Quit"
    }
  },
  "preflight": {
    "schemaVersion": 1,
    "atoms": [
      {
        "id": "os-language",
        "executor": "electron.preferred-language"
      },
      {
        "id": "local-service-connections",
        "executor": "electron.connection-limit-exemptions",
        "hosts": ["127.0.0.1", "localhost"]
      }
    ]
  },
  "warmup": {
    "schemaVersion": 1,
    "maxConcurrency": 4,
    "totalTimeoutMs": 360000,
    "nodes": [
      {
        "id": "standalone-generation",
        "executor": "standalone.resolve",
        "dependsOn": [],
        "blocking": true,
        "label": "Resolving the Standalone generation…",
        "timeoutMs": 30000
      },
      {
        "id": "standalone-ready",
        "executor": "standalone.await-ready",
        "dependsOn": ["standalone-generation"],
        "blocking": true,
        "label": "Waiting for explicit readiness…",
        "timeoutMs": 30000
      },
      {
        "id": "renderer-resource",
        "executor": "shell.renderer-resource",
        "dependsOn": ["standalone-ready"],
        "blocking": true,
        "failure": "required",
        "label": "Preparing Shell resources…",
        "timeoutMs": 5000
      },
      {
        "id": "product-renderer",
        "executor": "electron.mount-renderer",
        "dependsOn": ["renderer-resource"],
        "blocking": true,
        "label": "Opening the product renderer…",
        "timeoutMs": 20000
      }
    ]
  }
}
