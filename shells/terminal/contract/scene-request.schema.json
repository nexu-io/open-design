{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexu.io/contracts/terminal/scene-request-v2.schema.json",
  "title": "Terminal target scene request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "target", "shellVersion", "node", "closureArtifactFile", "standaloneLauncherFile", "standaloneDirectory", "sidecarDirectory", "platformDirectory", "sceneDirectory"],
  "properties": {
    "schemaVersion": {"const": 2},
    "operation": {"const": "terminal.scene.build"},
    "target": {"enum": ["darwin-arm64", "darwin-x64", "win32-x64"]},
    "shellVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "platformDirectory", "archiveSha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "platformDirectory": {"type": "string", "minLength": 1},
        "archiveSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "closureArtifactFile": {"type": "string", "minLength": 1},
    "standaloneLauncherFile": {"type": "string", "minLength": 1},
    "standaloneDirectory": {"type": "string", "minLength": 1},
    "sidecarDirectory": {"type": "string", "minLength": 1},
    "platformDirectory": {"type": "string", "minLength": 1},
    "sceneDirectory": {"type": "string", "minLength": 1}
  }
}
