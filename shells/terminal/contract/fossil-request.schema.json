{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexu.io/contracts/terminal/fossil-request-v3.schema.json",
  "title": "Terminal fossil request with updater protocol v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "channel", "namespace", "carrierResolutionFile"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"enum": ["probe", "start", "heartbeat", "release", "stop", "status", "prepare-update", "apply-update", "apply-update-force", "shell-update-status", "shell-update-check", "shell-update-download", "shell-update-install", "shell-update-later", "shell-update-force", "shell-update-confirm", "shell-update-abandon"]},
    "channel": {"type": "string", "pattern": "^[a-z0-9]{1,12}$", "not": {"const": "local"}},
    "namespace": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "carrierResolutionFile": {"type": "string", "minLength": 1},
    "storeRoot": {"type": "string", "minLength": 1},
    "channelHeadUrl": {"type": "string", "pattern": "^(https?|file)://"},
    "attachmentId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "attachmentCapability": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "updateProtocolVersion": {"const": 3},
    "activationPolicy": {"enum": ["observe", "authorize-silent", "authorize-user", "revoke-silent"]},
    "feedbackFile": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"not": {"const": "probe"}}}}, "then": {"required": ["storeRoot"]}},
    {"if": {"properties": {"operation": {"enum": ["start", "heartbeat", "release"]}}}, "then": {"required": ["attachmentId"]}},
    {"if": {"properties": {"operation": {"enum": ["prepare-update", "apply-update", "apply-update-force"]}}}, "then": {"required": ["updateProtocolVersion"]}},
    {"if": {"properties": {"operation": {"const": "prepare-update"}}}, "then": {"required": ["channelHeadUrl", "activationPolicy"]}}
  ]
}
