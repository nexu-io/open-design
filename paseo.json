{
  "worktree": {
    "setup": [
      "corepack pnpm install --frozen-lockfile",
      "corepack pnpm --filter @open-design/daemon rebuild better-sqlite3 --pending"
    ],
    "teardown": "corepack pnpm tools-dev paseo-workspace stop"
  },
  "scripts": {
    "dev": {
      "command": "corepack pnpm tools-dev paseo-workspace run"
    },
    "status": {
      "command": "corepack pnpm tools-dev paseo-workspace status --json"
    }
  }
}
