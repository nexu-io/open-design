{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter @open-design/web build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/out",
  "framework": null,
  "rewrites": [
    { "source": "/((?!_next|favicon.ico).*)", "destination": "/index.html" }
  ]
}
