# Image published by this repository's Docker workflow.
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:latest

# Host port exposed on 127.0.0.1 by docker compose.
# Keep Compose bound to localhost; use an authenticated reverse proxy, SSH tunnel,
# or VPN before exposing Open Design remotely.
OPEN_DESIGN_PORT=7456

# Comma-separated browser origins allowed to call /api when deployed behind a
# domain, public IP, or reverse proxy, e.g. https://od.example.com,http://203.0.113.10:7456.
# Maps directly to container env OD_ALLOWED_ORIGINS.
OD_ALLOWED_ORIGINS=

# Comma-separated list of additional directories the agent's spawned CLI is
# allowed to read/write inside the container.
OD_ADDITIONAL_ALLOWED_DIRS=

# WARNING: When 1, any browser on your private subnet can auth without
# OD_API_TOKEN (trusts RFC1918 as loopback).  docker-compose.yml defaults
# to 1 (needed when port-published behind Docker Desktop).  Set to 0 to
# harden a LAN/remote deployment.
OD_BOOTSTRAP_ALLOW_PRIVATE_SUBNET=0

# API auth is disabled by default in docker-compose.yml (OD_DISABLE_API_AUTH=1).
# The host port is bound to 127.0.0.1, so only the Docker host can reach the daemon.
# To enable token-based auth, add `OD_DISABLE_API_AUTH=0` to your .env, then
# generate a secure 32-byte hex token by running `openssl rand -hex 32` and paste it below.
OD_API_TOKEN=

# Externally-reachable web UI port for origin/CORS validation.
# Auto-derived from OPEN_DESIGN_PORT; only set this explicitly if the
# browser-visible port differs from OPEN_DESIGN_PORT (e.g. behind a
# reverse proxy remapping ports).
OD_WEB_PORT=

# Hop count (1), specific IP (172.18.0.1), or comma-separated list of IPs/CIDRs
# to trust for X-Forwarded-* headers.  Needed when the daemon is behind a
# reverse proxy that forwards client IPs.  Default (empty) trusts no proxy.
OD_TRUST_PROXY=

# Externally-reachable base URL for the daemon.
# Set this when the daemon generates links that must reach the public endpoint
# (e.g. https://od.example.com).  Empty = derive from the incoming request.
OD_PUBLIC_BASE_URL=

# Optional Codex CLI sandbox override. Set to danger-full-access only when
# Codex fails with workspace-write sandbox setup errors inside the container.
OD_CODEX_SANDBOX=

# Container memory limit. The idle service uses approximately 18-22 MiB.
# Raise this for large exports, concurrent agent runs, or heavy upload workflows.
OPEN_DESIGN_MEM_LIMIT=384m

# Node.js heap cap inside the container.
NODE_OPTIONS=--max-old-space-size=192
