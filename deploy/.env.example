# Image published by deploy/scripts/publish-images.sh.
OPEN_DESIGN_IMAGE=docker.io/vanjayak/open-design:latest

# Host port exposed on 127.0.0.1 by docker compose.
# Keep Compose bound to localhost; use an authenticated reverse proxy, SSH tunnel,
# or VPN before exposing Open Design remotely.
OPEN_DESIGN_PORT=7456

# Comma-separated browser origins allowed to call /api when deployed behind a
# domain, public IP, or reverse proxy, e.g. http://203.0.113.10:7456,https://od.example.com.
OPEN_DESIGN_ALLOWED_ORIGINS=

# ---- Authentication (two supported modes) ----
#
# Bearer token (simplest, no proxy required)
#   Set OD_ACCESS_TOKEN to a random hex string. Every /api/* request must carry
#   Authorization: Bearer <token>. Loopback requests (127.0.0.1) are exempt.
#   Generate: openssl rand -hex 32
#
# Trusted reverse proxy (production-grade, for reverse-proxy deployments)
#   Set OD_TRUSTED_PROXY to the name of your trusted proxy (e.g. cloudflare, nginx, caddy).
#   The daemon trusts X-Forwarded-* headers from that proxy. Pair with
#   OPEN_DESIGN_ALLOWED_ORIGINS for origin validation. This is the recommended
#   mode when running behind a reverse proxy in production.
#
# Backward compatibility: the server still accepts OD_API_TOKEN as a deprecated
# fallback, but new deployments should use OD_ACCESS_TOKEN.

# --- Bearer token ---
# Generate: openssl rand -hex 32
OD_ACCESS_TOKEN=

# --- Trusted reverse proxy ---
# Set to the name of your trusted reverse proxy (e.g. cloudflare, nginx, caddy).
# The daemon will trust X-Forwarded-* headers from this proxy.
# Recommended for production deployments behind a reverse proxy.
# OD_TRUSTED_PROXY=

# Container memory limit. The idle service has been verified around 18-22 MiB.
# Raise this for large exports, concurrent agent runs, or heavy upload workflows.
OPEN_DESIGN_MEM_LIMIT=384m

# Node.js heap cap inside the container.
NODE_OPTIONS=--max-old-space-size=192

# Optional Codex CLI sandbox override. Set to danger-full-access only when
# Codex fails with workspace-write sandbox setup errors inside the container.
OD_CODEX_SANDBOX=
