# Image published by deploy/scripts/publish-images.sh.
OPEN_DESIGN_IMAGE=docker.io/vanjayak/open-design:latest

# Host port exposed on 127.0.0.1 by docker compose.
# Keep Compose bound to localhost; use an authenticated reverse proxy, SSH tunnel,
# or VPN before exposing Open Design remotely.
OPEN_DESIGN_PORT=7456

# Comma-separated browser origins allowed to call /api when deployed behind a
# domain, public IP, or reverse proxy, e.g. http://203.0.113.10:7456,https://od.example.com.
OPEN_DESIGN_ALLOWED_ORIGINS=

# ---- Authentication (choose ONE, mutually exclusive) ----
#
# Option A: Bearer token (simplest, no proxy required)
#   Set OD_API_TOKEN to a random hex string. Every /api/* request must carry
#   Authorization: Bearer <token>. Loopback requests (127.0.0.1) are exempt.
#   Generate: openssl rand -hex 32
#
# Option B: Cloudflare Access JWT (requires Cloudflare Access in front)
#   Set OD_BEHIND_PROXY=cloudflare + OD_CF_ACCESS_TEAM_DOMAIN + OD_CF_ACCESS_AUD.
#   Every /api/* request must carry a valid Cf-Access-Jwt-Assertion header.
#   In this mode, OD_API_TOKEN is ignored and loopback callers are NOT exempt.
#
# These modes are MUTUALLY EXCLUSIVE. Do not set both.

# --- Option A: Bearer token ---
# Generate: openssl rand -hex 32
OD_API_TOKEN=

# --- Option B: Cloudflare Access JWT ---
# Set to "cloudflare" to enable Cloudflare Access JWT validation.
# OD_BEHIND_PROXY=cloudflare

# Your Cloudflare Access team domain (e.g. myteam.cloudflareaccess.com).
# Must end with .cloudflareaccess.com (or set OD_CF_ACCESS_UNSAFE_DOMAIN=1 in dev).
# Required when OD_BEHIND_PROXY=cloudflare.
# OD_CF_ACCESS_TEAM_DOMAIN=

# The Application Audience (AUD) tag from your Cloudflare Access application.
# Required when OD_BEHIND_PROXY=cloudflare.
# OD_CF_ACCESS_AUD=

# Container memory limit. The idle service has been verified around 18-22 MiB.
# Raise this for large exports, concurrent agent runs, or heavy upload workflows.
OPEN_DESIGN_MEM_LIMIT=384m

# Node.js heap cap inside the container.
NODE_OPTIONS=--max-old-space-size=192

# Optional Codex CLI sandbox override. Set to danger-full-access only when
# Codex fails with workspace-write sandbox setup errors inside the container.
OD_CODEX_SANDBOX=
