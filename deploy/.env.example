# Image published by this repository's Docker workflow.
OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:latest

# Host port exposed on 127.0.0.1 by docker compose.
# Keep Compose bound to localhost; use an authenticated reverse proxy, SSH tunnel,
# or VPN before exposing OpenDesign remotely.
OPEN_DESIGN_PORT=7456

# Comma-separated browser origins allowed to call /api when deployed behind a
# domain, public IP, or reverse proxy, e.g. http://203.0.113.10:7456,https://od.example.com.
OPEN_DESIGN_ALLOWED_ORIGINS=

# Recommended unless OPEN_DESIGN_DISABLE_API_AUTH=1 is set behind a trusted,
# already-authenticated reverse proxy.
# Generate a secure 32-byte hex token by running `openssl rand -hex 32` and paste it below.
OD_API_TOKEN=

# Optional escape hatch for deployments whose reverse proxy already authenticates
# every request before it reaches the daemon. Set to 1 only for trusted setups;
# when enabled, the daemon skips OD_API_TOKEN enforcement entirely.
#
# Note: connector endpoints (Composio, GitHub OAuth) also require the daemon to
# receive requests over loopback. On Linux Docker this is handled automatically
# by docker-compose.linux.yml (network_mode: host). On macOS/Windows use
# a reverse proxy bound to 127.0.0.1.

OPEN_DESIGN_DISABLE_API_AUTH=

# Container memory limit. The idle service has been verified around 18-22 MiB.
# Raise this for large exports, concurrent agent runs, or heavy upload workflows.
OPEN_DESIGN_MEM_LIMIT=384m

# Node.js heap cap inside the container.
NODE_OPTIONS=--max-old-space-size=192

# Optional Codex CLI sandbox override. Set to danger-full-access only when
# Codex fails with workspace-write sandbox setup errors inside the container.
OD_CODEX_SANDBOX=

# Optional off-screen slide renderer, for PPTX / raster-PDF / image export.
#
# This image ships no browser, so those exports answer 501 and the UI hides or
# falls back accordingly — that is the default and needs no configuration.
#
# Set this to the base URL of an HTTP service you run, and the daemon will
# render through it and advertise the capability. Nothing is downloaded or
# started for you; you supply and operate that service.
#
# The wire protocol it must implement — request, both failure shapes, and the
# versioned binary success frame — is specified in full in:
#   packages/sidecar-proto/src/slide-renderer-http.ts
# That module also exports the frame codec, so an implementation in this
# workspace can encode with the same helper the daemon decodes with.
OD_SLIDE_RENDERER_URL=

# Where the RENDERER should reach this daemon, when the two are in different
# containers. Required in that case, and easy to miss because omitting it fails
# silently: the daemon tells the renderer to load relative images, fonts and
# stylesheets from its own address, which inside this container is loopback and
# therefore points back at the renderer. The deck still renders — just without
# any of its external assets.
#
# Use the address the renderer's network can resolve, e.g. the compose service
# name: http://open-design:7456
#
# This is not OD_PUBLIC_BASE_URL. That one is the externally routable address
# browsers use, which may be a proxied public hostname; this is container-to-
# container. Leave empty when the renderer shares a network namespace with the
# daemon and loopback already works.
#
# One value to avoid: do NOT use the swapped spelling of the daemon's own host
# (http://localhost:... when it reports 127.0.0.1, or the reverse). The daemon
# reserves that alias for powered previews and answers 403 to browser-shaped
# requests on every other /api route, so assets would fail to load with no
# obvious cause. Use the real service name or address instead.
OD_SLIDE_RENDERER_DAEMON_URL=
