{
  "name": "@open-design/closure-update",
  "version": "0.16.2",
  "private": true,
  "type": "module",
  "description": "Shell-neutral release selection and update orchestration for Open Design Standalone Closure.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsx ./esbuild.config.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@open-design/closure-proto": "workspace:*",
    "@open-design/closure-store": "workspace:*",
    "@open-design/download": "workspace:*",
    "@open-design/platform": "workspace:*",
    "@open-design/release": "workspace:*",
    "extract-zip": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "jszip": "3.10.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
