{
  "name": "@open-design/electron-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime-api.d.ts",
      "default": "./dist/runtime-api.mjs"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.mjs"
    },
    "./sidecar": {
      "types": "./dist/integrations/sidecar/index.d.ts",
      "default": "./dist/integrations/sidecar/index.mjs"
    },
    "./shortcuts": {
      "types": "./dist/integrations/shortcuts/index.d.ts",
      "default": "./dist/integrations/shortcuts/index.mjs"
    },
    "./distribution": {
      "types": "./dist/distribution/index.d.ts",
      "default": "./dist/distribution/index.mjs"
    },
    "./dev": {
      "types": "./dist/commands/dev.d.ts",
      "default": "./dist/commands/dev.mjs"
    },
    "./pack": {
      "types": "./dist/commands/pack.d.ts",
      "default": "./dist/commands/pack.mjs"
    }
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@open-design/sidecar": "workspace:*",
    "@open-design/standalone": "workspace:*",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "electron": "41.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "electron": "41.3.0"
  },
  "engines": {"node": "~24"}
}
