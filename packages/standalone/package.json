{
  "name": "@open-design/standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shell-neutral exact distribution, generation, and launcher runtime.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    "./packages": { "types": "./dist/packages/index.d.ts", "default": "./dist/packages/index.mjs" },
    "./packages/build": { "types": "./dist/packages/build.d.ts", "default": "./dist/packages/build.mjs" },
    "./packages/resource": { "types": "./dist/packages/resource.d.ts", "default": "./dist/packages/resource.mjs" },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsx ./esbuild.config.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@open-design/download": "workspace:*",
    "@open-design/platform": "workspace:*",
    "esbuild": "0.28.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {"node": "~24"}
}
