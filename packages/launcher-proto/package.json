    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@open-design/release": "workspace:*",
    "@open-design/sidecar-proto": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
