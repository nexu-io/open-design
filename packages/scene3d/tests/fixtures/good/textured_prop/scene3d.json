{
  "schemaVersion": 1,
  "conventions": {
    "naming": {
      "objectPattern": "^[A-Za-z][A-Za-z0-9_]{2,63}$",
      "forbidDefaultNames": true,
      "partPrefixes": ["prp_", "cam_", "lgt_"]
    },
    "units": { "metersPerUnit": 1, "upAxis": "Y" },
    "pbr": { "metallicValues": [0, 1], "roughnessRange": [0, 1] }
  }
}
