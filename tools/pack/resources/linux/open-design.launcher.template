#!/bin/sh
# Generated by `tools-pack linux install`. Reinstall to regenerate.
#
# The AppImage runtime mounts its SquashFS before AppRun executes, so a host
# without libfuse.so.2 cannot start the AppImage directly. This launcher keeps
# the cached/FUSE path when mounting works and falls back to the runtime's
# extract path when it does not. The extract path cannot populate the AppRun
# cache, so hosts that can mount keep the fast cached launch.
set -u

APPIMAGE=@@APPIMAGE_PATH@@
NAMESPACE=@@NAMESPACE@@

appimage_can_mount() {
  case "${OD_APPIMAGE_FUSE:-auto}" in
    on) return 0 ;;
    off) return 1 ;;
  esac

  [ -r /dev/fuse ] || return 1
  if command -v ldconfig >/dev/null 2>&1 && ldconfig -p 2>/dev/null | grep -q 'libfuse\.so\.2' ; then
    return 0
  fi
  for lib in /usr/lib/libfuse.so.2 /lib/libfuse.so.2 /usr/lib64/libfuse.so.2 /lib64/libfuse.so.2 ; do
    [ -e "$lib" ] && return 0
  done
  return 1
}

if appimage_can_mount ; then
  exec env -u ELECTRON_RUN_AS_NODE OD_PACKAGED_NAMESPACE="$NAMESPACE" "$APPIMAGE" "$@"
fi

# No FUSE: the runtime extracts before AppRun starts. NO_CLEANUP keeps that
# tree alive for the detached desktop sidecars, which outlive the launcher.
exec env -u ELECTRON_RUN_AS_NODE OD_PACKAGED_NAMESPACE="$NAMESPACE" NO_CLEANUP=1 "$APPIMAGE" --appimage-extract-and-run "$@"
