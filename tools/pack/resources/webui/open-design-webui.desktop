[Desktop Entry]
Type=Application
Name=Open Design WebUI
Comment=Start Open Design WebUI in a terminal
Exec=sh -c 'p="%k"; enc=0; case "$p" in [Ff][Ii][Ll][Ee]://*) p="${p#???????}"; case "$p" in /*) : ;; [Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]/*) p="/${p#*/}";; *) echo "open-design-webui: unsupported file URI authority in .desktop location: $p" >&2; exec $SHELL;; esac; enc=1;; esac; if [ "$enc" = 1 ]; then o=""; while [ -n "$p" ]; do c="${p%"${p#?}"}"; if [ "$c" = "%" ]; then r="${p#?}"; hh="${r%"${r#??}"}"; case "$hh" in [0-9A-Fa-f][0-9A-Fa-f]) o="$o$(printf "\\$(printf %03o "0x$hh")")"; p="${r#??}";; *) o="$o%"; p="${p#?}";; esac; else o="$o$c"; p="${p#?}"; fi; done; p="$o"; fi; if [ -z "$p" ]; then echo "open-design-webui: no .desktop location was provided; run ./open-design.sh start from the extracted bundle directory" >&2; exec $SHELL; fi; d="$(dirname "$p")"; cd "$d" || { echo "open-design-webui: cannot enter bundle directory: $d" >&2; exec $SHELL; }; ./open-design.sh start; exec $SHELL'
Terminal=true
Categories=Development;
