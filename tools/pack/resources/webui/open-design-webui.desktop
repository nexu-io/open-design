[Desktop Entry]
Type=Application
Name=Open Design WebUI
Comment=Start Open Design WebUI in a terminal
Exec=sh -c 'p="%k"; case "$p" in file://*) p="${p#file://}";; esac; if [ -z "$p" ]; then echo "open-design-webui: no .desktop location was provided; run ./open-design.sh start from the extracted bundle directory" >&2; exec $SHELL; fi; d="$(dirname "$p")"; cd "$d" || { echo "open-design-webui: cannot enter bundle directory: $d" >&2; exec $SHELL; }; ./open-design.sh start; exec $SHELL'
Terminal=true
Categories=Development;
