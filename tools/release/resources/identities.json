{
  "schemaVersion": 1,
  "defaults": {
    "excludeDirectoryNames": [".next", ".od", ".tmp", "__tests__", "coverage", "dist", "node_modules", "out", "test", "tests"]
  },
  "sourceSets": {
    "shell.source.common": {
      "normalizePackageVersion": true,
      "paths": [
        "packages/release",
        "packages/contracts",
        "packages/sidecar",
        "packages/shell",
        "packages/platform",
        "packages/download",
        "packages/host",
        "packages/diagnostics",
        "packages/closure",
        "shells/electron",
        "apps/standalone/package.json",
        "apps/standalone/esbuild.config.ts",
        "apps/standalone/tsconfig.json",
        "apps/standalone/src/protocol",
        "apps/standalone/src/runtime",
        "apps/standalone/src/bootloader.ts",
        "apps/standalone/src/bootstrap-entry.ts",
        "apps/standalone/src/bootstrap.ts",
        "apps/standalone/src/fossil-bootloader.ts",
        "apps/standalone/src/generation-bootloader.ts",
        "apps/standalone/src/launcher-bootstrap.ts",
        "apps/standalone/src/launcher.ts",
        "apps/standalone/src/native-loader.ts",
        "apps/standalone/src/process-bridge.ts",
        {
          "path": "tools/pack",
          "excludePaths": ["resources/mac", "resources/win", "src/closure", "src/mac", "src/win"]
        }
      ]
    },
    "shell.source.mac": {
      "inherits": ["shell.source.common"],
      "paths": ["tools/pack/resources/mac", "tools/pack/src/mac"]
    },
    "shell.source.win": {
      "inherits": ["shell.source.common"],
      "paths": ["tools/pack/resources/win", "tools/pack/src/win"]
    },
    "shell.capability": {
      "normalizePackageVersion": true,
      "normalizeTextLineEndings": true,
      "paths": [
        "apps/standalone/package.json",
        "apps/standalone/src/bootloader.ts",
        "apps/standalone/src/bootstrap-entry.ts",
        "apps/standalone/src/launcher-bootstrap.ts",
        "apps/standalone/src/process-bridge.ts",
        "apps/standalone/src/protocol",
        "shells/electron/src/desktop-capability-adapter.ts",
        "shells/electron/src/shell-capabilities.ts",
        "shells/electron/src/standalone-bootstrap.ts",
        "shells/electron/src/standalone-commands.ts",
        "shells/electron/src/standalone-handoff.ts",
        "shells/electron/src/standalone-launcher-entry.ts",
        "shells/electron/src/standalone-launcher.ts",
        "tools/pack/src/closure/components.ts",
        "tools/pack/src/closure/distribution.ts",
        "tools/pack/src/shell-build-plan.ts",
        "tools/pack/src/standalone-seed.ts"
      ]
    },
    "shell.carrier.common": {
      "normalizeTextLineEndings": true,
      "paths": [
        ".node-version",
        "apps/standalone/src/bootstrap-entry.ts",
        "apps/standalone/src/fossil-bootloader.ts",
        "apps/standalone/src/generation-bootloader.ts",
        "apps/standalone/src/launcher.ts",
        "apps/standalone/src/native-loader.ts",
        "packages/closure/src/store",
        "packages/closure/src/update",
        "packages/shell/src/update",
        "tools/pack/src/closure/components.ts",
        "tools/pack/src/closure/platform.ts"
      ]
    },
    "shell.carrier.mac": {
      "inherits": ["shell.carrier.common"],
      "paths": ["tools/pack/src/mac/payload.ts", "tools/pack/src/mac/paths.ts"]
    },
    "shell.carrier.win": {
      "inherits": ["shell.carrier.common"],
      "paths": ["tools/pack/src/win/payload.ts", "tools/pack/src/win/paths.ts"]
    },
    "shell.dependencies": {
      "normalizePackageVersion": true,
      "paths": [".node-version", "apps/daemon/package.json", "package.json", "pnpm-lock.yaml"]
    },
    "shell.spec.shared": {
      "paths": [
        "e2e/lib/desktop",
        "e2e/lib/vitest",
        "e2e/scripts/release-smoke.ts",
        "tools/release/src/storage/shell-build.ts",
        "tools/serve/src/index.ts",
        "tools/serve/src/updater-fixture.ts"
      ]
    },
    "shell.spec.mac": {
      "inherits": ["shell.spec.shared"],
      "paths": [
        ".github/actions/release/platform/mac/exact/action.yml",
        "e2e/specs/mac.spec.ts",
        "e2e/specs/mac"
      ]
    },
    "shell.spec.win": {
      "inherits": ["shell.spec.shared"],
      "paths": [
        ".github/actions/release/platform/win/exact/action.yml",
        "e2e/specs/win.spec.ts",
        "e2e/specs/win",
        "tools/pack/resources/win/nsis",
        "tools/pack/src/win/custom-installer.ts",
        "tools/pack/tests/fixtures/win/nsis"
      ]
    },
    "closure.build.shared": {
      "paths": [
        "apps/daemon",
        "apps/standalone",
        "apps/web",
        "packages/agui-adapter",
        "packages/closure",
        "packages/components",
        "packages/contracts",
        "packages/diagnostics",
        "packages/download",
        "packages/host",
        "packages/platform",
        "packages/plugin-runtime",
        "packages/registry-protocol",
        "packages/release",
        "packages/sidecar",
        "tools/pack/package.json",
        {
          "path": "tools/pack/src",
          "excludePaths": [
            "mac",
            "win"
          ]
        },
        "assets/community-pets",
        "assets/frames",
        "craft",
        "data/plugin-previews",
        "design-systems",
        "design-templates",
        "plugins/_official",
        "plugins/registry",
        "prompt-templates",
        "skills",
        "package.json",
        "pnpm-lock.yaml"
      ]
    },
    "closure.build.target": {
      "paths": [
        ".node-version",
        "apps/daemon/package.json",
        "packages/closure",
        "packages/platform",
        "packages/release",
        "tools/pack/package.json",
        {
          "path": "tools/pack/src",
          "excludePaths": [
            "mac",
            "win"
          ]
        },
        "package.json",
        "pnpm-lock.yaml"
      ]
    }
  },
  "identities": {
    "shell.source.mac": {
      "schemaVersion": 1,
      "sourceSets": ["shell.source.mac"],
      "parameters": ["buildCommand", "shell"]
    },
    "shell.source.win": {
      "schemaVersion": 1,
      "sourceSets": ["shell.source.win"],
      "parameters": ["buildCommand", "shell"]
    },
    "shell.capability": {
      "schemaVersion": 1,
      "sourceSets": ["shell.capability"],
      "parameters": []
    },
    "shell.carrier.mac": {
      "schemaVersion": 1,
      "sourceSets": ["shell.carrier.mac"],
      "parameters": ["platform"]
    },
    "shell.carrier.win": {
      "schemaVersion": 1,
      "sourceSets": ["shell.carrier.win"],
      "parameters": ["platform"]
    },
    "shell.dependencies": {
      "schemaVersion": 1,
      "sourceSets": ["shell.dependencies"],
      "parameters": ["nativeDependencies", "nodeModulesAbi", "nodeNapi", "nodeVersion", "packageManager"]
    },
    "shell.spec.mac_arm64": {
      "schemaVersion": 1,
      "sourceSets": ["shell.spec.mac"],
      "parameters": ["matrix", "standaloneProtocolVersion"]
    },
    "shell.spec.mac_x64": {
      "schemaVersion": 1,
      "sourceSets": ["shell.spec.mac"],
      "parameters": ["matrix", "standaloneProtocolVersion"]
    },
    "shell.spec.win_x64": {
      "schemaVersion": 1,
      "sourceSets": ["shell.spec.win"],
      "parameters": ["matrix", "standaloneProtocolVersion"]
    },
    "closure.shared.build": {
      "schemaVersion": 1,
      "sourceSets": ["closure.build.shared"],
      "parameters": ["minShellVersion", "nodeVersion", "packageManager"]
    },
    "closure.target.darwin-arm64": {
      "schemaVersion": 1,
      "sourceSets": ["closure.build.target"],
      "parameters": ["nodeModulesAbi", "nodeNapi", "nodeVersion", "packageManager", "target"]
    },
    "closure.target.darwin-x64": {
      "schemaVersion": 1,
      "sourceSets": ["closure.build.target"],
      "parameters": ["nodeModulesAbi", "nodeNapi", "nodeVersion", "packageManager", "target"]
    },
    "closure.target.win32-x64": {
      "schemaVersion": 1,
      "sourceSets": ["closure.build.target"],
      "parameters": ["nodeModulesAbi", "nodeNapi", "nodeVersion", "packageManager", "target"]
    }
  }
}
