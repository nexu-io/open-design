{
  "schemaVersion": 1,
  "defaults": {
    "excludeDirectoryNames": [".next", ".tmp", "coverage", "dist", "node_modules", "out"]
  },
  "sourceSets": {
    "closure.data.build-control": {
      "paths": [
        ".node-version", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml",
        "apps/closure/package.json", "apps/closure/esbuild.config.ts",
        "apps/closure/src/build/data-resources.ts", "apps/closure/src/data-resources.ts",
        "packages/standalone/package.json", "packages/standalone/esbuild.config.ts",
        "packages/standalone/src", "tools/release/src/exact/resource-build.ts"
      ]
    },
    "closure.data.skills.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"skills","excludeDirectoryNames":[]}]
    },
    "closure.data.design-templates.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"design-templates","excludeDirectoryNames":[]}]
    },
    "closure.data.design-systems.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"design-systems","excludeDirectoryNames":[]}]
    },
    "closure.data.craft.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"craft","excludeDirectoryNames":[]}]
    },
    "closure.data.plugins.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"plugins/_official","excludeDirectoryNames":[]}, {"path":"plugins/registry","excludeDirectoryNames":[]}]
    },
    "closure.data.frames.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"assets/frames","excludeDirectoryNames":[]}]
    },
    "closure.data.community-pets.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"assets/community-pets","excludeDirectoryNames":[]}]
    },
    "closure.data.prompt-templates.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"prompt-templates","excludeDirectoryNames":[]}]
    },
    "closure.data.plugin-previews.build": {
      "inherits": ["closure.data.build-control"],
      "paths": [{"path":"data/plugin-previews","excludeDirectoryNames":[]}]
    },
    "electron.contract.build": {
      "normalizePackageVersion": true,
      "paths": [
        "packages/electron-contract/package.json",
        "packages/electron-contract/esbuild.config.mjs",
        "packages/electron-contract/tsconfig.json",
        "packages/electron-contract/src"
      ]
    },
    "electron.contract.test": {
      "inherits": ["release.validation.control"],
      "paths": [
        "packages/electron-contract/tests",
        "packages/electron-contract/tsconfig.tests.json",
        "packages/electron-contract/vitest.config.ts"
      ]
    },
    "electron.shell.build": {
      "normalizePackageVersion": true,
      "paths": [
        ".node-version",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "packages/electron-kit/package.json",
        "packages/electron-kit/esbuild.config.mjs",
        {
          "path": "packages/electron-kit/src",
          "excludePaths": ["cdp", "cdp-api.ts"]
        },
        "packages/electron-kit/resources",
        "packages/electron-capsule/package.json",
        "packages/electron-capsule/tsconfig.json",
        "packages/electron-capsule/src",
        "packages/contracts/package.json",
        "packages/contracts/src",
        "packages/download/package.json",
        "packages/download/src",
        "packages/platform/package.json",
        "packages/platform/src",
        "packages/release/package.json",
        "packages/release/src",
        "packages/sidecar/package.json",
        "packages/sidecar/esbuild.config.mjs",
        "packages/sidecar/src",
        "packages/standalone/package.json",
        "packages/standalone/esbuild.config.ts",
        "packages/standalone/tsconfig.json",
        "packages/standalone/src",
        "shells/electron/package.json",
        "shells/electron/tsconfig.json",
        "shells/electron/tsconfig.build.json",
        "shells/electron/config",
        "shells/electron/resources",
        {
          "path": "shells/electron/src",
          "excludePaths": ["adapters/tools/lifecycle", "lifecycle-api.ts"]
        }
      ]
    },
    "shell.packages.test": {
      "paths": [
        "packages/standalone/tests/packages",
        "packages/standalone/tsconfig.tests.json",
        "packages/standalone/vitest.config.ts"
      ]
    },
    "electron.shell.test": {
      "inherits": ["electron.lifecycle.control", "shell.packages.test", "release.validation.control"],
      "paths": [
        "packages/electron-kit/tests",
        "packages/electron-kit/tsconfig.tests.json",
        "packages/electron-kit/vitest.config.ts",
        "packages/electron-capsule/tests",
        "packages/electron-capsule/tsconfig.tests.json",
        "packages/electron-capsule/vitest.config.ts",
        "shells/electron/tests",
        "shells/electron/tsconfig.tests.json",
        "shells/electron/vitest.config.ts"
      ]
    },
    "closure.build": {
      "inherits": ["closure.data"],
      "normalizePackageVersion": true,
      "paths": [
        ".node-version",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "apps/closure/package.json",
        "apps/closure/esbuild.config.ts",
        "apps/closure/scripts",
        "apps/closure/tsconfig.json",
        "apps/closure/tsconfig.scripts.json",
        "apps/closure/src",
        "apps/daemon/package.json",
        "apps/daemon/tsconfig.json",
        "apps/daemon/src",
        "apps/web/package.json",
        "apps/web/next.config.ts",
        "apps/web/public",
        "apps/web/tsconfig.json",
        "apps/web/tsconfig.sidecar.json",
        "apps/web/src",
        "apps/web/sidecar",
        "apps/web/app",
        "packages/agui-adapter/package.json",
        "packages/agui-adapter/src",
        "packages/components/package.json",
        "packages/components/src",
        "packages/contracts/package.json",
        "packages/contracts/src",
        "packages/diagnostics/package.json",
        "packages/diagnostics/src",
        "packages/platform/package.json",
        "packages/platform/src",
        "packages/plugin-runtime/package.json",
        "packages/plugin-runtime/src",
        "packages/registry-protocol/package.json",
        "packages/registry-protocol/src",
        "packages/release/package.json",
        "packages/release/src",
        "packages/sidecar/package.json",
        "packages/sidecar/esbuild.config.mjs",
        "packages/sidecar/src",
        "packages/sidecar-proto/package.json",
        "packages/sidecar-proto/src",
        "packages/standalone/package.json",
        {
          "path": "packages/standalone/src",
          "excludePaths": ["packages"]
        }
      ]
    },
    "closure.data": {
      "paths": [
        "skills", "design-templates", "design-systems", "craft",
        "plugins/_official", "plugins/registry", "assets/frames",
        "assets/community-pets", "prompt-templates", "data/plugin-previews"
      ]
    },
    "closure.test": {
      "inherits": ["release.validation.control"],
      "paths": [
        "apps/closure/tests",
        "apps/closure/tsconfig.tests.json",
        "apps/daemon/tests",
        "apps/daemon/tsconfig.tests.json",
        "apps/daemon/vitest.config.ts",
        "apps/web/tests",
        "apps/web/vitest.config.ts"
      ]
    },
    "electron.distribution": {
      "paths": [
        "tools/release/src/exact/capsule-budget.ts",
        "tools/release/src/exact/platform-product.ts",
        "shells/electron/config/platforms",
        "shells/electron/src/build-api.ts",
        "shells/electron/src/adapters/tools/distribution-tool.ts",
        "shells/electron/src/adapters/tools/exact-contract.ts",
        "shells/electron/src/adapters/tools/manifests.ts",
        "shells/electron/src/adapters/standalone/assemble-installation.ts"
      ]
    },
    "electron.acceptance.full": {
      "inherits": ["electron.cdp.control", "electron.lifecycle.control", "release.acceptance.control", "shell.packages.test"],
      "paths": [
        ".github/workflows/release-exact.yml",
        "e2e/tests/scripts/exact-release.test.ts",
        "shells/electron/tests/runtime-lifecycle.test.ts"
      ]
    },
    "closure.acceptance.hot": {
      "inherits": ["electron.cdp.control", "electron.lifecycle.control", "release.acceptance.control"],
      "paths": [
        "packages/standalone/src",
        "shells/electron/tests/standalone-authority.test.ts",
        "shells/electron/tests/standalone-host-lifecycle.test.ts",
        "shells/terminal/tests/bootloader-handoff.test.ts",
        "shells/terminal/tests/sidecar.test.ts"
      ]
    },
    "release.validation.control": {
      "paths": ["tools/release/src/exact/validation.ts"]
    },
    "release.acceptance.control": {
      "paths": [
        "tools/release/src/exact/installed-acceptance.ts",
        "tools/release/src/exact/acceptance.ts",
        "tools/release/src/exact/acceptance-artifact.ts",
        "tools/release/src/exact/commands.ts",
        "tools/release/src/exact/control-common.ts",
        "tools/release/src/exact/control-release.ts",
        "tools/release/src/policy/release-profile.ts",
        "tools/release/tests/installed-acceptance.test.ts",
        "tools/release/tests/acceptance-artifact.test.ts",
        "tools/release/tests/exact-commands.test.ts"
      ]
    },
    "electron.lifecycle.control": {
      "paths": [
        "shells/electron/src/lifecycle-api.ts",
        "shells/electron/src/adapters/tools/lifecycle"
      ]
    },
    "electron.cdp.control": {
      "paths": [
        "packages/electron-kit/src/cdp",
        "packages/electron-kit/src/cdp-api.ts"
      ]
    }
  },
  "identities": {
    "closure.data.skills.build": {"schemaVersion": 1, "sourceSets": ["closure.data.skills.build"], "parameters": ["target"]},
    "closure.data.design-templates.build": {"schemaVersion": 1, "sourceSets": ["closure.data.design-templates.build"], "parameters": ["target"]},
    "closure.data.design-systems.build": {"schemaVersion": 1, "sourceSets": ["closure.data.design-systems.build"], "parameters": ["target"]},
    "closure.data.craft.build": {"schemaVersion": 1, "sourceSets": ["closure.data.craft.build"], "parameters": ["target"]},
    "closure.data.plugins.build": {"schemaVersion": 1, "sourceSets": ["closure.data.plugins.build"], "parameters": ["target"]},
    "closure.data.frames.build": {"schemaVersion": 1, "sourceSets": ["closure.data.frames.build"], "parameters": ["target"]},
    "closure.data.community-pets.build": {"schemaVersion": 1, "sourceSets": ["closure.data.community-pets.build"], "parameters": ["target"]},
    "closure.data.prompt-templates.build": {"schemaVersion": 1, "sourceSets": ["closure.data.prompt-templates.build"], "parameters": ["target"]},
    "closure.data.plugin-previews.build": {"schemaVersion": 1, "sourceSets": ["closure.data.plugin-previews.build"], "parameters": ["target"]},
    "electron.contract.build": {"schemaVersion": 1, "sourceSets": ["electron.contract.build"], "parameters": ["target"]},
    "electron.contract.test": {"schemaVersion": 1, "sourceSets": ["electron.contract.test"], "parameters": ["target"]},
    "electron.shell.build": {"schemaVersion": 1, "sourceSets": ["electron.shell.build"], "parameters": ["target"]},
    "electron.shell.test": {"schemaVersion": 1, "sourceSets": ["electron.shell.test"], "parameters": ["target"]},
    "closure.build": {"schemaVersion": 1, "sourceSets": ["closure.build"], "parameters": ["target"]},
    "closure.test": {"schemaVersion": 1, "sourceSets": ["closure.test"], "parameters": ["target"]},
    "electron.distribution": {"schemaVersion": 1, "sourceSets": ["electron.distribution"], "parameters": ["target"]},
    "electron.acceptance.full": {"schemaVersion": 1, "sourceSets": ["electron.acceptance.full"], "parameters": ["target"]},
    "closure.acceptance.hot": {"schemaVersion": 1, "sourceSets": ["closure.acceptance.hot"], "parameters": ["target", "acceptedShellBaseline"]}
  }
}
