{
  "name": "@open-design/tools-serve",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "exports": {
    "./standalone-exact-client": {
      "types": "./dist/standalone-exact-client.d.ts",
      "default": "./dist/standalone-exact-client.mjs"
    }
  },
  "bin": {
    "tools-serve": "./bin/tools-serve.mjs"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && metatool write .",
    "dev": "tsx ./src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@open-design/metatool": "workspace:*",
    "@open-design/download": "workspace:*",
    "@open-design/release": "workspace:*",
    "@open-design/shell-electron": "workspace:*",
    "@open-design/standalone": "workspace:*",
    "cac": "6.7.14"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
