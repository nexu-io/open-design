+// Bundlers (webpack, Turbopack) redirect the browser bundle here so the
+// real node.mjs (which imports node:fs, node:child_process, etc.) is never
+// traced into the browser build. The real Node.js implementation at
+// tools/agent-toolset/node.mjs is untouched; the daemon loads it at runtime.
+
+function notBrowser() {
