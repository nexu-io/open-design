{
  "schemaVersion": "od-design-system-component/v1",
  "id": "Field",
  "name": "Field",
  "description": "Google labeled text field.",
  "selectors": [
    ".ds-google-field"
  ],
  "properties": {
    "label": {
      "type": "string",
      "required": true
    },
    "value": {
      "type": "string"
    },
    "placeholder": {
      "type": "string"
    }
  },
  "states": {
    "focus": {
      "selectors": [
        ".ds-google-field:focus-within"
      ],
      "required": true
    }
  },
  "implementation": "<label class=\"ds-google-field\"><span>{{label}}</span><input value=\"{{value}}\" placeholder=\"{{placeholder}}\" /></label>"
}
