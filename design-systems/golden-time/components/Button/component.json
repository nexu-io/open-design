{
  "schemaVersion": "od-design-system-component/v1",
  "id": "Button",
  "name": "Button",
  "description": "Golden Time primary and secondary action control.",
  "selectors": [
    ".ds-golden-time-button"
  ],
  "variants": {
    "primary": {
      "selectors": [
        ".ds-golden-time-button--primary"
      ]
    },
    "secondary": {
      "selectors": [
        ".ds-golden-time-button--secondary"
      ]
    }
  },
  "properties": {
    "label": {
      "type": "string",
      "required": true
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "states": {
    "hoverPrimary": {
      "selectors": [
        ".ds-golden-time-button--primary:hover"
      ]
    },
    "hoverSecondary": {
      "selectors": [
        ".ds-golden-time-button--secondary:hover"
      ]
    },
    "focus": {
      "selectors": [
        ".ds-golden-time-button:focus-visible"
      ],
      "required": true
    }
  },
  "implementation": "<button class=\"ds-golden-time-button ds-golden-time-button--primary\" type=\"button\">{{label}}</button>"
}
