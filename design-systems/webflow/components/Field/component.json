{
  "schemaVersion": "od-design-system-component/v1",
  "id": "Field",
  "name": "Field",
  "description": "Labeled Webflow form field with helper text.",
  "selectors": [".field"],
  "properties": {
    "label": { "type": "string", "required": true },
    "placeholder": { "type": "string" },
    "help": { "type": "string" }
  },
  "states": {
    "placeholder": { "selectors": [".field input::placeholder"] },
    "focus": { "selectors": [".field input:focus-visible"], "required": true },
    "hover": { "selectors": [".field input:hover"] }
  },
  "implementation": "<div class=\"field\"><label for=\"field-id\">{{label}}</label><input id=\"field-id\" placeholder=\"{{placeholder}}\" /><p class=\"field-help\">{{help}}</p></div>",
  "source": "components.html"
}
