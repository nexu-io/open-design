{
  "schemaVersion": "od-design-system-component/v1",
  "id": "Field",
  "name": "Field",
  "description": "Minimal labeled text field.",
  "selectors": [
    ".field"
  ],
  "properties": {
    "label": {
      "type": "string",
      "required": true
    },
    "value": {
      "type": "string"
    },
    "placeholder": {
      "type": "string"
    }
  },
  "states": {
    "focus": {
      "selectors": [
        "input:focus"
      ],
      "required": true
    }
  },
  "implementation": "<label class=\"field\"><span>{{label}}</span><input value=\"{{value}}\" placeholder=\"{{placeholder}}\" /></label>",
  "source": "components.html"
}
