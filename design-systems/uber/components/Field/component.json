{
  "schemaVersion": "od-design-system-component/v1",
  "id": "Field",
  "name": "Field",
  "description": "Compact Uber location-style input.",
  "selectors": [".field"],
  "properties": {
    "label": { "type": "string", "required": true },
    "placeholder": { "type": "string" }
  },
  "states": {
    "placeholder": { "selectors": [".field input::placeholder"] },
    "focus": { "selectors": [".field input:focus"], "required": true }
  },
  "implementation": "<div class=\"field\"><label for=\"field-id\">{{label}}</label><input id=\"field-id\" type=\"text\" placeholder=\"{{placeholder}}\" /></div>",
  "source": "components.html"
}
