{
  "schemaVersion": "od-design-system-component/v1",
  "id": "Surface",
  "name": "Surface",
  "description": "White Uber card with whisper-soft elevation.",
  "selectors": [".card"],
  "variants": {
    "featured": { "selectors": [".card-featured"] }
  },
  "properties": {
    "title": { "type": "string", "required": true },
    "description": { "type": "string" }
  },
  "implementation": "<article class=\"card\"><h3>{{title}}</h3><p class=\"body-muted body-sm\">{{description}}</p></article>",
  "source": "components.html"
}
