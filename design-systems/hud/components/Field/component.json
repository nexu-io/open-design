{
  "schemaVersion": "od-design-system-component/v1",
  "id": "Field",
  "name": "Field",
  "description": "Compact labeled HUD input.",
  "selectors": [".field"],
  "properties": {
    "label": { "type": "string", "required": true },
    "value": { "type": "string" },
    "placeholder": { "type": "string" }
  },
  "states": {
    "focus": { "selectors": ["input:focus"], "required": true }
  },
  "implementation": "<div class=\"field\"><label for=\"field-id\">{{label}}</label><input id=\"field-id\" value=\"{{value}}\" placeholder=\"{{placeholder}}\" /></div>",
  "source": "components.html"
}
