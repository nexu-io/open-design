  "referenceHtml": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Decision Memo — One-page Preview</title>\n  <style>\n    :root {\n      --paper: #fbfaf6;\n      --paper-soft: #f3f5f1;\n      --paper-blue: #edf4ef;\n      --ink: #17251d;\n      --ink-soft: #43554a;\n      --muted: #6c796f;\n      --line: #d5ddd7;\n      --line-strong: #b9cabf;\n      --blue: #256348;\n      --yellow: #e8b83f;\n      --yellow-ink: #3d3209;\n    }\n\n    * { box-sizing: border-box; }\n    html, body { margin: 0; min-height: 100%; }\n\n    body {\n      padding: 48px 22px;\n      color: var(--ink);\n      background: #e9ebe6;\n      font-family: \"Albert Sans\", Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      font-size: 13px;\n      line-height: 1.5;\n      -webkit-font-smoothing: antialiased;\n      font-variant-numeric: tabular-nums;\n    }\n\n    .report { width: min(100%, 940px); margin: 0 auto; }\n\n    .page {\n      position: relative;\n      width: 100%;\n      aspect-ratio: 210 / 297;\n      overflow: hidden;\n      background: var(--paper);\n      border: 1px solid rgba(37, 99, 72, .10);\n      box-shadow: 0 34px 80px -42px rgba(23, 37, 29, .32);\n    }\n\n    .page::before {\n      position: absolute;\n      top: 0;\n      right: 0;\n      left: 0;\n      height: 7px;\n      background: var(--blue);\n      content: \"\";\n    }\n\n    .page::after {\n      position: absolute;\n      inset: 0;\n      z-index: 8;\n      pointer-events: none;\n      opacity: .018;\n      content: \"\";\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 140 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.74' numOctaves='3' stitchTiles='stitchTiles'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.42'/%3E%3C/svg%3E\");\n      mix-blend-mode: multiply;\n    }\n\n    .inner {\n      position: relative;\n      z-index: 1;\n      display: flex;\n      min-height: 100%;\n      flex-direction: column;\n      padding: 29px 54px 42px;\n    }\n\n    .masthead {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n      padding-bottom: 13px;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .brand-lockup {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 12px;\n      font-weight: 760;\n    }\n\n    .brand-lockup svg { width: 24px; height: 24px; flex: 0 0 24px; }\n\n    .document-meta {\n      display: flex;\n      align-items: center;\n      gap: 20px;\n      color: var(--muted);\n      font-size: 9.5px;\n      font-weight: 690;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n\n    .title-block {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr) 190px;\n      gap: 38px;\n      align-items: start;\n      padding: 20px 0 10px;\n    }\n\n    h1 {\n      max-width: 640px;\n      margin: 0;\n      font-size: 39px;\n      line-height: 1.02;\n      letter-spacing: -.045em;\n    }\n\n    .title-deck {\n      max-width: 650px;\n      margin: 9px 0 0;\n      color: var(--ink-soft);\n      font-size: 14px;\n      line-height: 1.45;\n    }\n\n    .title-facts {\n      display: grid;\n      gap: 13px;\n      align-self: start;\n      padding-left: 18px;\n      border-left: 1px solid var(--line);\n    }\n\n    .title-fact { display: flex; flex-direction: column; justify-content: flex-end; }\n    .title-fact + .title-fact { padding-top: 0; border-top: 0; }\n\n    .fact-label, .section-label {\n      color: var(--blue);\n      font-size: 9.5px;\n      font-weight: 800;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n\n    .fact-value {\n      margin-top: 2px;\n      color: var(--ink-soft);\n      font-size: 12px;\n      font-weight: 600;\n      line-height: 1.25;\n    }\n\n    .recommendation {\n      position: relative;\n      display: grid;\n      grid-template-columns: minmax(0, 1fr);\n      align-items: start;\n      margin-top: 10px;\n      padding: 14px 22px;\n      overflow: hidden;\n      color: #fff;\n      background: var(--ink);\n      border-radius: 10px;\n    }\n\n    .recommendation::after {\n      position: absolute;\n      right: -18px;\n      bottom: -18px;\n      width: 280px;\n      height: 120px;\n      content: \"\";\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 280 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='white' stroke-opacity='.11' stroke-width='2'%3E%3Cpath d='M28 120L138 10'/%3E%3Cpath d='M70 120L180 10'/%3E%3Cpath d='M112 120L222 10'/%3E%3Cpath d='M154 120L264 10'/%3E%3Cpath d='M196 120L280 36'/%3E%3C/g%3E%3C/svg%3E\");\n      background-repeat: no-repeat;\n      background-size: 100% 100%;\n      pointer-events: none;\n    }\n\n    .recommendation-label {\n      position: absolute;\n      top: 14px;\n      right: 22px;\n      z-index: 1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .recommendation .section-label { color: rgba(255, 255, 255, .72); }\n\n    .recommendation-copy { position: relative; z-index: 1; padding: 0 190px 0 0; }\n    .recommendation-copy .section-label { display: block; margin-bottom: 6px; }\n    .recommendation-copy h2 { margin: 0; color: #fff; font-size: 22px; line-height: 1.18; letter-spacing: -.03em; }\n\n    .recommendation-copy p {\n      margin: 5px 0 0;\n      color: rgba(255, 255, 255, .8);\n      font-size: 12.5px;\n      line-height: 1.48;\n    }\n\n    .status-pill {\n      display: inline-flex;\n      padding: 5px 9px;\n      color: var(--yellow-ink);\n      background: var(--yellow);\n      border-radius: 999px;\n      font-size: 9.5px;\n      font-weight: 840;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n      white-space: nowrap;\n    }\n    .section { margin-top: 24px; }\n\n    .section-head {\n      display: flex;\n      align-items: baseline;\n      justify-content: space-between;\n      gap: 20px;\n      margin-bottom: 10px;\n    }\n\n    .section-head h2 { margin: 0; font-size: 17px; line-height: 1.2; letter-spacing: -.025em; }\n    .section-head p { margin: 0; color: var(--muted); font-size: 11.5px; letter-spacing: .02em; }\n\n    .evidence-list {\n      overflow: hidden;\n      border: 1px solid var(--line);\n      border-radius: 10px;\n    }\n\n    .evidence-item {\n      display: grid;\n      grid-template-columns: 92px 100px minmax(0, 1fr);\n      gap: 14px;\n      min-height: 58px;\n      align-items: center;\n      padding: 9px 16px;\n    }\n\n    .evidence-item + .evidence-item { border-top: 1px solid var(--line); }\n    .evidence-index { color: var(--blue); font-size: 9.5px; font-weight: 820; letter-spacing: .12em; text-transform: uppercase; }\n    .evidence-value { color: var(--blue); font-size: 24px; font-weight: 780; line-height: 1; letter-spacing: -.035em; }\n    .evidence-copy { min-width: 0; }\n    .evidence-copy strong { display: block; font-size: 12.5px; line-height: 1.3; }\n    .evidence-copy p { margin: 3px 0 0; color: var(--ink-soft); font-size: 11.5px; line-height: 1.42; }\n\n    .option-table {\n      width: 100%;\n      overflow: hidden;\n      border: 1px solid var(--line);\n      border-spacing: 0;\n      border-radius: 10px;\n      border-collapse: separate;\n    }\n\n    .option-table th {\n      padding: 7px 13px;\n      color: var(--muted);\n      background: var(--paper-soft);\n      font-size: 10.5px;\n      font-weight: 800;\n      letter-spacing: .12em;\n      text-align: left;\n      text-transform: uppercase;\n      white-space: nowrap;\n    }\n\n    .option-table td {\n      padding: 8px 13px;\n      color: var(--ink-soft);\n      border-top: 1px solid var(--line);\n      font-size: 12.5px;\n      line-height: 1.3;\n      text-align: left;\n      vertical-align: middle;\n    }\n\n    .option-table tr.recommended td { background: var(--paper-blue); }\n    .option-name { color: var(--ink); white-space: normal; }\n    .option-name strong { display: block; color: var(--ink); font-weight: 740; }\n    .option-note { display: block; margin-top: 3px; color: var(--muted); font-size: 10.5px; font-weight: 500; line-height: 1.35; }\n\n    .rating {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      color: var(--ink-soft);\n      font-size: 11.5px;\n      font-weight: 650;\n      white-space: nowrap;\n    }\n\n    .rating::before {\n      width: 6px;\n      height: 6px;\n      content: \"\";\n      background: var(--line-strong);\n      border-radius: 50%;\n    }\n\n    .rating--high::before { background: #d9912f; }\n    .rating--medium::before { background: var(--yellow); }\n    .rating--low::before { background: #aac5b4; }\n\n    .disposition {\n      color: var(--blue);\n      font-size: 10.5px;\n      font-weight: 820;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      white-space: nowrap;\n    }\n\n    .disposition--muted { color: var(--muted); }\n\n    .recommended .disposition {\n      display: inline-flex;\n      align-items: center;\n      padding: 5px 9px;\n      color: #fff;\n      background: var(--blue);\n      border-radius: 999px;\n      font-size: 9.5px;\n      line-height: 1;\n    }\n\n    .decision-details {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 13px;\n      margin-top: 22px;\n      padding-top: 0;\n    }\n\n    .detail-block {\n      padding: 15px 18px;\n      color: var(--ink);\n      background: var(--paper-blue);\n      border: 0;\n      border-radius: 10px;\n    }\n\n    .detail-block h2 { margin: 0 0 9px; color: var(--ink); font-size: 16px; letter-spacing: -.02em; }\n    .detail-list { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; }\n\n    .detail-list li {\n      display: grid;\n      grid-template-columns: 18px 1fr;\n      gap: 9px;\n      color: var(--ink-soft);\n      font-size: 12.5px;\n      line-height: 1.42;\n    }\n\n    .detail-list b {\n      display: grid;\n      width: 18px;\n      height: 18px;\n      place-items: center;\n      color: var(--yellow);\n      background: var(--ink);\n      border: 0;\n      border-radius: 50%;\n      font-size: 8.5px;\n    }\n\n    .detail-list strong { color: var(--ink); }\n\n    .action-band {\n      position: relative;\n      margin-top: 20px;\n      padding: 22px 126px 22px 22px;\n      overflow: hidden;\n      color: #fff;\n      background: var(--ink);\n      border: 1px solid var(--ink);\n      border-radius: 10px;\n    }\n\n    .action-band::after {\n      position: absolute;\n      top: 50%;\n      right: 22px;\n      width: 78px;\n      height: 58px;\n      content: \"\";\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 78 58' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='0'%3E%3Cstop offset='0' stop-color='white' stop-opacity='0'/%3E%3Cstop offset='.38' stop-color='white' stop-opacity='.06'/%3E%3Cstop offset='1' stop-color='white' stop-opacity='.18'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath d='M7 19H41V8C41 5.7 43.7 4.5 45.4 6L73.2 27C74.8 28.2 74.8 29.8 73.2 31L45.4 52C43.7 53.5 41 52.3 41 50V39H7C5.3 39 4 37.7 4 36V22C4 20.3 5.3 19 7 19Z' fill='url(%23g)'/%3E%3C/svg%3E\");\n      background-repeat: no-repeat;\n      background-size: contain;\n      transform: translateY(-50%);\n    }\n\n    .action-band .section-label { color: rgba(255, 255, 255, .72); }\n\n    .action-copy {\n      position: relative;\n      z-index: 1;\n    }\n\n    .action-copy .section-label { display: block; margin-bottom: 6px; }\n    .action-copy strong { display: block; color: #fff; font-size: 14px; line-height: 1.25; }\n    .action-detail { display: block; margin-top: 4px; color: rgba(255, 255, 255, .76); font-size: 10.5px; }\n    .action-owner { display: flex; gap: 8px; align-items: baseline; margin-top: 10px; color: rgba(255, 255, 255, .62); font-size: 10.5px; line-height: 1.35; }\n    .action-owner b { color: var(--yellow); font-size: 11.5px; }\n\n    @media (max-width: 720px) {\n      body { padding: 0; }\n      .report { width: 100%; }\n      .page { aspect-ratio: auto; overflow: visible; border: 0; box-shadow: none; }\n      .inner { min-height: auto; padding: 28px 22px 34px; }\n      .document-meta { display: none; }\n      .title-block, .recommendation, .decision-details { grid-template-columns: 1fr; }\n      .title-facts { padding: 16px 0 0; border-top: 1px solid var(--line); border-left: 0; }\n      h1 { font-size: 33px; }\n      .recommendation-copy { padding: 0; }\n      .recommendation-label { position: static; justify-content: flex-start; padding-top: 14px; }\n      .evidence-item { grid-template-columns: 78px 82px minmax(0, 1fr); }\n      .option-table { display: block; overflow-x: auto; }\n      .action-band { padding-right: 96px; }\n    }\n\n    @media print {\n      @page { size: A4; margin: 0; }\n      html, body { background: #fff; }\n      body { padding: 0; }\n      .report { width: 940px; margin: 0; zoom: .84436254; }\n      .page { width: 940px; height: 1329.4286px; aspect-ratio: auto; border: 0; box-shadow: none; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"report\">\n    <article class=\"page\" aria-label=\"Decision memo, one A4 page\">\n      <div class=\"inner\">\n        <header class=\"masthead\">\n          <div class=\"brand-lockup\">\n            <svg viewBox=\"19 18.7266 82 82\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M101 59.7266C101 95.3019 95.5753 100.727 60 100.727C24.4247 100.727 19 95.3019 19 59.7266C19 24.1512 24.4247 18.7266 60 18.7266C95.5753 18.7266 101 24.1512 101 59.7266Z\" fill=\"#202020\"/>\n              <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M59.8885 34.4258C73.8627 34.4258 85.191 45.7541 85.191 59.7283C85.191 73.7025 73.8627 85.0309 59.8885 85.0309H37.9523C36.0891 85.0309 34.5861 83.528 34.586 81.6648C34.586 76.0216 34.5859 64.7754 34.5859 59.7283C34.5859 45.7541 45.9143 34.4258 59.8885 34.4258ZM59.8886 39.4864C48.7092 39.4864 39.6465 48.5491 39.6465 59.7284C39.6465 70.9078 48.7092 79.9704 59.8886 79.9704C71.0679 79.9704 80.1305 70.9078 80.1306 59.7284C80.1306 48.5491 71.0679 39.4864 59.8886 39.4864Z\" fill=\"white\"/>\n              <path d=\"M58.3164 71.6047L50.602 51.3039C50.3524 50.6469 50.994 50.0028 51.6467 50.2553L71.957 58.113C72.7928 58.4364 72.5625 59.6841 71.667 59.6841H59.8788V71.3146C59.8788 72.2163 58.6364 72.447 58.3164 71.6047Z\" fill=\"white\"/>\n            </svg>\n            <span>Open Design</span>\n          </div>\n          <div class=\"document-meta\"><span>Decision memo / 01</span><span>27 Aug 2026</span></div>\n        </header>\n\n        <section class=\"title-block\">\n          <div>\n            <h1>Which document workflow should we build next?</h1>\n            <p class=\"title-deck\">Use 60 days of observed reach, run volume, and repeat intensity to choose the next reusable document-template investment.</p>\n          </div>\n          <aside class=\"title-facts\" aria-label=\"Decision metadata\">\n            <div class=\"title-fact\"><span class=\"fact-label\">Owner</span><span class=\"fact-value\">Product &amp; template systems</span></div>\n            <div class=\"title-fact\"><span class=\"fact-label\">Evidence scope</span><span class=\"fact-value\">60 days · 191 runs</span></div>\n          </aside>\n        </section>\n\n        <section class=\"recommendation\" aria-label=\"Recommendation\">\n          <div class=\"recommendation-copy\">\n            <h2>Approve a guided data-report workflow.</h2>\n            <p>Use PDF as the discovery surface, deepen DOCX as the repeat workflow, and connect both through directly annotated evidence.</p>\n          </div>\n          <div class=\"recommendation-label\"><span class=\"status-pill\">Approval needed</span></div>\n        </section>\n\n        <section class=\"section\" aria-labelledby=\"evidence-heading\">\n          <div class=\"section-head\"><h2 id=\"evidence-heading\">Why this decision</h2></div>\n          <div class=\"evidence-list\">\n            <article class=\"evidence-item\"><span class=\"evidence-index\">Volume</span><span class=\"evidence-value\">72%</span><div class=\"evidence-copy\"><strong>Editable work leads volume.</strong><p>DOCX variants account for most observed runs.</p></div></article>\n            <article class=\"evidence-item\"><span class=\"evidence-index\">Repetition</span><span class=\"evidence-value\">13.5×</span><div class=\"evidence-copy\"><strong>Professional DOCX repeats.</strong><p>The strongest observed runs-per-user intensity.</p></div></article>\n            <article class=\"evidence-item\"><span class=\"evidence-index\">Reach</span><span class=\"evidence-value\">8</span><div class=\"evidence-copy\"><strong>PDF reaches widest.</strong><p>The broadest distinct-user coverage in the sample.</p></div></article>\n          </div>\n        </section>\n\n        <section class=\"section\" aria-labelledby=\"options-heading\">\n          <div class=\"section-head\"><h2 id=\"options-heading\">Options considered</h2><p>Choose for decision value, reuse, and differentiation</p></div>\n          <table class=\"option-table\">\n            <colgroup><col style=\"width:42%\"><col style=\"width:14%\"><col style=\"width:14%\"><col style=\"width:15%\"><col style=\"width:15%\"></colgroup>\n            <thead><tr><th>Option</th><th>Decision value</th><th>Reuse fit</th><th>Differentiation</th><th>Outcome</th></tr></thead>\n            <tbody>\n              <tr class=\"recommended\"><td class=\"option-name\"><strong>Guided data-report workflow</strong><span class=\"option-note\">Connects evidence, decision, and export.</span></td><td><span class=\"rating rating--high\">High</span></td><td><span class=\"rating rating--high\">High</span></td><td><span class=\"rating rating--high\">High</span></td><td><span class=\"disposition\">Recommend</span></td></tr>\n              <tr><td class=\"option-name\"><strong>Magazine-style report</strong><span class=\"option-note\">Expressive, but overlaps existing templates.</span></td><td><span class=\"rating rating--medium\">Medium</span></td><td><span class=\"rating rating--low\">Low</span></td><td><span class=\"rating rating--low\">Low</span></td><td><span class=\"disposition disposition--muted\">Hold</span></td></tr>\n              <tr><td class=\"option-name\"><strong>General DOCX improvements</strong><span class=\"option-note\">Supports retention without a distinct workflow.</span></td><td><span class=\"rating rating--medium\">Medium</span></td><td><span class=\"rating rating--high\">High</span></td><td><span class=\"rating rating--low\">Low</span></td><td><span class=\"disposition disposition--muted\">Maintain</span></td></tr>\n            </tbody>\n          </table>\n        </section>\n\n        <section class=\"decision-details\" aria-label=\"Trade-offs and decision controls\">\n          <div class=\"detail-block\">\n            <h2>What we accept</h2>\n            <ul class=\"detail-list\">\n              <li><b>1</b><span><strong>More structure.</strong> A guided flow adds discipline, so sections must remain modular for short reports.</span></li>\n              <li><b>2</b><span><strong>Aggregate evidence.</strong> User totals cannot be summed across capabilities because overlap is unknown.</span></li>\n            </ul>\n          </div>\n          <div class=\"detail-block\">\n            <h2>How we reduce risk</h2>\n            <ul class=\"detail-list\">\n              <li><b>1</b><span><strong>One baseline.</strong> Validate adoption and repeat use against the same 60-day definitions.</span></li>\n              <li><b>2</b><span><strong>Two output checks.</strong> Verify editable hierarchy and the fixed A4 review view together.</span></li>\n            </ul>\n          </div>\n        </section>\n\n        <section class=\"action-band\" aria-label=\"Next action\">\n          <div class=\"action-copy\">\n            <span class=\"section-label\">Next action</span>\n            <strong>Start with one bounded use case and an explicit owner.</strong>\n            <span class=\"action-detail\">Record the decision, prepare the first source dataset, and review adoption after the next 60-day window.</span>\n            <div class=\"action-owner\"><span>Owner</span><b>Product &amp; template systems</b></div>\n          </div>\n        </section>\n\n      </div>\n    </article>\n  </main>\n</body>\n</html>\n"
}
