# Braze REST 자격 샘플 — upload_media.py가 읽는다
#
# 사용법:
#   mkdir -p ~/.config/marketing-ax
#   cp braze.env.example ~/.config/marketing-ax/braze.env
#   → 아래 두 값을 채운다. 프로세스 env로 직접 export해도 된다 (env가 파일보다 우선).
#
# 이 파일(레포 안 샘플)에는 절대 실제 키를 채우지 않는다 — 실제 값은
# ~/.config/marketing-ax/braze.env 에만 둔다.

# 대시보드 Settings → APIs and Identifiers 에서 발급.
# 필요 권한: media_library.create (URL 확인까지 하려면 media_library.read 권장)
BRAZE_REST_API_KEY=

# 워크스페이스 인스턴스의 REST endpoint (대시보드 URL과 다름 — dashboard-XX → rest.iad-XX 매핑).
# 예: https://rest.iad-01.braze.com / https://rest.eu-01.braze.eu
BRAZE_REST_ENDPOINT=
