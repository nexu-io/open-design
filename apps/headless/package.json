{
  "name": "@open-design/headless",
  "version": "0.16.2",
  "private": true,
  "type": "module",
  "description": "Shell-neutral Open Design Web and daemon product lifecycle.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "pnpm --filter @open-design/headless-runtime build && tsx ./esbuild.config.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "pnpm --filter @open-design/headless-runtime build && vitest run",
    "typecheck": "pnpm --filter @open-design/headless-runtime build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@open-design/headless-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
