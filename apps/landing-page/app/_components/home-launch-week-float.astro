---
import { getLaunchWeekHomeFloatCopy } from '../_partials/launch-week-i18n';
import { localePath, type LandingLocaleCode } from '../i18n';

interface Props {
  locale: LandingLocaleCode;
}

const { locale } = Astro.props;
const copy = getLaunchWeekHomeFloatCopy(locale);
const eventHref = localePath(locale, '/community/events/launch-week/');
const eventStartAt = '2026-08-09T16:00:00Z';
const eventEndAtExclusive = '2026-08-14T16:00:00Z';
---

<aside
  class="home-launch-week-float"
  role="region"
  aria-label={copy.regionLabel}
  data-home-launch-week-float
  data-locale={locale}
  data-event-start-at={eventStartAt}
  data-event-end-at={eventEndAtExclusive}
  hidden
>
  <a
    class="home-launch-week-float__link"
    href={eventHref}
    aria-label={`${copy.title}. ${copy.cta}`}
    data-home-launch-week-link
  >
    <span class="home-launch-week-float__visual" aria-hidden="true">
      <img
        src="/launch-week/launch-week-home-float.webp"
        alt=""
        width="480"
        height="252"
        loading="eager"
        fetchpriority="low"
        decoding="async"
      />
    </span>
    <span class="home-launch-week-float__content">
      <span class="home-launch-week-float__date">{copy.date}</span>
      <strong class="home-launch-week-float__title">{copy.title}</strong>
      <span class="home-launch-week-float__summary">{copy.summary}</span>
      <span class="home-launch-week-float__cta">
        {copy.cta}
        <span aria-hidden="true">→</span>
      </span>
    </span>
  </a>
  <button
    class="home-launch-week-float__close"
    type="button"
    aria-label={copy.closeLabel}
    data-home-launch-week-close
  >
    <span aria-hidden="true">×</span>
  </button>
</aside>

<script is:inline>
  (() => {
    const float = document.querySelector('[data-home-launch-week-float]');
    if (!float) return;

    const params = new URLSearchParams(window.location.search);
    const forcePreview = params.get('launch_week_float') === 'preview';
    const startAt = Date.parse(float.getAttribute('data-event-start-at') || '');
    const endAt = Date.parse(float.getAttribute('data-event-end-at') || '');
    const now = Date.now();
    const inWindow = Number.isFinite(startAt) && Number.isFinite(endAt) && now >= startAt && now < endAt;
    if (!forcePreview && !inWindow) return;

    const shanghaiNow = new Date(now + 8 * 60 * 60 * 1000);
    const dayKey = [
      shanghaiNow.getUTCFullYear(),
      String(shanghaiNow.getUTCMonth() + 1).padStart(2, '0'),
      String(shanghaiNow.getUTCDate()).padStart(2, '0'),
    ].join('-');
    const dismissKey = `open-design:home-launch-week-float:dismissed:${dayKey}`;
    let dismissed = false;
    try { dismissed = window.localStorage.getItem(dismissKey) === '1'; } catch {}
    if (dismissed && !forcePreview) return;

    float.hidden = false;
    window.__odTrack?.('surface_view', {
      page_name: 'landing_home',
      area: 'launch_week_float',
      element: 'launch_week_vol_01',
      locale: float.getAttribute('data-locale') || 'en',
    });

    float.querySelector('[data-home-launch-week-link]')?.addEventListener('click', () => {
      window.__odTrack?.('ui_click', {
        page_name: 'landing_home',
        area: 'launch_week_float',
        element: 'open_launch_week',
        locale: float.getAttribute('data-locale') || 'en',
      });
    });

    float.querySelector('[data-home-launch-week-close]')?.addEventListener('click', () => {
      window.__odTrack?.('ui_click', {
        page_name: 'landing_home',
        area: 'launch_week_float',
        element: 'dismiss',
        locale: float.getAttribute('data-locale') || 'en',
      });
      try { window.localStorage.setItem(dismissKey, '1'); } catch {}
      float.hidden = true;
    });
  })();
</script>

<style is:global>
  .home-launch-week-float[hidden] { display: none; }
  .home-launch-week-float {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    /* Sit above the page-level GradualBlur band (z-index 1100). */
    z-index: 1200;
    width: min(456px, calc(100vw - 40px));
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 82%, transparent);
    border-radius: 10px;
    background: var(--paper);
    box-shadow: 0 24px 64px -28px rgb(38 38 38 / 52%);
    font-family: var(--sans);
  }
  .home-launch-week-float__link {
    display: grid;
    grid-template-columns: 178px minmax(0, 1fr);
    min-height: 154px;
    color: var(--ink);
    text-decoration: none;
  }
  .home-launch-week-float__link:focus-visible {
    outline: 3px solid var(--coral);
    outline-offset: -4px;
  }
  .home-launch-week-float__visual {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-right: 1px solid var(--ink);
    background: var(--paper-dark);
  }
  .home-launch-week-float__visual img {
    position: absolute;
    top: 0;
    left: 0;
    width: 165%;
    height: 100%;
    max-width: none;
  }
  .home-launch-week-float__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 17px 42px 16px 18px;
  }
  .home-launch-week-float__date {
    display: inline-flex;
    margin-bottom: 9px;
    padding: 3px 7px;
    border-radius: 3px;
    color: var(--ink);
    background: var(--coral);
    font-size: 10px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: .08em;
    white-space: nowrap;
  }
  .home-launch-week-float__title {
    display: block;
    font-size: 20px;
    font-weight: 820;
    line-height: 1.06;
    letter-spacing: -.025em;
  }
  .home-launch-week-float__summary {
    display: -webkit-box;
    margin-top: 7px;
    overflow: hidden;
    color: var(--ink-mute);
    font-size: 12px;
    font-weight: 520;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .home-launch-week-float__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    padding-top: 9px;
    color: var(--ink);
    font-size: 12px;
    font-weight: 780;
    line-height: 1.1;
    white-space: nowrap;
  }
  .home-launch-week-float__cta > span {
    display: inline-block;
    color: var(--olive);
    transition: transform 180ms ease;
  }
  .home-launch-week-float__link:hover .home-launch-week-float__cta > span { transform: translateX(3px); }
  .home-launch-week-float__link:active { transform: translateY(1px); }
  .home-launch-week-float__close {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid rgb(38 38 38 / 16%);
    border-radius: 999px;
    color: var(--ink);
    background: rgb(250 250 250 / 90%);
    font: 20px/1 var(--sans);
    cursor: pointer;
    transition: background 160ms ease, transform 160ms ease;
  }
  .home-launch-week-float__close:hover { background: var(--coral); }
  .home-launch-week-float__close:active { transform: scale(.96); }
  .home-launch-week-float__close:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-launch-week-float:not([hidden]) {
      animation: home-launch-week-float-in 420ms cubic-bezier(.16, 1, .3, 1) both;
    }
    @keyframes home-launch-week-float-in {
      from { opacity: 0; transform: translateY(18px) scale(.975); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
  }
  @media (max-width: 560px) {
    body:has(.nav.is-open) .home-launch-week-float { visibility: hidden; }
    .home-launch-week-float {
      right: max(12px, env(safe-area-inset-right));
      bottom: max(12px, env(safe-area-inset-bottom));
      left: max(12px, env(safe-area-inset-left));
      width: auto;
    }
    .home-launch-week-float__link {
      grid-template-columns: 158px minmax(0, 1fr);
      min-height: 136px;
    }
    .home-launch-week-float__content { padding: 14px 40px 13px 15px; }
    .home-launch-week-float__date { margin-bottom: 7px; }
    .home-launch-week-float__title { font-size: 18px; }
    .home-launch-week-float__summary { margin-top: 5px; font-size: 11.5px; }
    .home-launch-week-float__cta { gap: 5px; padding-top: 7px; font-size: 10.5px; }
    .home-launch-week-float__close { top: 8px; right: 8px; }
  }
  @media (max-width: 360px) {
    .home-launch-week-float__link {
      grid-template-columns: 130px minmax(0, 1fr);
      min-height: 112px;
    }
    .home-launch-week-float__content { padding: 11px 32px 10px 12px; }
    .home-launch-week-float__title { font-size: 16px; }
    .home-launch-week-float__summary { display: none; }
    .home-launch-week-float__cta {
      padding-top: 6px;
      font-size: 10px;
      line-height: 1.2;
      white-space: normal;
    }
  }
</style>
