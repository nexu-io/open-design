---
/*
 * Detail view for one curated DeepSeek Harness design plugin: the DeepSeek
 * binding over the shared curated-skill-detail layout.
 */
import CuratedSkillDetail from './curated-skill-detail.astro';
import { DEEPSEEK_BINDING } from '../_lib/deepseek-binding';
import type { DeepseekSkill } from '../_lib/deepseek-design';

interface Props {
  skill: DeepseekSkill;
}
const { skill } = Astro.props as Props;
---

<CuratedSkillDetail skill={skill} binding={DEEPSEEK_BINDING} />
