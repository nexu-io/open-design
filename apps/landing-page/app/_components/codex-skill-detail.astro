---
/*
 * Detail view for one curated Codex design plugin: the Codex binding over the
 * shared curated-skill-detail layout (see `curated-skill-detail.astro`).
 */
import CuratedSkillDetail from './curated-skill-detail.astro';
import { CODEX_BINDING } from '../_lib/codex-binding';
import type { CodexSkill } from '../_lib/codex-design';

interface Props {
  skill: CodexSkill;
}
const { skill } = Astro.props as Props;
---

<CuratedSkillDetail skill={skill} binding={CODEX_BINDING} />
