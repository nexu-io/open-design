<script>
  document.querySelectorAll<HTMLElement>('[data-demo-pricing]').forEach((root) => {
    const fillCount = (template: string, count: string) => template.replace('{count}', count);
    root.querySelectorAll<HTMLButtonElement>('[data-module-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const module = button.closest<HTMLElement>('[data-model-module]');
        if (!module || button.disabled) return;
        const expanded = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(expanded));
        module.classList.toggle('is-expanded', expanded);
        const label = button.querySelector('span');
        const total = button.dataset.total ?? '';
        if (label) label.textContent = expanded
          ? root.dataset.showLessLabel ?? ''
          : fillCount(root.dataset.viewAllLabel ?? '', total);
      });
    });

    const usageModule = root.querySelector<HTMLElement>('[data-usage-module]');
    if (usageModule) {
      if (!('IntersectionObserver' in window)) {
        usageModule.classList.add('is-visible');
      } else {
        const observer = new IntersectionObserver(([entry]) => {
          if (!entry?.isIntersecting) return;
          usageModule.classList.add('is-visible');
          observer.disconnect();
        }, { threshold: 0.22 });
        observer.observe(usageModule);
      }
    }

    const benefitsToggle = root.querySelector<HTMLButtonElement>('[data-benefits-toggle]');
    benefitsToggle?.addEventListener('click', () => {
      const expanded = benefitsToggle.getAttribute('aria-expanded') !== 'true';
      benefitsToggle.setAttribute('aria-expanded', String(expanded));
      root.dataset.benefitsExpanded = String(expanded);
      const label = benefitsToggle.querySelector('span');
      if (label) label.textContent = expanded
        ? root.dataset.showFewerBenefitsLabel ?? ''
        : root.dataset.viewMoreBenefitsLabel ?? '';
    });
  });
</script>
