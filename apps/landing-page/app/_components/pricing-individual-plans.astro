---
import {
  GO_PLAN,
  PRICING_SNAPSHOT,
  formatUsd,
  type PlanTierConfig,
} from '../_lib/pricing';
import {
  CREDIT_BONUS_PCT,
  fillTemplate,
  getPricingContent,
  type PlanTierId,
} from '../_lib/pricing-content';
import { getCatalogCounts } from '../_lib/catalog';
import { localeFromPath } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const content = getPricingContent(locale);
const L = content.labels;
const P = content.personal;
const tiers = PRICING_SNAPSHOT.tiers;
const catalogCounts = await getCatalogCounts(locale);
const skillsCount = catalogCounts.skills.toLocaleString('en-US');
const systemsCount = catalogCounts.systems.toLocaleString('en-US');

type TierId = 'go' | PlanTierId;
type ModelCategory = 'popular' | 'flagship' | 'image';

interface ModelItem {
  name: string;
  icon: string;
  iconClass?: string;
}

const DEMO_ASSET_BASE = '/pricing-e-final/assets';

const popularModels: ModelItem[] = [
  { name: 'DeepSeek V4 Flash Vision Exp', icon: '/agents/deepseek.svg' },
  { name: 'DeepSeek V4 Flash', icon: '/agents/deepseek.svg' },
  { name: 'GLM-5.2', icon: `${DEMO_ASSET_BASE}/zai-logo-official-Byn-xbrp.png`, iconClass: 'model-logo-zhipu' },
  { name: 'Kimi K2.7 Code', icon: '/model-icons/kimi.svg', iconClass: 'model-logo-kimi' },
  { name: 'DeepSeek V4 Pro', icon: '/agents/deepseek.svg' },
  { name: 'MiniMax M2.7', icon: '/model-icons/minimax.svg' },
  { name: 'Kimi K2.6', icon: '/model-icons/kimi.svg', iconClass: 'model-logo-kimi' },
  { name: 'MiMo V2.5 Pro', icon: `${DEMO_ASSET_BASE}/mimo-logo-user-CWOWEwG5.png`, iconClass: 'model-logo-mimo' },
  { name: 'GLM-5.1', icon: `${DEMO_ASSET_BASE}/zai-logo-official-Byn-xbrp.png`, iconClass: 'model-logo-zhipu' },
];

const flagshipModels: ModelItem[] = [
  { name: 'Claude Fable 5', icon: '/model-icons/claude.svg' },
  { name: 'Kimi-K3', icon: '/model-icons/kimi.svg', iconClass: 'model-logo-kimi' },
  { name: 'GPT-5.6-Sol', icon: '/agents/openai.svg' },
  { name: 'Claude Opus 5', icon: '/model-icons/claude.svg' },
  { name: 'GPT-5.5-Pro', icon: '/agents/openai.svg' },
  { name: 'Claude Opus 4.7', icon: '/model-icons/claude.svg' },
  { name: 'Claude Opus 4.8', icon: '/model-icons/claude.svg' },
  { name: 'Claude Sonnet 5', icon: '/model-icons/claude.svg' },
  { name: 'Claude Opus 4.6', icon: '/model-icons/claude.svg' },
  { name: 'Claude Sonnet 4.6', icon: '/model-icons/claude.svg' },
  { name: 'GPT-5.5', icon: '/agents/openai.svg' },
  { name: 'Grok-4.5', icon: '/model-icons/grok.svg' },
];

const plusFlagshipModels = flagshipModels.filter(
  (model) => !['Claude Fable 5', 'Claude Opus 5', 'GPT-5.5-Pro'].includes(model.name),
);

const imageModels: ModelItem[] = [
  { name: 'Seedream 5 Lite / Pro', icon: '/model-icons/jimeng.svg' },
  { name: 'Nano Banana 2', icon: '/model-icons/nanobanana.svg', iconClass: 'model-logo-nanobanana' },
  { name: 'GPT Image 2', icon: '/agents/openai.svg' },
];

const unlimitedByTier: Record<TierId, Set<string>> = {
  go: new Set(['DeepSeek V4 Flash Vision Exp', 'DeepSeek V4 Flash', 'DeepSeek V4 Pro', 'GLM-5.2']),
  plus: new Set(['DeepSeek V4 Flash Vision Exp', 'DeepSeek V4 Flash', 'DeepSeek V4 Pro', 'GLM-5.2', 'Kimi K2.7 Code']),
  // Pro includes GLM-5.2, not MiniMax M2.7: every tier from Go up carries
  // GLM-5.2, while MiniMax M2.7 stays metered until Max.
  pro: new Set([
    'DeepSeek V4 Flash Vision Exp',
    'DeepSeek V4 Flash',
    'DeepSeek V4 Pro',
    'GLM-5.2',
    'Kimi K2.7 Code',
    'MiMo V2.5 Pro',
  ]),
  max: new Set(popularModels.map((model) => model.name)),
};

const popularModelDisplayOrder = [
  'DeepSeek V4 Flash Vision Exp',
  'DeepSeek V4 Flash',
  'DeepSeek V4 Pro',
  'GLM-5.2',
  'Kimi K2.7 Code',
  'MiMo V2.5 Pro',
  'MiniMax M2.7',
  'Kimi K2.6',
  'GLM-5.1',
];

const orderedPopularModels = () =>
  popularModelDisplayOrder.map((name) => popularModels.find((model) => model.name === name)!);

const renderCatalogLabel = (label: string) => fillTemplate(label, {
  skillsCount,
  systemsCount,
});

const tierCopy = {
  go: content.go,
  ...content.plans,
};
const tierTaglines: Record<TierId, string> = {
  go: content.go.tagline,
  plus: content.plans.plus.tagline,
  pro: content.plans.pro.tagline,
  max: content.plans.max.tagline,
};

const customDomainsByTier: Record<PlanTierId, number | null> = {
  plus: 10,
  pro: 40,
  max: null,
};
const paidTierBenefits = (tier: PlanTierId) => {
  const config = tiers.find((candidate) => candidate.tier === tier)!;
  const plan = content.plans[tier];
  const customDomains = customDomainsByTier[tier];
  return [
    fillTemplate(L.creditBenefit, { amount: formatUsd(config.monthly.grantUsd) }),
    fillTemplate(P.unlimitedPopularModels, { count: String(unlimitedByTier[tier].size) }),
    customDomains == null
      ? P.unlimitedCustomDomains
      : fillTemplate(P.customDomains, { count: String(customDomains) }),
    plan.concurrency,
    P.bringYourOwnApiKey,
    ...plan.features,
    ...(tier === 'max' ? [P.creatorDeveloperSupport] : []),
  ].map(renderCatalogLabel);
};
const tierBenefits: Record<TierId, string[]> = {
  go: [
    content.go.allowance,
    P.goConcurrency,
    fillTemplate(P.customDomains, { count: '5' }),
    ...content.go.features,
    ...content.plans.plus.features.slice(1),
  ].map(renderCatalogLabel),
  plus: paidTierBenefits('plus'),
  pro: paidTierBenefits('pro'),
  max: paidTierBenefits('max'),
};

const compactSavings = (amountUsd: number, interval: 'monthly' | 'yearly') => {
  const amount = formatUsd(amountUsd);
  return locale === 'en' && interval === 'monthly' ? `${amount}/mo` : amount;
};
const compactBillingTotal = (amountUsd: number) =>
  locale === 'en' ? formatUsd(amountUsd).replace('$', '') : formatUsd(amountUsd);

function individualView(tier: PlanTierConfig) {
  const yearlyEquivalent = Math.round(tier.yearly.priceUsd / 12);
  const yearlySave = tier.monthly.priceUsd * 12 - tier.yearly.priceUsd;
  const introDiscount = Math.round(
    (1 - tier.monthly.introPriceUsd / tier.monthly.priceUsd) * 100,
  );
  return {
    monthly: {
      amount: formatUsd(tier.monthly.introPriceUsd).replace('$', ''),
      strike: formatUsd(tier.monthly.priceUsd),
      discount: introDiscount,
      saving: compactSavings(
        tier.monthly.priceUsd - tier.monthly.introPriceUsd,
        'monthly',
      ),
      billed: fillTemplate(L.monthlyRenewal, {
        amountUsd: formatUsd(tier.monthly.priceUsd),
      }),
    },
    yearly: {
      amount: formatUsd(yearlyEquivalent).replace('$', ''),
      strike: formatUsd(tier.monthly.priceUsd),
      discount: tier.yearly.discountPct,
      saving: compactSavings(yearlySave, 'yearly'),
      billed: fillTemplate(L.yearlySubline, {
        totalUsd: compactBillingTotal(tier.yearly.priceUsd),
        savingsUsd: formatUsd(yearlySave),
      }),
    },
  };
}

const goYearlyEquivalent = Math.round(GO_PLAN.yearly.priceUsd / 12);
const goMonthlyDiscount = Math.round(
  (1 - GO_PLAN.monthly.introPriceUsd / GO_PLAN.monthly.priceUsd) * 100,
);
const goYearlyDiscount = Math.round(
  (1 - goYearlyEquivalent / GO_PLAN.monthly.priceUsd) * 100,
);
const goYearlySave = GO_PLAN.monthly.priceUsd * 12 - GO_PLAN.yearly.priceUsd;
const goView = {
  monthly: {
    amount: formatUsd(GO_PLAN.monthly.introPriceUsd).replace('$', ''),
    strike: formatUsd(GO_PLAN.monthly.priceUsd),
    discount: goMonthlyDiscount,
    saving: compactSavings(
      GO_PLAN.monthly.priceUsd - GO_PLAN.monthly.introPriceUsd,
      'monthly',
    ),
    billed: fillTemplate(L.monthlyRenewal, {
      amountUsd: formatUsd(GO_PLAN.monthly.priceUsd),
    }),
  },
  yearly: {
    amount: formatUsd(goYearlyEquivalent).replace('$', ''),
    strike: formatUsd(GO_PLAN.monthly.priceUsd),
    discount: goYearlyDiscount,
    saving: compactSavings(goYearlySave, 'yearly'),
    billed: fillTemplate(L.yearlySubline, {
      totalUsd: compactBillingTotal(GO_PLAN.yearly.priceUsd),
      savingsUsd: formatUsd(goYearlySave),
    }),
  },
};

const cardData = [
  {
    tier: 'go' as const,
    logo: null,
    view: goView,
    regularMonthlyPrice: GO_PLAN.monthly.priceUsd,
  },
  ...tiers.map((tier) => ({
    tier: tier.tier as PlanTierId,
    logo: `/pricing/plan-${tier.tier}.svg`,
    view: individualView(tier),
    regularMonthlyPrice: tier.monthly.priceUsd,
  })),
];

const popularModel = (name: string) => popularModels.find((model) => model.name === name)!;
const usageRows = [
  { ...popularModel('DeepSeek V4 Flash'), value: 13000 },
  { ...popularModel('MiMo V2.5 Pro'), value: 11000 },
  { ...popularModel('DeepSeek V4 Flash Vision Exp'), value: 8000 },
  { ...popularModel('DeepSeek V4 Pro'), value: 4300 },
  { ...popularModel('MiniMax M2.7'), value: 2800 },
  { ...popularModel('Kimi K2.6'), value: 1000 },
  { ...popularModel('Kimi K2.7 Code'), value: 900 },
  { ...popularModel('GLM-5.2'), value: 670 },
  { ...popularModel('GLM-5.1'), value: 670 },
];

const comparisonPopular = orderedPopularModels();

const comparisonFlagship = [
  'Kimi-K3',
  'GPT-5.6-Sol',
  'Claude Opus 4.7',
  'Claude Opus 4.8',
  'Claude Sonnet 5',
  'Claude Opus 4.6',
  'Claude Sonnet 4.6',
  'GPT-5.5',
  'Grok-4.5',
  'Claude Fable 5',
  'Claude Opus 5',
  'GPT-5.5-Pro',
].map((name) => flagshipModels.find((model) => model.name === name)!);

const categoryCopy: Record<ModelCategory, { title: string; count: string }> = {
  popular: {
    title: P.popularModels,
    count: fillTemplate(P.modelCount, { count: String(comparisonPopular.length) }),
  },
  flagship: {
    title: P.flagshipModels,
    count: fillTemplate(P.modelCount, { count: '12' }),
  },
  image: {
    title: P.imageModels,
    count: fillTemplate(P.modelCount, { count: '3' }),
  },
};

function popularAccessStatus(modelName: string, tier: TierId) {
  if (unlimitedByTier[tier].has(modelName)) {
    return { kind: 'unlimited', text: P.unlimited };
  }
  if (tier === 'go') return { kind: 'ample', text: P.ample };
  return { kind: 'more-ample', text: P.moreAmple };
}

function accessStatus(category: ModelCategory, modelName: string, tier: TierId) {
  if (category === 'image') {
    if (tier === 'go') return { kind: 'unavailable', text: P.notAvailable };
    return {
      kind: 'resolution',
      text: fillTemplate(P.upToResolution, {
        resolution: tier === 'plus' ? '1K' : tier === 'pro' ? '2K' : '4K',
      }),
    };
  }
  if (category === 'flagship') {
    const unavailable = tier === 'go' || (tier === 'plus' && ['Claude Fable 5', 'Claude Opus 5', 'GPT-5.5-Pro'].includes(modelName));
    return unavailable
      ? { kind: 'unavailable', text: P.notAvailable }
      : { kind: 'included', text: P.included };
  }
  return popularAccessStatus(modelName, tier);
}

const otherModels = 'Gemini-3.1-Pro, Grok-4.5, GPT-5.4, GPT-5.6-Terra, Qwen3.7-Max, GPT-5.3-Codex, Gemini 3 Flash, GPT-5.4 mini, GPT-5.6-Luna, Kimi-K2.5, GLM-5';
---

<section
  class="demo-individual-pricing"
  data-demo-pricing
  data-benefits-expanded="false"
  data-view-all-label={P.viewAll}
  data-show-less-label={P.showLess}
  data-view-more-benefits-label={P.viewMoreBenefits}
  data-show-fewer-benefits-label={P.showFewerBenefits}
>
  <div class="benefits-summary-stage">
    <div class="four-tier-grid decision-grid">
      {cardData.map(({ tier, logo, view, regularMonthlyPrice }) => {
        const popular = orderedPopularModels();
        const flagship = tier === 'plus' ? plusFlagshipModels : flagshipModels;
        const imageResolution = tier === 'plus' ? '1K' : tier === 'pro' ? '2K' : '4K';
        const bonusPct = tier === 'go' ? null : CREDIT_BONUS_PCT[tier];
        return (
          <article class:list={['pricing-card', 'decision-card', 'compact-tier-card', `plan-${tier}`, { 'new-plan-card recommended': tier === 'pro' || tier === 'max' }]} data-tier={tier}>
            {tier === 'pro' && <div class="new-plan-ribbon"><span>{P.mostPopular}</span></div>}
            {tier === 'max' && <div class="new-plan-ribbon"><span>{P.lowestUnitPrice}</span></div>}

            <header class="plan-top">
              <div class="plan-title-row">
                <div class="plan-name-with-status">
                  {logo ? (
                    <img class="plan-wordmark-image" src={logo} alt={tier.charAt(0).toUpperCase() + tier.slice(1)} />
                  ) : (
                    <svg class="plan-wordmark-image plan-go-wordmark" viewBox="0 0 88 49" role="img" aria-label="Go">
                      <path d="M1 2.5h63c12 0 21.5 9.8 21.5 22S76 46.5 64 46.5H1" />
                      <path d="M29 17c-2.4-3.6-6.4-5.5-11.4-5.5C8.8 11.5 2 17 2 24.5s6.8 13 15.6 13c5.7 0 10-2.3 12.3-6.5v-7H17.5" />
                      <ellipse cx="50.5" cy="24.5" rx="12.5" ry="13" />
                    </svg>
                  )}
                </div>
                <div class="plan-badges">
                  <span class="discount-corner-badge" data-when="monthly" data-intro-only>{fillTemplate(L.firstMonthTag, { pct: String(view.monthly.discount) })}</span>
                  <span class="discount-corner-badge" data-when="yearly">{fillTemplate(L.yearlyDiscountTag, { pct: String(view.yearly.discount) })}</span>
                </div>
              </div>
              <p>{tierTaglines[tier]}</p>
            </header>

            <div class="price" data-when="monthly">
              <span>$</span><strong
                class="rolling-price-number"
                data-monthly-price
                data-intro-price={view.monthly.amount}
                data-regular-price={formatUsd(regularMonthlyPrice).replace('$', '')}
              >{view.monthly.amount}</strong><small>{L.perMonth}</small><del data-intro-only>{view.monthly.strike}</del>
            </div>
            <div class="compact-price-detail" data-when="monthly" data-intro-only>
              <span class="price-savings-note">{fillTemplate(P.saveAmount, { amount: view.monthly.saving })}</span>
              <small>{view.monthly.billed}</small>
            </div>
            <div class="price" data-when="yearly">
              <span>$</span><strong class="rolling-price-number">{view.yearly.amount}</strong><small>{L.perMonth}</small><del>{view.yearly.strike}</del>
            </div>
            <div class="compact-price-detail" data-when="yearly">
              <span class="price-savings-note">{fillTemplate(P.saveAmount, { amount: view.yearly.saving })}</span>
              <small>{view.yearly.billed}</small>
            </div>

            <a
              class="pricing-card-cta"
              data-pricing-cta
              data-tier={tier}
              data-plan-name={tier.charAt(0).toUpperCase() + tier.slice(1)}
              data-default-label={tierCopy[tier].ctaLabel}
            >
              <span>{tierCopy[tier].ctaLabel}</span>
            </a>

            <div class="plan-feature-details">
              <div class="plan-model-modules">
                <section class="plan-model-module unlimited-module" data-model-module>
                  <header>
                    <div class="plan-model-title-with-help">
                      <h4>{fillTemplate(P.unlimitedPopularModels, { count: String(unlimitedByTier[tier].size) })}</h4>
                      <details class="plan-model-help">
                        <summary aria-label={P.aboutModelEntitlements}>?</summary>
                        <span class="plan-model-help-copy">{P.modelEntitlementActivationNote}</span>
                      </details>
                    </div>
                  </header>
                  <ul>
                    {popular.map((model) => {
                      const popularStatus = popularAccessStatus(model.name, tier);
                      return (
                        <li class="model-with-status">
                          <span class:list={['model-logo', model.iconClass]}><img src={model.icon} alt="" loading="lazy" /></span>
                          <span
                            class:list={{ 'long-model-name': model.name.length > 24 }}
                            title={model.name}
                          >{model.name}</span>
                          {popularStatus.kind === 'unlimited' && <em class={popularStatus.kind}>{popularStatus.text}</em>}
                        </li>
                      );
                    })}
                  </ul>
                  <button type="button" class="model-module-toggle" aria-expanded="false" data-module-toggle data-total={popular.length}>
                    <span>{fillTemplate(P.viewAll, { count: String(popular.length) })}</span><span class="toggle-symbol">+</span>
                  </button>
                </section>

                <section class:list={['plan-model-module', { 'unavailable-model-module': tier === 'go', 'recommended-model-module': tier === 'pro' || tier === 'max' }]} data-model-module>
                  <header>
                    <h4>{tier === 'go' ? P.flagshipModels : fillTemplate(P.flagshipModelCount, { count: String(flagship.length) })}</h4>
                    {tier === 'go' && <span>{P.noAccess}</span>}
                  </header>
                  <ul>
                    {flagship.map((model) => (
                      <li>
                        <span class:list={['model-logo', model.iconClass]}><img src={model.icon} alt="" loading="lazy" /></span><span>{model.name}</span>
                      </li>
                    ))}
                  </ul>
                  <button type="button" class="model-module-toggle" aria-expanded="false" data-module-toggle data-total={flagship.length}>
                    <span>{fillTemplate(P.viewAll, { count: String(flagship.length) })}</span><span class="toggle-symbol">+</span>
                  </button>
                </section>

                <section class:list={['plan-model-module', 'multimodal-model-module', { 'unavailable-model-module': tier === 'go', 'recommended-model-module': tier === 'pro' || tier === 'max' }]}>
                  <header><h4>{P.imageModels}</h4><span>{tier === 'go' ? P.noAccess : fillTemplate(P.modelCount, { count: '3' })}</span></header>
                  <ul>
                    {imageModels.map((model) => (
                      <li class="model-with-status">
                        <span class:list={['model-logo', model.iconClass]}><img src={model.icon} alt="" loading="lazy" /></span>
                        <span>{model.name}</span>
                        {tier !== 'go' && <em class="multimodal-status">{fillTemplate(P.upToResolution, { resolution: imageResolution })}</em>}
                      </li>
                    ))}
                  </ul>
                </section>
              </div>

              <ul class="plan-benefit-list">
                {tierBenefits[tier].map((benefit, index) => (
                  <li>
                    <b>✓</b>
                    <span>
                      {benefit}
                      {bonusPct != null && index === 0 && (
                        <span class="bonus-benefit">
                          <span>{fillTemplate(L.creditBonus, { pct: String(bonusPct) })}</span>
                        </span>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        );
      })}
    </div>
    <div class="shared-benefits-toggle-wrap">
      <button type="button" class="shared-benefits-toggle" aria-expanded="false" data-benefits-toggle>
        <span>{P.viewMoreBenefits}</span><span class="shared-benefits-chevron" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <section class="individual-usage-module" aria-labelledby="individual-usage-title" data-usage-module>
    <div class="individual-usage-heading">
      <div>
        <h2 id="individual-usage-title">{P.usageTitle}</h2>
        <p>{P.estimatedRequests}</p>
      </div>
    </div>
    <div class="individual-usage-surface">
      <div class="individual-usage-chart" role="table" aria-label={P.estimatedRequestsAria}>
        {usageRows.map((row, index) => (
          <div class="individual-usage-row" role="row">
            <div class="individual-usage-model" role="cell">
              <span class:list={['model-logo', row.iconClass]}><img src={row.icon} alt="" loading="lazy" /></span><strong>{row.name}</strong>
            </div>
            <div class="individual-usage-meter" role="cell">
              <i style={`--usage-width:${(row.value / 13000) * 100}%;--usage-delay:${index * 0.045}s`}></i>
              <b>{row.value.toLocaleString('en-US')}</b>
            </div>
          </div>
        ))}
        <div class="individual-usage-axis" aria-hidden="true">
          <span></span><div><b>0</b><b>3.25K</b><b>6.5K</b><b>9.75K</b><b>13K</b></div>
        </div>
      </div>
    </div>
    <div class="individual-usage-note">
      <p>{P.usageAllowanceNote}</p>
      <p>{P.usageEstimatesNote}</p>
    </div>
  </section>

  <section class="all-models-comparison" aria-labelledby="all-models-title">
    <div class="all-models-heading"><h2 id="all-models-title">{P.comparisonTitle}</h2></div>
    <div class="model-compare-shell">
      <div class="model-compare-scroll">
        <table class="model-compare-table">
          <thead>
            <tr>
              <th class="category-column">{P.category}</th>
              <th class="model-column">{P.model}</th>
              {(['go', 'plus', 'pro', 'max'] as TierId[]).map((tier) => (
                <th>
                  {tier === 'go' ? (
                    <svg class="comparison-wordmark plan-go-wordmark" viewBox="0 0 88 49" role="img" aria-label="go"><path d="M1 2.5h63c12 0 21.5 9.8 21.5 22S76 46.5 64 46.5H1" /><path d="M29 17c-2.4-3.6-6.4-5.5-11.4-5.5C8.8 11.5 2 17 2 24.5s6.8 13 15.6 13c5.7 0 10-2.3 12.3-6.5v-7H17.5" /><ellipse cx="50.5" cy="24.5" rx="12.5" ry="13" /></svg>
                  ) : <img src={`/pricing/plan-${tier}.svg`} alt={tier} />}
                  <small>{P.tierUse[tier]}</small>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {([
              ['popular', comparisonPopular],
              ['flagship', comparisonFlagship],
              ['image', imageModels],
            ] as [ModelCategory, ModelItem[]][]).flatMap(([category, models]) =>
              models.map((model, index) => (
                <tr>
                  {index === 0 && (
                    <th class="model-group-cell" rowspan={models.length} scope="rowgroup">
                      <span class="model-group-title">
                        <span>{categoryCopy[category].title}</span>
                        {category === 'popular' && (
                          <details class="model-group-help">
                            <summary aria-label={P.aboutPopularAllowance}>?</summary>
                            <span class="model-group-help-copy">{P.usageAllowanceNote}</span>
                          </details>
                        )}
                      </span>
                      <small>{categoryCopy[category].count}</small>
                    </th>
                  )}
                  <td class="model-name-cell"><span class:list={['model-logo', model.iconClass]}><img src={model.icon} alt="" loading="lazy" /></span><span>{model.name}</span></td>
                  {(['go', 'plus', 'pro', 'max'] as TierId[]).map((tier) => {
                    const status = accessStatus(category, model.name, tier);
                    const checkOnly = status.kind === 'more-ample' || status.kind === 'ample' || status.kind === 'included';
                    return checkOnly ? (
                      <td><span class={`model-access-status ${status.kind}`} aria-label={status.text}><i class="status-icon check"></i></span></td>
                    ) : (
                      <td><span class={`model-access-status ${status.kind}`}><i class:list={['status-icon', { infinity: status.kind === 'unlimited' }]}>{status.kind === 'unlimited' ? '∞' : ''}</i>{status.text}</span></td>
                    );
                  })}
                </tr>
              )),
            )}
          </tbody>
        </table>
      </div>
      <div class="other-models-note">
        <h3>{P.otherModelsTitle}</h3>
        <p class="other-models-list">{otherModels}</p>
        <p>{P.otherModelsDescription}</p>
      </div>
    </div>
  </section>
</section>

