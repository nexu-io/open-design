---
import type { LandingLocaleCode } from '../i18n';
import { DEEPSEEK_V4_PRO_CAMPAIGN } from '../_lib/deepseek-v4-pro-campaign';
import { getHomeCampaignContent } from '../_lib/home-campaign-content';
import { getPricingCampaignContent } from '../_lib/pricing-campaign-content';

interface Props {
  locale: LandingLocaleCode;
}

const { locale } = Astro.props;
const campaign = getPricingCampaignContent(locale);
const copy = getHomeCampaignContent(locale);
---

<aside
  class="pricing-campaign-banner"
  data-pricing-top-campaign
  data-day-unit={campaign.dayUnit}
  data-start-at={DEEPSEEK_V4_PRO_CAMPAIGN.startAt}
  data-end-at={DEEPSEEK_V4_PRO_CAMPAIGN.endAtExclusive}
  hidden
>
  <div class="pricing-campaign-banner__message">
    <span class="pricing-campaign-banner__badge">{campaign.badge}</span>
    <span class="pricing-campaign-banner__copy">
      <strong>{copy.title}</strong>
      <small>{copy.detail}</small>
    </span>
  </div>
  <div class="pricing-campaign-banner__timer">
    <small>{campaign.windowLabel}</small>
    <strong data-pricing-top-countdown>0{campaign.dayUnit} 00:00:00</strong>
  </div>
</aside>

<style>
  .pricing-campaign-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    margin: 0 auto 30px;
    padding: 18px 22px;
    border: 1px solid rgb(104 242 46 / 10%);
    border-radius: 16px;
    color: #172013;
    background: linear-gradient(100deg, #f3faef 0%, #f8fcf6 43%, #ddfbd0 100%);
  }
  .pricing-campaign-banner[hidden] { display: none !important; }
  .pricing-campaign-banner__message {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }
  .pricing-campaign-banner__badge {
    flex: 0 0 auto;
    padding: 6px 11px;
    border-radius: 999px;
    color: #153709;
    background: #71ed43;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }
  .pricing-campaign-banner__copy,
  .pricing-campaign-banner__timer {
    display: flex;
    flex-direction: column;
  }
  .pricing-campaign-banner__copy { gap: 5px; }
  .pricing-campaign-banner__copy strong {
    font-size: 16px;
    font-weight: 760;
    line-height: 1.25;
  }
  .pricing-campaign-banner__copy small {
    color: #596154;
    font-size: 12px;
    line-height: 1.3;
  }
  .pricing-campaign-banner__timer {
    flex: 0 0 auto;
    align-items: flex-end;
    gap: 5px;
    text-align: right;
  }
  .pricing-campaign-banner__timer small {
    color: #596154;
    font-size: 11px;
  }
  .pricing-campaign-banner__timer strong {
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    white-space: nowrap;
  }
  @media (max-width: 680px) {
    .pricing-campaign-banner {
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 22px;
      padding: 14px;
      border-radius: 13px;
    }
    .pricing-campaign-banner__message { align-items: flex-start; gap: 10px; }
    .pricing-campaign-banner__copy strong { font-size: 14px; }
    .pricing-campaign-banner__copy small { display: none; }
    .pricing-campaign-banner__timer { gap: 4px; }
    .pricing-campaign-banner__timer strong { font-size: 12px; }
  }
</style>

<script is:inline>
  (() => {
    const banner = document.querySelector('[data-pricing-top-campaign]');
    if (!banner) return;
    const countdown = banner.querySelector('[data-pricing-top-countdown]');
    const startAt = Date.parse(banner.getAttribute('data-start-at') || '');
    const endAt = Date.parse(banner.getAttribute('data-end-at') || '');
    const dayUnit = banner.getAttribute('data-day-unit') || 'd';

    const update = () => {
      const now = Date.now();
      const active = now >= startAt && now < endAt;
      banner.hidden = !active;
      if (!active || !countdown) return;
      const total = Math.max(0, Math.floor((endAt - now) / 1000));
      const days = Math.floor(total / 86400);
      const hours = Math.floor((total % 86400) / 3600);
      const minutes = Math.floor((total % 3600) / 60);
      const seconds = total % 60;
      countdown.textContent = `${days}${dayUnit} ${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    };

    update();
    const timer = window.setInterval(update, 1000);
    window.addEventListener('pagehide', () => window.clearInterval(timer), { once: true });
  })();
</script>
