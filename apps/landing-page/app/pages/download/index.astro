---
/*
 * /download/ — dedicated download center.
 *
 * Auto-reflects the latest stable release. The platform matrix is
 * rendered at build time from `getLatestStableRelease()` (SEO-friendly, works
 * without JS); an inline enhancer detects the visitor's OS, highlights
 * the matching row, and refetches the canonical R2 metadata to keep the
 * complete visible release snapshot current between rebuilds.
 */
import Layout from '../../_components/sub-page-layout.astro';
import { getLatestStableRelease, type ReleaseAsset } from '../../_lib/github';
import { RELEASE_METADATA_URL } from '../../_lib/release-metadata';
import { getInfoPageCopy } from '../../info-page-i18n';
import { localeFromPath, localizedHref } from '../../i18n';

const locale = localeFromPath(Astro.url.pathname);
const href = (path: string) => localizedHref(path, locale);
const copy = getInfoPageCopy(locale);
const page = copy.download;
const common = copy.common;

const release = await getLatestStableRelease();
const m = release.matrix;
const directAssets = {
  macArm64: m.macArm64Dmg?.url ?? '',
  macX64: m.macX64Dmg?.url ?? '',
  windows: m.winSetup?.url ?? '',
};

const SITE = Astro.site?.toString() ?? 'https://open-design.ai/';
const REPO = 'https://github.com/nexu-io/open-design';
const REPO_RELEASES = `${REPO}/releases`;
const QUICKSTART_DOC = `${REPO}/blob/main/QUICKSTART.md`;

const title = page.title;
const description = page.description;

function fmtSize(bytes: number): string | null {
  if (!bytes || bytes <= 0) return null;
  const mb = bytes / (1024 * 1024);
  return mb >= 1 ? `${mb.toFixed(0)} MB` : `${(bytes / 1024).toFixed(0)} KB`;
}

function fmtDate(iso: string | null): string | null {
  if (!iso) return null;
  // Stable, locale-agnostic YYYY-MM-DD (avoid build-host TZ drift).
  return iso.slice(0, 10);
}

// One download line in a platform card.
interface Row {
  key: string; // data-dl key the enhancer targets
  variant: string; // e.g. "DMG" / "ZIP" / "Installer"
  asset: ReleaseAsset | null;
}

interface PlatformCard {
  os: 'macOS' | 'Windows';
  osLabel: string;
  arch?: string; // sub-label, e.g. "Apple Silicon"
  matchKey: string; // ties to enhancer detectPlatform (recommend highlight)
  rows: Row[];
  note?: string;
}

const cards: PlatformCard[] = [
  {
    os: 'macOS',
    osLabel: page.mac,
    arch: page.macArm,
    matchKey: 'mac-arm64',
    // DMG only — the ZIP is a redundant second download for most users; the
    // all-releases link below still exposes every artifact.
    rows: [{ key: 'mac-arm64-dmg', variant: page.dmg, asset: m.macArm64Dmg }],
  },
  {
    os: 'macOS',
    osLabel: page.mac,
    arch: page.macIntel,
    matchKey: 'mac-x64',
    rows: [{ key: 'mac-x64-dmg', variant: page.dmg, asset: m.macX64Dmg }],
  },
  {
    os: 'Windows',
    osLabel: page.windows,
    matchKey: 'win',
    // Installer only — portable zip stays available via the all-releases link.
    rows: [{ key: 'win-setup', variant: page.windowsInstaller, asset: m.winSetup }],
  },
];

const publishedLabel = fmtDate(release.publishedAt);

// Platform glyphs for the centered cards (inline so they inherit currentColor
// and ship no extra requests). macOS + macOS-Intel share the Apple mark.
const ICON_APPLE =
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M16.36 12.78c.02 2.5 2.19 3.33 2.22 3.34-.02.06-.35 1.2-1.15 2.37-.69 1.01-1.41 2.02-2.54 2.04-1.11.02-1.47-.66-2.74-.66s-1.66.64-2.71.68c-1.09.04-1.92-1.09-2.62-2.1-1.42-2.06-2.51-5.83-1.05-8.37.72-1.27 2.01-2.07 3.41-2.09 1.07-.02 2.08.72 2.74.72.65 0 1.88-.89 3.17-.76.54.02 2.06.22 3.03 1.64-.08.05-1.81 1.06-1.79 3.15M14.28 5.6c.58-.7.97-1.68.86-2.65-.83.03-1.84.55-2.44 1.25-.54.62-1.01 1.61-.88 2.56.93.07 1.87-.47 2.46-1.16"/></svg>';
const ICON_WINDOWS =
  '<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M3 5.1 10.4 4v7.3H3zm0 13.8L10.4 20v-7.2H3zm8.2 1.2L21 21.3V12.8h-9.8zm0-16.2v7.4H21V2.7z"/></svg>';
const PLATFORM_ICON: Record<'macOS' | 'Windows', string> = {
  macOS: ICON_APPLE,
  Windows: ICON_WINDOWS,
};
const ICON_DOWNLOAD =
  '↓';

// Absolute URL for the current locale, so breadcrumb structured data matches
// the route actually being indexed (e.g. /ja/download/ on the Japanese page,
// not the canonical English URL on every localized variant).
const absUrl = (path: string) => new URL(href(path), SITE).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'OpenDesign', item: absUrl('/') },
      { '@type': 'ListItem', position: 2, name: page.breadcrumb, item: absUrl('/download/') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'OpenDesign',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'macOS, Windows',
    softwareVersion: release.version,
    softwareHelp: { '@type': 'CreativeWork', url: QUICKSTART_DOC },
    downloadUrl: m.macArm64Dmg?.url ?? release.releaseUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
  },
];
---

<Layout title={title} description={description} active="download" jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label={common.breadcrumbAria}>
    <a href={href('/')}>OpenDesign</a>
    <span>/</span>
    <span aria-current="page">{page.breadcrumb}</span>
  </nav>

  <article class="info-page dl-page" data-download-root>
    <header class="dl-hero">
      <div class="dl-hero-copy">
        <h1 class="dl-hero-heading">{page.heading}</h1>
        <p class="dl-hero-lead">{page.lead}</p>
        <p class="dl-mobile-notice" data-dl-mobile-notice hidden>
          {page.mobileDesktopNotice}
        </p>

        {/*
         * Static fallback points at the neutral release page, not a specific
         * asset: with JS disabled/blocked every platform (Windows, and Macs
         * whose arch we can't sniff) should reach a usable page rather than be
         * handed a macOS Apple Silicon DMG. The enhancer below swaps in the
         * detected platform's direct installer once it runs; platforms with no
         * packaged asset intentionally keep this release-page href.
         */}
        <div class="dl-hero-actions">
          <a
            class="btn btn-primary dl-hero-cta hero-download-attention"
            href={release.releaseUrl}
            data-dl-auto
            data-direct-download
            target="_blank"
            rel="noreferrer noopener"
          >
            <span class="dl-hero-cta-icon" aria-hidden="true">{ICON_DOWNLOAD}</span>
            <span data-dl-auto-label>{page.autoCtaFallback}</span>
            <span class="dl-auto-os" data-dl-auto-os hidden></span>
          </a>
          <a class="dl-hero-release-link" href={release.releaseUrl} data-release-notes-link target="_blank" rel="noreferrer noopener">
            {page.releaseNotes} ↗
          </a>
        </div>
        <p class="dl-hero-meta">
          <a class="inline-link" href={release.releaseUrl} data-release-notes-link target="_blank" rel="noreferrer noopener">
            <span data-release-version>{release.versionLabel}</span>
          </a>
          {publishedLabel && (
            <span class="dl-version-date">
              {' · '}{page.publishedPrefix} <span data-release-date>{publishedLabel}</span>
            </span>
          )}
        </p>
      </div>

      <figure class="dl-hero-visual">
        <div class="dl-hero-visual-shell">
          <img
            src="/hero-product-1280.webp"
            alt={page.heroVisualAlt}
            width="1280"
            height="741"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </figure>
    </header>

    <section class="dl-platforms" id="platforms" aria-label={page.platformsTitle}>
      <div class="dl-grid">
        {cards.map((card) => (
          <div class="dl-card" data-dl-card data-dl-match={card.matchKey}>
            <span class="dl-rec" data-dl-rec hidden>{page.recommended}</span>
            <span class="dl-card-icon" aria-hidden="true" set:html={PLATFORM_ICON[card.os]} />
            <h2 class="dl-os">{card.osLabel}</h2>
            <p class="dl-card-sub">
              {card.arch && <span class="dl-arch">{card.arch}</span>}
              <span class="dl-card-version" data-release-version>{release.versionLabel}</span>
            </p>

            {card.rows.length > 0 && (
              <ul class="dl-rows">
                {card.rows.map((row) => (
                  <li class="dl-row">
                    {row.asset ? (
                      <>
                        <a class="dl-link" href={row.asset.url} data-dl-key={row.key}>
                          <span class="dl-dl-icon" aria-hidden="true">{ICON_DOWNLOAD}</span>
                          {page.downloadVerb} <strong>{row.variant}</strong>
                          {fmtSize(row.asset.size) && <span class="dl-size" data-dl-size>{fmtSize(row.asset.size)}</span>}
                        </a>
                      </>
                    ) : (
                      <a class="dl-link dl-link-fallback" href={release.releaseUrl} target="_blank" rel="noreferrer noopener">
                        <span class="dl-dl-icon" aria-hidden="true">{ICON_DOWNLOAD}</span>
                        {row.variant} <span class="dl-size">→ Releases</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {/* Keep the platform note visible even when there are rows. */}
            {card.note && (
              <p class="dl-note">
                <a class="inline-link" href={release.releaseUrl} data-release-notes-link target="_blank" rel="noreferrer noopener">{card.note}</a>
              </p>
            )}
          </div>
        ))}
      </div>

      <p class="dl-releases-link">
        <a class="inline-link" href={REPO_RELEASES} target="_blank" rel="noreferrer noopener">{page.allReleasesTitle} →</a>
      </p>
    </section>

    <section class="dl-requirements" id="requirements" aria-label={page.requirementsTitle}>
      <ul>
        {page.requirements.map((item) => (
          <li><strong>{item.label}</strong> — {item.body}</li>
        ))}
      </ul>
    </section>

    <section class="info-cta" aria-label="OpenDesign call to action">
      <div>
        <h2>{page.ctaTitle}</h2>
        <p>{page.ctaBody}</p>
      </div>
      <div class="info-cta-actions">
        <a class="btn btn-primary" href={href('/quickstart/')}>{common.quickstart}</a>
        <a class="btn btn-ghost" href={REPO} target="_blank" rel="noreferrer noopener">{common.starOnGithub}</a>
      </div>
      <div class="info-cta-meta">
        <span class="stamp">● {common.live}</span>
        <span><span data-release-version>{release.versionLabel}</span> · Apache-2.0</span>
        <span>{common.macWin}</span>
      </div>
    </section>
  </article>

  <script
    is:inline
    define:vars={{
      autoPrefix: page.autoCtaPrefix,
      directAssets,
      releaseMetadataUrl: RELEASE_METADATA_URL,
    }}
  >
    (() => {
      // Download-intent analytics: capture clicks on the hero auto-CTA and on
      // every platform card link so the /download/ funnel is measurable. PostHog
      // is mounted by sub-page-layout; `__odTrack` is its shared capture wrapper
      // (fall back to posthog.capture). Bound before any early return so it works
      // regardless of platform detection.
      (function trackDownloadClicks() {
        const fire = (variant, el) => {
          try {
            const props = {
              page_name: 'download',
              variant: variant,
              link_url: (el && (el.getAttribute('href') || el.href)) || '',
            };
            if (typeof window.__odTrack === 'function') window.__odTrack('download_click', props);
            else if (window.posthog && window.posthog.capture) window.posthog.capture('download_click', props);
          } catch (e) {}
        };
        document.addEventListener('click', function (event) {
          const t = event.target;
          if (!t || !t.closest) return;
          const card = t.closest('[data-dl-key]');
          if (card) { fire(card.getAttribute('data-dl-key') || 'unknown', card); return; }
          const auto = t.closest('[data-dl-auto]');
          if (auto) { fire('auto-detected', auto); return; }
        });
      })();

      const ua = (navigator.userAgent || '').toLowerCase();
      const devicePlatform = (
        navigator.userAgentData?.platform ||
        navigator.platform ||
        ''
      ).toLowerCase();
      const isIpadOS = navigator.maxTouchPoints > 1 && /mac/.test(devicePlatform);
      const isMobileDevice =
        /android|iphone|ipad|ipod|mobile/.test(ua) ||
        navigator.userAgentData?.mobile === true ||
        isIpadOS;
      const mobileNotice = document.querySelector('[data-dl-mobile-notice]');
      const narrowViewport = window.matchMedia('(max-width: 767px)');
      const syncMobileNotice = () => {
        if (mobileNotice) mobileNotice.hidden = !(isMobileDevice || narrowViewport.matches);
      };
      syncMobileNotice();
      narrowViewport.addEventListener('change', syncMobileNotice);

      // Mirror header-enhancer.astro detection. Returns the matchKey used
      // on each [data-dl-card] plus the asset-name matcher + os label.
      const detect = () => {
        const ua = (navigator.userAgent || '').toLowerCase();
        const p = (
          (navigator.userAgentData && navigator.userAgentData.platform) ||
          navigator.platform || ''
        ).toLowerCase();
        // iPadOS desktop-mode Safari reports a Mac platform. Keep the hero CTA
        // on the neutral release page instead of rewriting it to a macOS DMG.
        if (isIpadOS || /iphone|ipad|ipod/.test(ua)) return null;
        const isWin = /win/.test(p) || /windows/.test(ua);
        const isMac = /mac/.test(p) || (/mac os x/.test(ua) && !/iphone|ipad|ipod/.test(ua));
        if (isWin) return { assetKey: 'windows', matchKey: 'win', os: 'Windows', match: (n) => /win.*setup\.exe$/.test(n) };
        if (isMac) {
          const intel = (() => {
            try {
              const gl = document.createElement('canvas').getContext('webgl');
              const dbg = gl && gl.getExtension('WEBGL_debug_renderer_info');
              const r = dbg ? String(gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) : '';
              return /intel|radeon|amd/i.test(r) && !/apple/i.test(r);
            } catch { return false; }
          })();
          return intel
            ? { assetKey: 'macX64', matchKey: 'mac-x64', os: 'macOS (Intel)', match: (n) => n.endsWith('mac-x64.dmg') }
            : { assetKey: 'macArm64', matchKey: 'mac-arm64', os: 'macOS (Apple Silicon)', match: (n) => n.endsWith('mac-arm64.dmg') };
        }
        // No Linux desktop build — Linux visitors keep the neutral
        // release-page fallback.
        return null;
      };

      const platform = detect();

      // Highlight the recommended card + set the hero CTA OS label.
      if (platform) {
        for (const card of document.querySelectorAll('[data-dl-card]')) {
          if (card.getAttribute('data-dl-match') === platform.matchKey) {
            card.setAttribute('data-dl-recommended', 'true');
            const rec = card.querySelector('[data-dl-rec]');
            if (rec) rec.hidden = false;
          }
        }
        const osSlot = document.querySelector('[data-dl-auto-os]');
        const labelSlot = document.querySelector('[data-dl-auto-label]');
        if (osSlot) { osSlot.textContent = ` ${platform.os}`; osSlot.hidden = false; }
        if (labelSlot) labelSlot.textContent = autoPrefix;
      }

      // Use the build-time latest asset immediately, closing the short window
      // where the primary CTA could still route through the download page.
      const hero = document.querySelector('[data-dl-auto]');
      const staticAsset = platform ? directAssets[platform.assetKey] : null;
      if (hero && staticAsset) {
        hero.href = staticAsset;
        hero.setAttribute('download', '');
        hero.removeAttribute('target');
        hero.removeAttribute('rel');
      }

      // Live refetch: replace the complete visible release snapshot from the
      // canonical stable R2 metadata, so labels and links cannot drift apart.
      fetch(releaseMetadataUrl, { headers: { Accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : null))
        .then((metadata) => {
          if (!metadata || metadata.channel !== 'stable' || metadata.releaseState !== 'complete') return;
          const versionMatch = typeof metadata.releaseVersion === 'string'
            ? metadata.releaseVersion.match(/^v?(\d+\.\d+\.\d+(?:[-+][\w.-]+)?)$/)
            : null;
          if (!versionMatch || !metadata.platforms || typeof metadata.platforms !== 'object') return;
          const releaseVersion = versionMatch[1];
          const expectedTag = `open-design-v${releaseVersion}`;
          if (metadata.versionTag !== expectedTag) return;
          const versionPrefix = `/stable/versions/${releaseVersion}`;

          const artifact = (platformKey, artifactKey) => {
            const value = metadata.platforms?.[platformKey]?.artifacts?.[artifactKey];
            if (!value || typeof value.url !== 'string' || !Number.isFinite(value.size) || value.size <= 0) return null;
            try {
              const url = new URL(value.url);
              if (
                url.origin !== 'https://releases.open-design.ai' ||
                (url.pathname !== versionPrefix &&
                  !url.pathname.startsWith(`${versionPrefix}/`) &&
                  !url.pathname.startsWith(`${versionPrefix}.`))
              ) return null;
            } catch {
              return null;
            }
            return { url: value.url, size: value.size };
          };
          const assets = {
            'mac-arm64-dmg': artifact('mac', 'dmg'),
            'mac-x64-dmg': artifact('macIntel', 'dmg'),
            'win-setup': artifact('win', 'installer'),
          };
          const linkUpdates = [];
          for (const link of document.querySelectorAll('[data-dl-key]')) {
            const key = link.getAttribute('data-dl-key');
            const asset = key ? assets[key] : null;
            if (!key || !asset) return;
            linkUpdates.push({ link, asset });
          }
          const versionLabel = `v${releaseVersion}`;
          const releaseDate = typeof metadata.generatedAt === 'string'
            ? metadata.generatedAt.slice(0, 10)
            : null;
          const releaseUrl = `https://github.com/nexu-io/open-design/releases/tag/${encodeURIComponent(expectedTag)}`;
          const formatSize = (bytes) => {
            const mb = bytes / (1024 * 1024);
            return mb >= 1 ? `${mb.toFixed(0)} MB` : `${(bytes / 1024).toFixed(0)} KB`;
          };

          for (const slot of document.querySelectorAll('[data-release-version]')) {
            slot.textContent = versionLabel;
          }
          if (releaseDate) {
            for (const slot of document.querySelectorAll('[data-release-date]')) {
              slot.textContent = releaseDate;
            }
          }
          if (releaseUrl) {
            for (const link of document.querySelectorAll('[data-release-notes-link]')) {
              link.href = releaseUrl;
            }
          }
          for (const { link, asset } of linkUpdates) {
            link.href = asset.url;
            const size = link.querySelector('[data-dl-size]');
            if (size) size.textContent = formatSize(asset.size);
          }
          const heroAssetKey = platform && {
            macArm64: 'mac-arm64-dmg',
            macX64: 'mac-x64-dmg',
            windows: 'win-setup',
          }[platform.assetKey];
          const heroAsset = heroAssetKey ? assets[heroAssetKey] : null;
          if (heroAsset && hero) {
            hero.href = heroAsset.url;
            hero.setAttribute('download', '');
            hero.removeAttribute('target');
            hero.removeAttribute('rel');
          } else if (releaseUrl && hero) {
            hero.href = releaseUrl;
            hero.removeAttribute('download');
            hero.setAttribute('target', '_blank');
            hero.setAttribute('rel', 'noreferrer noopener');
          }
        })
        .catch(() => {});
    })();
  </script>
</Layout>

<!--
  Tighten the shared sub-page rhythm for the download page only. The shared
  .info-page scale (56px head, 64px between sections, 56px CTA) is tuned for
  long-form info pages; the download page is a short, scannable matrix and
  reads as too sparse at that scale. Scoped to [data-download-root] so other
  info pages keep their spacing. is:global because these elements are rendered
  by the layout/sub-pages.css, not this page's scoped component tree.
-->
<style is:global>
  /*
   * The download page uses a centered, card-first layout (closer to a focused
   * landing surface than the left-aligned long-form info pages). globals.css
   * gives every <section> 130px padding and .info-page a wide measure; both
   * are neutralized here, scoped to [data-download-root] so other info pages
   * keep their rhythm. is:global because these elements come from the layout.
   */
  [data-download-root].info-page { max-width: none; }
  [data-download-root].info-page > section { padding: 0; }
  /* Match the CTA to the centered layout instead of the left-aligned
     two-column grid the shared .info-cta ships with. */
  [data-download-root].info-page .info-cta {
    margin: 56px auto 0;
    max-width: 640px;
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
  }
  [data-download-root].info-page .info-cta h2 { margin: 0 0 8px; }
  [data-download-root].info-page .info-cta-actions { justify-content: center; }
  [data-download-root].info-page .info-cta-meta { justify-content: center; border-top: 0; padding-top: 0; margin-top: 0; }
</style>

<style>
  /* ---- Download-led split hero ---- */
  .dl-hero {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(44px, 4vw, 60px);
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(40px, 5vw, 72px) 0 32px;
  }
  .dl-hero-copy {
    min-width: 0;
  }
  .dl-hero-heading {
    font-family: var(--serif, Georgia, serif);
    font-weight: 600;
    font-size: clamp(38px, 3.5vw, 48px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 22px 0 0;
    max-width: none;
  }
  .dl-hero-lead {
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.55;
    color: var(--ink-soft, #555);
    max-width: 52ch;
    margin: 18px 0 0;
  }
  .dl-mobile-notice {
    max-width: 42ch;
    margin: 18px 0 0;
    padding: 10px 14px;
    border: 1px solid var(--border, rgba(0, 0, 0, 0.12));
    border-radius: 10px;
    background: var(--surface, rgba(255, 255, 255, 0.65));
    color: var(--ink-soft, #555);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .dl-hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
  }
  .dl-hero-cta {
    min-height: 60px;
    padding: 12px 24px 12px 12px;
    gap: 11px;
    font-size: 16px;
    box-shadow:
      0 0 0 1px var(--ink),
      5px 5px 0 var(--coral),
      0 20px 34px -20px rgba(38, 38, 38, 0.52);
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }
  .dl-hero-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow:
      0 0 0 1px var(--ink),
      7px 7px 0 var(--coral),
      0 22px 36px -20px rgba(38, 38, 38, 0.54);
  }
  .dl-hero-cta:active {
    transform: translate(1px, 1px) scale(0.985);
    box-shadow:
      0 0 0 1px var(--ink),
      3px 3px 0 var(--coral),
      0 14px 24px -18px rgba(38, 38, 38, 0.46);
  }
