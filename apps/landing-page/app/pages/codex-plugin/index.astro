---
/*
 * /codex-plugin/ - standalone landing page for the public
 * nexu-io/open-design-agent-plugins repository.
 *
 * English is the authoritative source. Complete translated copy for every
 * active landing locale lives in `open-design-plugin-locales/`.
 */
import Layout from '../../_components/sub-page-layout.astro';
import LazyImg from '../../_components/lazy-img.astro';
import { getLocaleDefinition, localeFromPath, localizedHref } from '../../i18n';
import { getOpenDesignPluginCopy } from '../../open-design-plugin-i18n';
import '../../open-design-pugin.css';

const SITE = Astro.site?.toString() ?? 'https://open-design.ai/';
const locale = localeFromPath(Astro.url.pathname);
const localeDefinition = getLocaleDefinition(locale);
const href = (path: string) => localizedHref(path, locale);
const copy = getOpenDesignPluginCopy(locale);
const PAGE_URL = new URL(Astro.url.pathname, SITE).toString();
const REPO = 'https://github.com/nexu-io/open-design-agent-plugins';
const AGENT_INSTALL_GUIDE = `${REPO}/blob/main/AGENTS.md`;
const DOWNLOAD = href('/download/');
const INSTALL_INSTRUCTION =
  '/goal Read https://open-design.ai/codex-plugin/ to install OpenDesign for Codex and set up a new task for me.';
const codexRunFrames = [
  {
    src: '/open-design-pugin/codex-real-plugin-detail.png',
    width: 895,
    height: 580,
    displayWidth: 820,
  },
  {
    src: '/open-design-pugin/codex-real-cafe-prompt.png',
    width: 384,
    height: 271,
    displayWidth: 360,
  },
  {
    src: '/open-design-pugin/codex-real-cafe-running.png',
    width: 1676,
    height: 1075,
    displayWidth: 1080,
  },
  {
    src: '/open-design-pugin/codex-real-cafe-result.png',
    width: 1682,
    height: 1070,
    displayWidth: 1080,
  },
] as const;

const promptExamples = [
  {
    prompt:
      '@open-design Create a tactile product launch page for Oryzo, a sustainable rice-husk material. Use a cutting-mat grid, cork-toned product photography, oversized typography, technical labels, and a warm editorial layout.',
  },
  {
    prompt:
      '@open-design Create an event landing page for OpenDesign Osaka. Lead with a typographic map of Japan, restrained ivory and olive colors, the date and location, speaker details, and a clear registration action.',
  },
  {
    prompt:
      '@open-design Create a dark editorial website for Fable 5. Use a near-black canvas, small navigation, a bold serif headline, restrained white typography, and subtle interactive controls.',
  },
  {
    prompt:
      '@open-design Create an interactive release story for OpenDesign 0.9.0. Visualize a model timeline on a bright canvas with floating cards, connecting lines, color-coded labels, and responsive horizontal exploration.',
  },
] as const;

const templateExamples = [
  {
    src: '/showcase/oryzo-replica.jpg',
    width: 1200,
    height: 750,
  },
  {
    src: '/showcase/event-osaka.jpg',
    width: 1200,
    height: 676,
  },
  {
    src: '/showcase/fable5-site.jpg',
    width: 1200,
    height: 750,
  },
  {
    src: '/showcase/launch-0-9-0.jpg',
    width: 1200,
    height: 676,
  },
] as const;

const runFrames = codexRunFrames.map((frame, index) => ({
  ...frame,
  ...copy.demo.steps[index]!,
}));
const localizedTemplateExamples = templateExamples.map((example, index) => ({
  ...example,
  ...copy.use.templates[index]!,
  prompt: promptExamples[index]!.prompt,
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: copy.schema.pageName,
    description: copy.metadata.description,
    url: PAGE_URL,
    inLanguage: localeDefinition.htmlLang,
    isPartOf: { '@type': 'WebSite', name: 'OpenDesign', url: new URL(href('/'), SITE).toString() },
    about: {
      '@type': 'SoftwareApplication',
      name: copy.schema.applicationName,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'macOS, Windows',
      inLanguage: localeDefinition.htmlLang,
      url: PAGE_URL,
      sameAs: REPO,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: localeDefinition.htmlLang,
    mainEntity: copy.faq.items.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<Layout
  title={copy.metadata.title}
  description={copy.metadata.description}
  active="open-design-plugin"
  jsonLd={jsonLd}
  keywords={copy.metadata.keywords}
  mainClassName="sub-main odp-page"
>
  <section class="odp-hero" aria-labelledby="odp-title">
    <div class="odp-wrap odp-hero-layout">
      <div class="odp-hero-copy">
        <h1 id="odp-title">{copy.hero.title}</h1>
        <p class="odp-hero-lead">
          {copy.hero.leadBefore}
          <span class="odp-chatgpt-label">
            <img src="/agents/openai.svg" alt="" width="22" height="22" />
            {copy.hero.chatgptLabel}
          </span>
        </p>
      </div>

      <div class="odp-install-cluster">
        <div class="odp-command-card" aria-label={copy.hero.installAria}>
          <pre><code id="odp-install-instruction">{INSTALL_INSTRUCTION}</code></pre>
        </div>

        <div class="odp-install-actions">
          <button
            class="btn btn-primary odp-install-copy"
            type="button"
            data-copy-target="#odp-install-instruction"
            data-idle-label={copy.hero.copy}
            data-copying-label={copy.clipboard.copying}
            data-copied-label={copy.clipboard.copied}
            data-failed-label={copy.clipboard.failed}
            aria-live="polite"
          >
            {copy.hero.copy}
          </button>

          <a
            class="odp-github-link"
            href={AGENT_INSTALL_GUIDE}
            target="_blank"
            rel="noreferrer noopener"
          >
            {copy.hero.github}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="odp-demo" aria-labelledby="odp-demo-title">
    <div class="odp-wrap">
      <div class="odp-section-intro">
        <h2 id="odp-demo-title">{copy.demo.title}</h2>
        <p>{copy.demo.lead}</p>
      </div>

      <figure class="odp-flow-overview">
        <img
          src="/open-design-pugin/codex-real-workspace-overview.webp"
          alt={copy.demo.overviewAlt}
          width="1936"
          height="1082"
          loading="eager"
        />
        <figcaption>
          <span>{copy.demo.overviewLabel}</span>
          {copy.demo.overviewCaption}
        </figcaption>
      </figure>

      <div class="odp-run-detail">
        <ol class="odp-run-list" aria-label={copy.demo.stepListAria}>
          <li style="--odp-step-media-width: 820px">
            <div class="odp-run-copy">
              <p class="odp-run-kicker">
                <span>01</span>
                {copy.demo.installPhase}
              </p>
              <h3>{copy.demo.installTitle}</h3>
              <p>{copy.demo.installBody}</p>
            </div>
            <div class="odp-step-command" aria-label={copy.demo.installTitle}>
              <pre><code>{INSTALL_INSTRUCTION}</code></pre>
              <div class="odp-step-command-footer">
                <p>{copy.demo.installNote}</p>
                <button
                  type="button"
                  data-copy-text={INSTALL_INSTRUCTION}
                  data-idle-label={copy.hero.copy}
                  data-copying-label={copy.clipboard.copying}
                  data-copied-label={copy.clipboard.copied}
                  data-failed-label={copy.clipboard.failed}
                  aria-live="polite"
                >
                  {copy.hero.copy}
                </button>
              </div>
            </div>
          </li>
          {runFrames.map((frame, index) => (
            <li style={`--odp-step-media-width: ${frame.displayWidth}px`}>
              <div class="odp-run-copy">
                <p class="odp-run-kicker">
                  <span>{String(index + 2).padStart(2, '0')}</span>
                  {frame.phase}
                </p>
                <h3>{frame.title}</h3>
                <p>{frame.body}</p>
              </div>
              <figure class="odp-run-media">
                <img
                  src={frame.src}
                  alt={frame.alt}
                  width={frame.width}
                  height={frame.height}
                  loading="lazy"
                />
              </figure>
            </li>
          ))}
        </ol>

      </div>
    </div>
  </section>

  <section class="odp-use" aria-labelledby="odp-use-title">
    <div class="odp-wrap">
      <div class="odp-section-intro">
        <h2 id="odp-use-title">{copy.use.title}</h2>
        <p>{copy.use.lead}</p>
      </div>

      <div class="odp-example-grid" aria-label={copy.use.galleryAria}>
        {localizedTemplateExamples.map((example) => (
          <article class="odp-example-card">
            <figure>
              <LazyImg
                src={example.src}
                alt={example.alt}
                width={example.width}
                height={example.height}
              />
            </figure>
            <div class="odp-example-copy">
              <h3>{example.label}</h3>
              <code>{example.prompt}</code>
            </div>
            <button
              type="button"
              data-copy-text={example.prompt}
              data-idle-label={copy.use.copyPrompt}
              data-copying-label={copy.clipboard.copying}
              data-copied-label={copy.clipboard.copied}
              data-failed-label={copy.clipboard.failed}
              aria-live="polite"
            >
              {copy.use.copyPrompt}
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="odp-faq" aria-labelledby="odp-faq-title">
    <div class="odp-wrap odp-faq-grid">
      <div>
        <h2 id="odp-faq-title">{copy.faq.title}</h2>
        <p>{copy.faq.lead}</p>
      </div>
      <ol class="odp-faq-list">
        {copy.faq.items.map(({ q, a }) => (
          <li>
            <details>
              <summary>
                <span>{q}</span>
                <span class="odp-faq-toggle" aria-hidden="true">+</span>
              </summary>
              <p>{a}</p>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="odp-final" aria-label={copy.final.aria}>
    <div class="odp-wrap">
      <div class="odp-final-panel">
        <div>
          <h2>{copy.final.title}</h2>
          <p>{copy.final.bodyBeforeMention} <code>@open-design</code>{copy.final.bodyAfterMention}</p>
        </div>
        <div class="odp-final-actions">
          <button
            type="button"
            data-copy-text={INSTALL_INSTRUCTION}
            data-idle-label={copy.final.copy}
            data-copying-label={copy.clipboard.copying}
            data-copied-label={copy.clipboard.copied}
            data-failed-label={copy.clipboard.failed}
            aria-live="polite"
          >
            {copy.final.copy}
          </button>
          <a href={DOWNLOAD}>{copy.final.download}</a>
          <a href={REPO} target="_blank" rel="noreferrer noopener">{copy.final.source}</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const setCopyState = async (button, text) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const idleLabel = button.dataset.idleLabel || button.textContent || 'Copy';
      const copyingLabel = button.dataset.copyingLabel || 'Copying…';
      const copiedLabel = button.dataset.copiedLabel || 'Copied';
      const failedLabel = button.dataset.failedLabel || 'Select and copy';
      button.disabled = true;
      button.textContent = copyingLabel;

      try {
        await navigator.clipboard.writeText(text.trim());
        button.textContent = copiedLabel;
      } catch {
        button.textContent = failedLabel;
      }

      window.setTimeout(() => {
        button.disabled = false;
        button.textContent = idleLabel;
      }, 1800);
    };

    document.querySelectorAll('[data-copy-target]').forEach((candidate) => {
      if (!(candidate instanceof HTMLButtonElement)) return;
      const selector = candidate.dataset.copyTarget;
      const target = selector ? document.querySelector(selector) : null;
      if (!target) return;
      candidate.addEventListener('click', () => setCopyState(candidate, target.textContent || ''));
    });

    document.querySelectorAll('[data-copy-text]').forEach((candidate) => {
      if (!(candidate instanceof HTMLButtonElement)) return;
      candidate.addEventListener('click', () => setCopyState(candidate, candidate.dataset.copyText || ''));
    });
  </script>
</Layout>
