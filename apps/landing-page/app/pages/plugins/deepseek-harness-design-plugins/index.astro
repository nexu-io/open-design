---
/*
 * /plugins/deepseek-harness-design-plugins/ — curated "DeepSeek Harness design"
 * collection.
 *
 * Sibling board to /plugins/codex-design/: real, external plugins native to
 * DeepSeek Harness that give the text-only agent vision input, design
 * canvases, generative UI and design-workflow tools.
 *
 * Layout and chrome come from the shared `curated-collection-hub.astro`;
 * content from `_lib/deepseek-design.ts` via `DEEPSEEK_BINDING`.
 */
import CuratedCollectionHub from '../../../_components/curated-collection-hub.astro';
import { DEEPSEEK_BINDING } from '../../../_lib/deepseek-binding';
import { DEEPSEEK_SKILLS } from '../../../_lib/deepseek-design';
import { CODEX_SKILLS } from '../../../_lib/codex-design';
import { assertNoCuratedSlugCollision } from '../../../_lib/curated-collection';
import { getDetailPlugins } from '../../../_lib/bundled-plugins';

// Fails the build if a bundled plugin or the sibling curated collection ever
// claims one of the flat `/plugins/<slug>/` routes these curated plugins occupy.
assertNoCuratedSlugCollision('DeepSeek Harness design', DEEPSEEK_SKILLS, [
  ...getDetailPlugins().map((p) => p.detailSlug),
  ...CODEX_SKILLS.map((s) => s.slug),
]);
---

<CuratedCollectionHub binding={DEEPSEEK_BINDING} />
