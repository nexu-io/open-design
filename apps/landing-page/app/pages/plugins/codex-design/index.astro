---
/*
 * /plugins/codex-design/ — curated "Codex design" collection.
 *
 * A standalone editorial board (NOT bundled-plugin driven) of the best real,
 * external skills for doing design with OpenAI Codex (openai/skills,
 * MengTo/Skills, etc.). Positions Open Design as the home for designing with
 * Codex and drives to the client download + the codex-design list.
 *
 * Layout and chrome come from the shared `curated-collection-hub.astro`;
 * content from `_lib/codex-design.ts` via `CODEX_BINDING`.
 */
import CuratedCollectionHub from '../../../_components/curated-collection-hub.astro';
import { CODEX_BINDING } from '../../../_lib/codex-binding';
import { CODEX_SKILLS } from '../../../_lib/codex-design';
import { DEEPSEEK_SKILLS } from '../../../_lib/deepseek-design';
import { assertNoCuratedSlugCollision } from '../../../_lib/curated-collection';
import { getDetailPlugins } from '../../../_lib/bundled-plugins';

// Fails the build if a bundled plugin or the sibling curated collection ever
// claims one of the flat `/plugins/<slug>/` routes these curated skills occupy.
assertNoCuratedSlugCollision('Codex design', CODEX_SKILLS, [
  ...getDetailPlugins().map((p) => p.detailSlug),
  ...DEEPSEEK_SKILLS.map((s) => s.slug),
]);
---

<CuratedCollectionHub binding={CODEX_BINDING} />
