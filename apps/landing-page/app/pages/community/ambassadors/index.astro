---
/*
 * /community/ambassadors/ — program overview + ambassador roster.
 * Localized Astro route; see `../index.astro` for the migration note.
 */
import Layout from '../../../_components/sub-page-layout.astro';
import '../../../community.css';
import { localeFromPath, localizedHref } from '../../../i18n';
import {
  getCommunityCopy,
  COMMUNITY_LINKS,
  AMBASSADORS,
  GLYPH,
} from '../../../community-i18n';
import { STORY_CARD as CATMAN_CARD } from '../../../_partials/ambassador-catman-i18n';
import { STORY_CARD as JOSH_CARD } from '../../../_partials/ambassador-josh-i18n';
import { STORY_CARD as HEATHERM_CARD } from '../../../_partials/ambassador-heatherm-i18n';

const locale = localeFromPath(Astro.url.pathname);
const copy = getCommunityCopy(locale).ambassadors;
const href = (path: string) => localizedHref(path, locale);
const catmanCard = CATMAN_CARD[locale] ?? CATMAN_CARD.en!;
const joshCard = JOSH_CARD[locale] ?? JOSH_CARD.en!;
const heathermCard = HEATHERM_CARD[locale] ?? HEATHERM_CARD.en!;
const storyUi = locale === 'zh'
  ? {
      kicker: '大使故事',
      h2: '他们如何与 OpenDesign <em>结缘并付诸行动</em>。',
      intro: '认识每位大使的背景、与 OpenDesign 的连接，以及他们已经为本地社区做过的事情。',
    }
  : {
      kicker: 'Ambassador stories',
      h2: 'How they found OpenDesign&mdash;and <em>what they did next</em>.',
      intro: 'Meet the people behind the title: their background, their connection to OpenDesign, and the contribution they have already made.',
    };
const ambassadorStories = [
  {
    slug: 'catman',
    name: 'CATMAN',
    place: locale === 'zh' ? '日本' : 'Japan',
    avatar: '/stories/osaka-kyoto-catman-from-group.jpg',
    title: catmanCard.title,
    blurb: catmanCard.blurb,
  },
  {
    slug: 'josh',
    name: 'Josh',
    place: locale === 'zh' ? '澳大利亚' : 'Australia',
    avatar: '/community/ambassadors/assets/josh.jpg',
    title: joshCard.title,
    blurb: joshCard.blurb,
  },
  {
    slug: 'heatherm-huang',
    name: 'Heatherm Huang',
    place: locale === 'zh' ? '香港' : 'Hong Kong',
    avatar: '/community/ambassadors/assets/heatherm-huang.jpg',
    title: heathermCard.title,
    blurb: heathermCard.blurb,
  },
];
const roster = AMBASSADORS.map((amb, i) => ({
  ...amb,
  name: locale === 'zh' ? (amb.nameZh ?? amb.name) : amb.name,
  place: copy.roster.places[i] ?? (locale === 'zh' ? amb.placeZh : amb.place),
  storyHref: amb.storySlug ? href('/community/ambassadors/' + amb.storySlug + '/') : undefined,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.title,
  description: copy.desc,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Layout title={copy.title} description={copy.desc} active="community" jsonLd={jsonLd} mainClassName="sub-main">
  <div class="od-community">
    <section class="hero">
      <div class="hero-decor"></div>
      <div class="wrap">
        <div class="hero-copy">
          <h1 class="h-display" set:html={copy.heroTitle} />
          <p class="lead">{copy.heroLead}</p>
        </div>
      </div>
    </section>

    <section class="section ambassadors" id="ambassadors">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker"><span class="dot"></span>{copy.program.kicker}</span>
            <h2 class="h-display" set:html={copy.program.h2} />
          </div>
          <div class="right amb-side">
            <a class="btn btn-coral amb-apply" href={COMMUNITY_LINKS.ambassadorForm} target="_blank" rel="noopener">
              <span class="ri" aria-hidden="true">{GLYPH.discord}</span>
              {copy.program.applyCta}
              <span class="ri" aria-hidden="true">{GLYPH.arrow}</span>
            </a>
            <p>{copy.program.applyNote}</p>
          </div>
        </div>

        <div class="amb-grid">
          {copy.program.cols.map((col) => (
            <div class="amb-col">
              <div class="n">{col.n}</div>
              <h3 set:html={col.h3} />
              <p class="lede">{col.lede}</p>
              <ul>
                {col.items.map((item) => (
                  <li>
                    <span class="ic ri" aria-hidden="true">{GLYPH.check}</span>
                    <span set:html={item} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section ambassador-stories" id="stories">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker"><span class="dot"></span>{storyUi.kicker}</span>
            <h2 class="h-display" set:html={storyUi.h2} />
          </div>
          <p class="right">{storyUi.intro}</p>
        </div>

        <div class="ambassador-story-cards">
          {ambassadorStories.map((story) => (
            <a class="ambassador-story-card" href={href('/community/ambassadors/' + story.slug + '/')}>
              <div class="ambassador-story-portrait">
                <img src={story.avatar} alt={story.name} loading="lazy" />
                <span>{story.place}</span>
              </div>
              <div class="ambassador-story-copy">
                <p class="ambassador-story-name">{story.name}</p>
                <h3>{story.title}</h3>
                <p>{story.blurb}</p>
                <span class="ambassador-story-read">{copy.roster.storyCta}<span class="ri" aria-hidden="true">{GLYPH.arrow}</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section ambassador-roster" id="roster">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="kicker"><span class="dot"></span>{copy.roster.kicker}</span>
            <h2 class="h-display" set:html={copy.roster.h2} />
          </div>
          <p class="right">{copy.roster.intro}</p>
        </div>

        <div class="ambassador-cards">
          {roster.map((amb) => (
            <article class="ambassador-card">
              {amb.storyHref ? (
                <a class:list={['ambassador-avatar', 'ambassador-avatar-link', { 'ambassador-avatar-placeholder': !amb.avatar }]} href={amb.storyHref} aria-label={copy.roster.storyCta + ': ' + amb.name}>
                  {amb.avatar
                    ? <img src={amb.avatar} alt={amb.avatarAlt ?? amb.name} loading="lazy" />
                    : <span class="ambassador-initials" aria-hidden="true">{amb.initials ?? amb.name.slice(0, 2)}</span>}
                </a>
              ) : (
                <div class:list={['ambassador-avatar', { 'ambassador-avatar-placeholder': !amb.avatar }]}>
                  {amb.avatar
                    ? <img src={amb.avatar} alt={amb.avatarAlt ?? amb.name} loading="lazy" />
                    : <span class="ambassador-initials" aria-hidden="true">{amb.initials ?? amb.name.slice(0, 2)}</span>}
                </div>
              )}
              <div class="ambassador-identity">
                <h3>{amb.storyHref ? <a href={amb.storyHref}>{amb.name}</a> : amb.name}</h3>
                <p class="ambassador-place">{amb.place}</p>
              </div>
              <div class={amb.socials.length || amb.storyHref ? 'ambassador-links' : 'ambassador-links ambassador-links-empty'}>
                {amb.storyHref && (
                  <a class="ambassador-story-cta" href={amb.storyHref}>
                    {copy.roster.storyCta}
                    <span class="ri" aria-hidden="true">{GLYPH.arrow}</span>
                  </a>
                )}
                {amb.socials.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.type}>
                    <span class="ri" aria-hidden="true">{s.glyph}</span>
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
