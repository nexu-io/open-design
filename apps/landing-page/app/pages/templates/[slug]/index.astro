---
import Layout from '../../../_components/sub-page-layout.astro';
import TemplateCard from '../../../_components/template-card.astro';
import { resolveBundledTitle } from '../../../_lib/bundled-plugins';
import { getPluginsCopy } from '../../../_lib/plugins-i18n';
import {
  getPluginsForTemplateUseCase,
  getTemplateUseCaseCopy,
  getTemplateUseCases,
  type TemplateUseCase,
} from '../../../_lib/template-use-cases';
import { localeFromPath, localizedHref } from '../../../i18n';

export function getStaticPaths() {
  return getTemplateUseCases().map((useCase) => ({
    params: { slug: useCase.slug },
    props: { useCase },
  }));
}

interface Props {
  useCase: TemplateUseCase;
}

const SITE = Astro.site?.toString() ?? 'https://open-design.ai/';
const { useCase } = Astro.props as Props;
const locale = localeFromPath(Astro.url.pathname);
const href = (path: string) => localizedHref(path, locale);
const pcopy = getPluginsCopy(locale);
const copy = getTemplateUseCaseCopy(useCase, locale);
const plugins = getPluginsForTemplateUseCase(useCase);
const relatedUseCases = getTemplateUseCases()
  .filter((item) => item.slug !== useCase.slug)
  .slice(0, 6);
const isZh = locale === 'zh' || locale === 'zh-tw';
const starterNames = plugins
  .slice(0, 3)
  .map((plugin) => resolveBundledTitle(plugin, locale));
const starterText = starterNames.join(isZh ? '、' : ', ');
const primaryQuery = useCase.keywords[0] ?? copy.title;
const secondaryQueries = useCase.keywords.slice(1, 3).join(isZh ? '、' : ', ');
const useCaseTopic = isZh ? copy.title.replace(/模板$/, '') : primaryQuery;
const zhDescription = copy.description.replace(/。$/, '');
const searchIntents = useCase.searchIntents?.map((intent) => ({
  label: isZh ? (intent.zh?.label ?? intent.label) : intent.label,
  description: isZh ? (intent.zh?.description ?? intent.description) : intent.description,
})) ?? useCase.keywords.map((keyword) => ({
  label: keyword,
  description: isZh
    ? '这是这个专题覆盖的搜索入口之一，下面的模板可以作为起点继续改成真实项目。'
    : 'One of the search intents covered by this collection; the templates below are starting points for real projects.',
}));
const queryFaq = [
  {
    question: isZh
      ? `我要做${useCaseTopic}，应该从哪个模板开始？`
      : `I need a ${primaryQuery}. Which template should I start with?`,
    answer: isZh
      ? `先看 ${starterText}。这几个模板覆盖了这个场景里最常见的起步方式：一个负责主叙事，一个负责更强的视觉风格，一个可以作为社交或补充物料。点进卡片后可以直接看预览、来源和 GitHub 代码，再把文案、图片、品牌色换成你的真实内容。`
      : `Start with ${starterText}. They cover the common starting points for this use case: one strong narrative artifact, one sharper visual direction, and one supporting social or companion asset. Open any card to inspect the preview, attribution, and GitHub source before swapping in your real copy, images, and brand system.`,
  },
  {
    question: isZh
      ? `这个页面适合哪些真实项目，而不只是“模板展示”？`
      : `What real projects does this page fit, beyond browsing templates?`,
    answer: isZh
      ? `${zhDescription}，实际上可以落到这些项目：客户提案、活动媒体包、发布前预览、创始人/品牌故事、内部汇报，或者给设计代理商快速出第一版方向。这里的模板会比全量插件列表更快把你带到能直接改的成品。`
      : `${copy.description} In practice, this can become a client proposal, event media kit, pre-launch preview, founder or brand story, internal review, or a first design direction for an agency workflow. If you searched for ${secondaryQueries || primaryQuery}, this page should get you to something editable faster than the full plugin catalog.`,
  },
  {
    question: isZh
      ? `我已经有自己的内容了，怎么把这些模板改成可发布版本？`
      : `I already have my own content. How do I turn these into something publishable?`,
    answer: isZh
      ? `先选一个最接近目标气质的模板，再保留它的版式节奏和组件结构，只替换标题、正文、图片、数据和 CTA。模板详情页会保留品牌/来源归因和 GitHub 链接，所以你可以从原始实现继续改，而不是只拿一张静态截图。`
      : `Pick the template closest to the tone you want, keep its layout rhythm and component structure, then replace the headlines, body copy, imagery, data, and calls to action. The detail page keeps brand/source attribution and the GitHub link, so you can keep editing from the original implementation rather than copying a static screenshot.`,
  },
];
const faqItems = [...queryFaq, ...useCase.faq];

const title = `${copy.title} · Open Design templates`;
const description = copy.description;
const pageUrl = new URL(href(`/templates/${useCase.slug}/`), SITE).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Open Design', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Templates', item: new URL(href('/templates/'), SITE).toString() },
      { '@type': 'ListItem', position: 3, name: copy.title, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: copy.title,
    description,
    url: pageUrl,
    keywords: useCase.keywords.join(', '),
    numberOfItems: plugins.length,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: plugins.map((plugin, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: resolveBundledTitle(plugin, locale),
        url: new URL(href(plugin.detailHref), SITE).toString(),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];
---

<Layout title={title} description={description} active="plugins" jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label={pcopy.breadcrumbLabel}>
    <a href={href('/')}>Open Design</a>
    <span>/</span>
    <a href={href('/templates/')}>{isZh ? '模板场景' : 'Templates'}</a>
    <span>/</span>
    <span aria-current="page">{copy.title}</span>
  </nav>

  <header class="catalog-head template-usecase-detail-head">
    <span class="label">{copy.eyebrow}</span>
    <h1 class="display">{copy.title}<span class="dot">.</span></h1>
    <p class="lead">{copy.description}</p>
    <p class="template-usecase-intro">{copy.intro}</p>
    <div class="template-usecase-actions">
      <a class="btn btn-primary" href="#templates">{copy.ctaLabel}</a>
      <a class="btn btn-ghost" href={href('/plugins/templates/')}>{pcopy.tileTemplates}</a>
    </div>
  </header>

  <section class="template-usecase-intents" aria-label="Search intents">
    <div class="template-usecase-section-head">
      <span>{isZh ? '适合这些场景' : 'Useful for'}</span>
      <h2>{isZh ? '这些不是关键词，是可以落地的任务' : 'Search intents that map to real work'}</h2>
    </div>
    <div class="template-usecase-intent-list">
      {searchIntents.map((intent) => (
        <a href="#templates" class="template-usecase-intent-card">
          <strong>{intent.label}</strong>
          <span>{intent.description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="template-usecase-keywords" aria-label="SEO keyword coverage">
    <span>{isZh ? '覆盖搜索词' : 'Keyword coverage'}</span>
    {useCase.keywords.map((keyword) => (
      <code>{keyword}</code>
    ))}
  </section>

  <section id="templates" class="tpl-grid template-usecase-template-grid" aria-label={copy.title}>
    {plugins.map((plugin, idx) => (
      <TemplateCard record={plugin} index={idx} />
    ))}
  </section>

  <section class="template-usecase-faq" aria-label="Search Q&A">
    <h2>{isZh ? '搜索问题' : 'Search Q&A'}</h2>
    <div class="template-usecase-faq-list">
      {queryFaq.map((item) => (
        <details class="template-usecase-faq-item" open>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="template-usecase-faq" aria-label="FAQ">
    <h2>{isZh ? '常见问题' : 'FAQ'}</h2>
    <div class="template-usecase-faq-list">
      {useCase.faq.map((item) => (
        <details class="template-usecase-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="template-usecase-related" aria-label="Related template use cases">
    <h2>{isZh ? '相关模板场景' : 'Related template use cases'}</h2>
    <div class="template-usecase-related-list">
      {relatedUseCases.map((item) => {
        const relatedCopy = getTemplateUseCaseCopy(item, locale);
        return <a href={href(`/templates/${item.slug}/`)}>{relatedCopy.title}</a>;
      })}
    </div>
  </section>
</Layout>

<style>
  .template-usecase-detail-head {
    max-width: 940px;
  }

  .template-usecase-intro {
    max-width: 780px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .template-usecase-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .template-usecase-intents {
    margin: 42px 0 28px;
  }

  .template-usecase-section-head {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }

  .template-usecase-section-head span {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .template-usecase-section-head h2 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    line-height: 1.1;
  }

  .template-usecase-intent-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .template-usecase-intent-card {
    display: grid;
    gap: 10px;
    min-height: 168px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 18px;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
  }

  .template-usecase-intent-card:hover {
    border-color: var(--ink);
  }

  .template-usecase-intent-card strong {
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .template-usecase-intent-card span {
    color: var(--muted);
    line-height: 1.6;
  }

  .template-usecase-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 26px;
    color: var(--muted);
  }

  .template-usecase-keywords span,
  .template-usecase-keywords code {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 12px;
    background: var(--paper);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .template-usecase-keywords code {
    font-family: var(--mono);
  }

  .template-usecase-template-grid {
    margin-top: 20px;
  }

  .template-usecase-faq,
  .template-usecase-related {
    margin: 70px 0 0;
  }

  .template-usecase-faq h2,
  .template-usecase-related h2 {
    margin: 0 0 18px;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .template-usecase-faq-list {
    display: grid;
    gap: 12px;
  }

  .template-usecase-faq-item {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 18px 20px;
  }

  .template-usecase-faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .template-usecase-faq-item p {
    margin: 12px 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .template-usecase-related-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .template-usecase-related-list a {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 13px;
    color: var(--ink);
    text-decoration: none;
  }

  .template-usecase-related-list a:hover {
    border-color: var(--ink);
  }

  @media (max-width: 820px) {
    .template-usecase-intent-list {
      grid-template-columns: 1fr;
    }

    .template-usecase-intent-card {
      min-height: 0;
    }
  }
</style>
