---
/*
 * /pricing/ — subscription pricing page (localized).
 *
 * Card LAYOUT + COPY mirror the vela subscription modal (`pricing-plans.tsx`).
 * Plus/Pro/Max and Team NUMBERS come from `PRICING_SNAPSHOT` at build time.
 * Go's confirmed launch prices come from the colocated `GO_PLAN` source shared
 * with SEO and tests. The localized TEXT comes from
 * app/_lib/pricing-content.ts and app/_lib/pricing-team-content.ts.
 */
import Layout from '../../_components/sub-page-layout.astro';
import PricingIndividualPlans from '../../_components/pricing-individual-plans.astro';
import {
  CLOUD_CONSOLE_BASE_PARAM,
  CLOUD_CONSOLE_URL,
  DEFAULT_CLOUD_CONSOLE_BASE_URL,
  GO_PLAN,
  HOSTED_CLOUD_CONSOLE_DOMAINS,
  PRICING_SNAPSHOT,
  cloudSubscribeUrl,
  formatUsd,
  teamIntroTotalUsd,
  type PlanTierConfig,
  type TeamPlanTierConfig,
} from '../../_lib/pricing';
import {
  getPricingPlanActionLabels,
  getPricingContent,
  fillTemplate,
} from '../../_lib/pricing-content';
import { getTeamPricingContent } from '../../_lib/pricing-team-content';
import EnterpriseLeadForm from '../../_components/enterprise-lead-form.astro';
import {
  getFaqs,
  getFaqTitle,
  getEnterprise,
} from '../../_lib/pricing-extras-content';
import { localeFromPath, localizedHref } from '../../i18n';
import { DEEPSEEK_V4_PRO_CAMPAIGN } from '../../_lib/deepseek-v4-pro-campaign';
import { getPricingCampaignContent } from '../../_lib/pricing-campaign-content';

const locale = localeFromPath(Astro.url.pathname);
const isZh = locale === 'zh' || locale === 'zh-tw';
const href = (path: string) => localizedHref(path, locale);
const content = getPricingContent(locale);
const planActionLabels = getPricingPlanActionLabels(locale);
const teamContent = getTeamPricingContent(locale);
const L = content.labels;
const env = import.meta.env as Record<string, string | undefined>;
const apiOrigin =
  env.PUBLIC_CLOUD_API_BASE ??
  env.PUBLIC_AMR_API_BASE ??
  'https://amr-api.open-design.ai';

// Footer line with the cloud-console link injected into the localized
// template. Brand/marker only — safe to render as HTML; the validated URL is
// attached in the handoff script below.
const footnoteHtml = fillTemplate(L.footnote, {
  console: `<a class="inline-link" data-cloud-console-link>${L.consoleLabel}</a>`,
});

const faqs = getFaqs(locale);
const faqTitle = getFaqTitle(locale);
const enterprise = getEnterprise(locale);
const LF = enterprise.leadForm;

const SITE = Astro.site?.toString() ?? 'https://open-design.ai/';
const title = teamContent.metaTitle;
const description = teamContent.metaDescription;
const usd = formatUsd;

const tiers: PlanTierConfig[] = PRICING_SNAPSHOT.tiers;
const teamTiers: TeamPlanTierConfig[] = PRICING_SNAPSHOT.teamTiers;
const initialTeamTier = teamTiers.find((tier) => tier.recommended) ?? teamTiers[0]!;
const initialTeamSeats = initialTeamTier.minSeats;

function teamTierLabel(tier: TeamPlanTierConfig): string {
  return tier.tier
    .replace(/^team_/, 'Team ')
    .replace(/\b\w/g, (character) => character.toUpperCase());
}

function teamCreditOption(tier: TeamPlanTierConfig): string {
  const credit = tier.monthlyCreditsPerSeatUsd;
  return `${teamTierLabel(tier).replace(/^Team /, '')}: ${
    credit === 0 ? teamContent.seatOnly : `${usd(credit)} ${teamContent.creditUnit}`
  }`;
}

function teamView(tier: TeamPlanTierConfig, interval: 'monthly' | 'yearly') {
  const selected = tier[interval];
  const months = interval === 'yearly' ? 12 : 1;
  const introSeatMonth = selected.introPriceUsd / months;
  const regularSeatMonth =
    interval === 'yearly' ? tier.monthly.priceUsd : selected.priceUsd;
  const discountPct = Math.round(
    (1 - introSeatMonth / regularSeatMonth) * 100,
  );
  const intervalTotal = teamIntroTotalUsd(tier, interval, initialTeamSeats);
  return {
    amount: usd(introSeatMonth),
    strike: usd(regularSeatMonth),
    discountPct,
    monthlyTeamTotal: usd(intervalTotal / months).replace(/^\$/, ''),
    intervalTotal: usd(intervalTotal).replace(/^\$/, ''),
  };
}

const initialTeamView = teamView(initialTeamTier, 'yearly');

const deepSeekCampaign = getPricingCampaignContent(locale);
const comingSoonLabel = L.comingSoon
  .trim()
  .replace(/^[（(]\s*/, '')
  .replace(/\s*[）)]$/, '');

const absUrl = (path: string) => new URL(href(path), SITE).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'OpenDesign', item: absUrl('/') },
      { '@type': 'ListItem', position: 2, name: teamContent.breadcrumbLabel, item: absUrl('/pricing/') },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'OpenDesign Subscription',
    description,
    offers: [
      {
        '@type': 'Offer',
        name: 'OpenDesign Go',
        price: String(GO_PLAN.monthly.priceUsd),
        priceCurrency: 'USD',
        url: cloudSubscribeUrl('go', 'monthly'),
      },
      ...tiers.map((t) => ({
        '@type': 'Offer',
        name: `OpenDesign ${t.tier}`,
        price: String(t.monthly.priceUsd),
        priceCurrency: 'USD',
        url: cloudSubscribeUrl(t.tier, 'monthly'),
      })),
      ...teamTiers.flatMap((t) => [
        {
          '@type': 'Offer',
          name: `OpenDesign ${teamTierLabel(t)} monthly`,
          price: String(t.monthly.priceUsd),
          priceCurrency: 'USD',
          url: CLOUD_CONSOLE_URL,
          eligibleQuantity: {
            '@type': 'QuantitativeValue',
            minValue: t.minSeats,
            unitText: 'seat',
          },
        },
        {
          '@type': 'Offer',
          name: `OpenDesign ${teamTierLabel(t)} yearly`,
          price: String(t.yearly.priceUsd),
          priceCurrency: 'USD',
          url: CLOUD_CONSOLE_URL,
          eligibleQuantity: {
            '@type': 'QuantitativeValue',
            minValue: t.minSeats,
            unitText: 'seat',
          },
        },
      ]),
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  active="pricing"
  jsonLd={jsonLd}
  showHeaderAccount
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={href('/')}>OpenDesign</a>
    <span>/</span>
    <span aria-current="page">{teamContent.breadcrumbLabel}</span>
  </nav>

  <article
    class="info-page pr-page"
    data-pricing-root
    data-pricing-locale={locale}
    data-audience="creator"
    data-interval="yearly"
    data-cloud-console-environment="production"
    data-billing-api-origin={apiOrigin}
    data-current-plan-label={planActionLabels.current}
    data-current-canceling-label={planActionLabels.currentCanceling}
    data-downgrade-plan-label={planActionLabels.downgrade}
    data-upgrade-plan-label={planActionLabels.upgrade}
    data-interval-upgrade-label={planActionLabels.intervalUpgrade}
    data-switch-back-interval-label={planActionLabels.switchBackToInterval}
    data-interval-downgrade-unavailable-label={planActionLabels.intervalDowngradeUnavailable}
    data-checkout-unavailable-label={planActionLabels.checkoutUnavailable}
    data-scheduled-plan-label={planActionLabels.scheduled}
    data-monthly-label={L.monthly}
    data-yearly-label={L.yearly}
    data-campaign-start-at={DEEPSEEK_V4_PRO_CAMPAIGN.startAt}
    data-campaign-end-at={DEEPSEEK_V4_PRO_CAMPAIGN.endAtExclusive}
  >
    <header class="pr-hero">
      <h1 class="pr-hero-heading">{isZh ? '零配置，只为结果付费' : locale === 'en' ? 'Zero setup. Pay only for results.' : L.heroTitle}</h1>
      <div class="pr-controls-row">
        <div class="pr-toggle" role="tablist" aria-label={teamContent.billingIntervalLabel}>
          <button type="button" class="pr-toggle-btn" role="tab" data-interval-btn="monthly" aria-selected="false">
            {L.monthly}
          </button>
          <button type="button" class="pr-toggle-btn is-active" role="tab" data-interval-btn="yearly" aria-selected="true">
            <span>{L.yearly}</span>
            <span class="pr-toggle-save">{L.yearlySave}</span>
          </button>
        </div>
        <div class="pr-audience-toggle" role="tablist" aria-label={teamContent.audienceTabsLabel}>
          <button
            id="pr-audience-creator"
            type="button"
            class="pr-audience-btn is-active"
            role="tab"
            data-audience-btn="creator"
            aria-controls="pr-creator-panel"
            aria-selected="true"
            tabindex="0"
          >
            {isZh ? '个人' : locale === 'en' ? 'Individual' : teamContent.creatorTab}
          </button>
          <span class="pr-audience-separator" aria-hidden="true">/</span>
          <button
            id="pr-audience-team"
            type="button"
            class="pr-audience-btn"
            role="tab"
            data-audience-btn="team"
            aria-controls="pr-team-panel"
            aria-selected="false"
            tabindex="-1"
          >
            {isZh ? '团队' : locale === 'en' ? 'Team' : teamContent.teamTab}
          </button>
        </div>
      </div>
    </header>
    <p class="pr-handoff-error" data-cloud-console-handoff-error role="alert" hidden>
      {L.checkoutDestinationUnavailable}
    </p>
    <p class="pr-subscription-status" data-personal-pricing-status role="status" hidden></p>

    <div
      id="pr-creator-panel"
      role="tabpanel"
      aria-labelledby="pr-audience-creator"
      data-audience-panel="creator"
    >
    <PricingIndividualPlans />
    <section class="pr-multimodal" aria-labelledby="pr-multimodal-title">
      <div class="pr-multimodal-copy">
        <span class="pr-multimodal-kicker">OpenDesign Cloud</span>
        <h2 id="pr-multimodal-title">{L.multimodalTitle}</h2>
        <p>{L.multimodalDescription}</p>
      </div>
      <div class="pr-multimodal-modes" aria-label={L.multimodalTitle}>
        <div class="pr-mode">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14M5 9h9M5 13h14M5 17h9" /></svg>
          <span class="pr-mode-copy">
            <small aria-hidden="true"></small>
            <strong>{L.designAgent}</strong>
          </span>
        </div>
        <div class="pr-mode">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="2" /><circle cx="9" cy="9" r="1.5" /><path d="m5.5 17 4-4 3 3 2-2 4 3" /></svg>
          <span class="pr-mode-copy">
            <small aria-hidden="true"></small>
            <strong>{L.imageGeneration}</strong>
          </span>
        </div>
        <div class="pr-mode is-soon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2" /><path d="m10 9 5 3-5 3Z" /></svg>
          <span class="pr-mode-copy">
            <small>{comingSoonLabel}</small>
            <strong>{L.videoGeneration}</strong>
          </span>
        </div>
      </div>
    </section>
    </div>

    <div
      id="pr-team-panel"
      class="pr-team-panel"
      role="tabpanel"
      aria-labelledby="pr-audience-team"
      data-audience-panel="team"
      hidden
    >
      <div class="pr-team-grid">
        <section class="pr-team-card" aria-labelledby="pr-team-title">
          <svg class="pr-team-decoration" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="9" cy="8" r="3" />
            <path d="M3.5 19c.35-3.45 2.1-5.2 5.5-5.2s5.15 1.75 5.5 5.2" />
            <circle cx="17.25" cy="9.25" r="2.25" />
            <path d="M15.3 14.7c3.2-.75 5.05.68 5.2 3.8" />
          </svg>
          <h2 id="pr-team-title" class="pr-team-card-title">{teamContent.teamTitle}</h2>
          <p class="pr-team-card-tagline">{teamContent.teamTagline}</p>

          <div class="pr-team-price-row">
            <strong class="pr-team-amount" data-team-amount>{initialTeamView.amount}</strong>
            <s class="pr-team-strike" data-team-strike>{initialTeamView.strike}</s>
            <span class="pr-team-per">{teamContent.perSeatMonth}</span>
            <span class="pr-team-discount" data-team-discount>
              {fillTemplate(L.yearlyDiscountTag, { pct: String(initialTeamView.discountPct) })}
            </span>
          </div>
          <div class="pr-team-price-summary" aria-live="polite">
            <p data-team-monthly-summary>
              {fillTemplate(teamContent.monthlyTotal, {
                amount: initialTeamView.monthlyTeamTotal,
              })}
            </p>
            <strong data-team-yearly-summary data-when="yearly">
              {fillTemplate(teamContent.yearlyTotal, {
                amount: initialTeamView.intervalTotal,
              })}
            </strong>
          </div>

          <div class="pr-team-controls">
            <div class="pr-team-field">
              <span id="pr-team-tier-label">{teamContent.creditLabel}</span>
              <div class="pr-team-select" data-team-tier-select>
                <button
                  type="button"
                  class="pr-team-select-trigger"
                  data-team-tier
                  data-value={initialTeamTier.tier}
                  role="combobox"
                  aria-labelledby="pr-team-tier-label pr-team-tier-value"
                  aria-controls="pr-team-tier-options"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <span id="pr-team-tier-value" data-team-tier-value>
                    {teamCreditOption(initialTeamTier)}
                  </span>
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    <path d="m6 8 4 4 4-4" />
                  </svg>
                </button>
                <ul
                  id="pr-team-tier-options"
                  class="pr-team-select-options"
                  data-team-tier-options
                  role="listbox"
                  aria-labelledby="pr-team-tier-label"
                  hidden
                >
                {teamTiers.map((tier) => (
                  <li
                    id={`pr-team-tier-${tier.tier}`}
                    class:list={[
                      'pr-team-select-option',
                      { 'is-selected': tier.tier === initialTeamTier.tier },
                    ]}
                    data-team-tier-option
                    data-value={tier.tier}
                    role="option"
                    aria-selected={tier.tier === initialTeamTier.tier ? 'true' : 'false'}
                    tabindex="-1"
                  >
                    <span>{teamCreditOption(tier)}</span>
                    <span class="pr-team-select-check" aria-hidden="true">✓</span>
                  </li>
                ))}
                </ul>
              </div>
            </div>

            <div class="pr-team-field">
              <span>{teamContent.seats}</span>
              <div class="pr-team-stepper">
                <button type="button" data-team-seats-dec aria-label={teamContent.decreaseSeats}>−</button>
                <output data-team-seats>{initialTeamSeats}</output>
                <button type="button" data-team-seats-inc aria-label={teamContent.increaseSeats}>+</button>
              </div>
            </div>
          </div>
          <p class="pr-team-min-seats" data-team-min>
            {fillTemplate(teamContent.minSeatsNote, { count: String(initialTeamTier.minSeats) })}
          </p>

          <div class="pr-team-model-offer" data-pricing-campaign-surface hidden>
            <span class="pr-team-model-offer-copy">
              <strong>{deepSeekCampaign.teamOfferTitle}</strong>
              <small>{deepSeekCampaign.teamOfferModels}</small>
            </span>
            <span
              class="pr-team-offer-countdown"
              data-team-campaign-countdown
              aria-label={deepSeekCampaign.windowLabel}
            >
              <b data-team-countdown-days data-day-unit={deepSeekCampaign.dayUnit}>
                0{deepSeekCampaign.dayUnit}
              </b>
              <b data-team-countdown-hours>00</b>
              <i aria-hidden="true">:</i>
              <b data-team-countdown-minutes>00</b>
              <i aria-hidden="true">:</i>
              <b data-team-countdown-seconds>00</b>
            </span>
          </div>

          <ul class="pr-team-feature-list">
            {teamContent.teamFeatures.map((feature) => <li>{feature}</li>)}
          </ul>

          <a
            class="btn btn-primary pr-team-checkout"
            data-pricing-cta
            data-tier="team"
            data-team-checkout-total
          >
            {fillTemplate(teamContent.yearlyCheckout, { amount: initialTeamView.intervalTotal })}
          </a>
        </section>

        <section class="pr-team-card pr-enterprise-card" aria-labelledby="pr-enterprise-title">
          <svg class="pr-team-decoration" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 21V6.5L12 3v18" />
            <path d="M12 8h7v13" />
            <path d="M3 21h18" />
            <path d="M8 8.5h1M8 12h1M8 15.5h1M15 11h1M15 14h1" />
          </svg>
          <h2 id="pr-enterprise-title" class="pr-team-card-title">{teamContent.enterpriseTitle}</h2>
          <p class="pr-team-card-tagline">{teamContent.enterpriseTagline}</p>
          <ul class="pr-team-feature-list">
            {teamContent.enterpriseFeatures.map((feature) => <li>{feature}</li>)}
          </ul>
          <button
            type="button"
            class="btn btn-primary pr-team-checkout"
            data-open-lead-modal
          >
            {teamContent.enterpriseCta}
          </button>
        </section>
      </div>
    </div>

    <p class="pr-foot" set:html={footnoteHtml} />
    <p class="pr-campaign-disclaimer" data-pricing-campaign-surface hidden>{deepSeekCampaign.disclaimer}</p>
  </article>

  <section class="pr-faq" aria-label={faqTitle}>
    <h2 class="pr-faq-title">{faqTitle}</h2>
    <div class="pr-faq-list">
      {faqs.map((faq) => (
        <details class="pr-faq-item">
          <summary class="pr-faq-q">{faq.q}</summary>
          <div class="pr-faq-a">{faq.a}</div>
        </details>
      ))}
    </div>
  </section>

  {/* Enterprise lead-capture modal — opened by the Enterprise card CTA.
      Renders the SAME shared lead form as /enterprise
      (fields, required rules, options, validation, /contact-sales contract),
      so the two funnels can never drift; only `source` differs for lead
      attribution. */}
  <div class="pr-modal" data-lead-modal hidden aria-hidden="true">
    <div class="pr-modal-backdrop" data-lead-close></div>
    <div class="pr-modal-card" role="dialog" aria-modal="true" aria-labelledby="ent-form-heading">
      <button type="button" class="pr-modal-x" data-lead-close aria-label={LF.close}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <EnterpriseLeadForm locale={locale} source="pricing_team" pageName="pricing" />
    </div>
  </div>

  <script is:inline define:vars={{ labels: L, defaultCloudConsoleBase: DEFAULT_CLOUD_CONSOLE_BASE_URL, hostedCloudConsoleDomains: HOSTED_CLOUD_CONSOLE_DOMAINS, cloudConsoleBaseParam: CLOUD_CONSOLE_BASE_PARAM, teamTiers, teamCopy: teamContent }}>
    (() => {
      const root = document.querySelector('[data-pricing-root]');
      if (!root) return;

      const campaignSurfaces = root.querySelectorAll('[data-pricing-campaign-surface]');
      const campaignStartAt = Date.parse(root.getAttribute('data-campaign-start-at') || '');
      const campaignEndAt = Date.parse(root.getAttribute('data-campaign-end-at') || '');
      const teamCampaignCountdown = root.querySelector('[data-team-campaign-countdown]');
      const teamCountdownDays = root.querySelector('[data-team-countdown-days]');
      const teamCountdownHours = root.querySelector('[data-team-countdown-hours]');
      const teamCountdownMinutes = root.querySelector('[data-team-countdown-minutes]');
      const teamCountdownSeconds = root.querySelector('[data-team-countdown-seconds]');
      let campaignEligible = false;
      let campaignVisible = false;
      const updateTeamCampaignCountdown = (now) => {
        if (!teamCampaignCountdown) return;
        const remaining = Math.max(0, campaignEndAt - now);
        const totalSeconds = Math.floor(remaining / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        if (teamCountdownDays) {
          teamCountdownDays.textContent = `${days}${teamCountdownDays.getAttribute('data-day-unit') || ''}`;
        }
        if (teamCountdownHours) teamCountdownHours.textContent = String(hours).padStart(2, '0');
        if (teamCountdownMinutes) teamCountdownMinutes.textContent = String(minutes).padStart(2, '0');
        if (teamCountdownSeconds) teamCountdownSeconds.textContent = String(seconds).padStart(2, '0');
      };
      const updateCampaignVisibility = () => {
        const now = Date.now();
        campaignEligible = now >= campaignStartAt && now < campaignEndAt;
        campaignVisible = campaignEligible;
        campaignSurfaces.forEach((surface) => { surface.hidden = !campaignVisible; });
        updateTeamCampaignCountdown(now);
        return campaignVisible;
      };
      updateCampaignVisibility();
      const campaignVisibilityTimer = window.setInterval(updateCampaignVisibility, 1000);
      window.addEventListener('pagehide', () => window.clearInterval(campaignVisibilityTimer), { once: true });

      // Shared analytics helper — same PostHog sink as the rest of the site
      // (window.__odTrack, guarded). Stamps page_name + locale on every event.
      const track = (name, extra) => {
        try {
          if (typeof window.__odTrack === 'function') {
            window.__odTrack(
              name,
              Object.assign(
                { page_name: 'pricing', locale: (document.documentElement.getAttribute('lang') || 'en').toLowerCase() },
                extra || {},
              ),
            );
          }
        } catch (e) {}
      };
      // The public page never guesses an active Workspace. It preserves only a
      // workspaceId explicitly supplied on the inbound URL. Personal CTAs hand
      // the visible plan and interval to Vela for authenticated checkout; Team
      // keeps the generic billing entry until a concrete Team tier is selected.
      const inboundParams = new URLSearchParams(window.location.search);
      const inboundWorkspaceId = inboundParams.get('workspaceId')?.trim();
      const requestedCloudConsoleBase = inboundParams.get(cloudConsoleBaseParam);
      const handoffError = root.querySelector('[data-cloud-console-handoff-error]');
      let cloudConsoleBase = defaultCloudConsoleBase;
      let cloudConsoleEnvironment = 'production';
      let cloudConsoleHandoffValid = true;
      try {
        if (requestedCloudConsoleBase !== null) {
          const candidate = new URL(requestedCloudConsoleBase.trim());
          const normalized = candidate.toString();
          const hosted =
            candidate.protocol === 'https:' &&
            candidate.port.length === 0 &&
            candidate.pathname.endsWith('/') &&
            hostedCloudConsoleDomains.some(
              (domain) =>
                candidate.hostname === domain || candidate.hostname.endsWith(`.${domain}`),
            );
          const loopback =
            candidate.protocol === 'http:' &&
            (candidate.hostname === 'localhost' || candidate.hostname === '127.0.0.1') &&
            candidate.port.length > 0 &&
            candidate.pathname === '/';
          if (
            candidate.username ||
            candidate.password ||
            candidate.search ||
            candidate.hash ||
            (!hosted && !loopback)
          ) {
            throw new Error('cloud_console_base_not_allowed');
          }
          cloudConsoleBase = normalized;
          cloudConsoleEnvironment =
            normalized === defaultCloudConsoleBase ? 'production' : 'non-production';
        }
      } catch (error) {
        cloudConsoleHandoffValid = false;
        cloudConsoleEnvironment = 'invalid';
        if (handoffError) handoffError.hidden = false;
        console.error('Invalid Cloud Console Pricing handoff.', error);
      }
      root.setAttribute('data-cloud-console-environment', cloudConsoleEnvironment);
      const cloudConsoleDashboardUrl = cloudConsoleHandoffValid
        ? new URL('dashboard', cloudConsoleBase).toString()
        : null;
      for (const consoleLink of root.querySelectorAll('[data-cloud-console-link]')) {
        if (cloudConsoleDashboardUrl) {
          consoleLink.setAttribute('href', cloudConsoleDashboardUrl);
        } else {
          consoleLink.setAttribute('aria-disabled', 'true');
          consoleLink.setAttribute('tabindex', '-1');
          consoleLink.removeAttribute('href');
        }
      }
      const billingPlanUrl = cloudConsoleDashboardUrl
        ? (() => {
            const target = new URL(cloudConsoleDashboardUrl);
            target.searchParams.set('billing', 'plan');
            return target.toString();
          })()
        : null;
      const scopedBillingPlanUrl = () => {
        if (!billingPlanUrl) throw new Error('Cloud Console Pricing handoff is unavailable.');
        const target = new URL(billingPlanUrl);
        if (inboundWorkspaceId) target.searchParams.set('workspaceId', inboundWorkspaceId);
        // od_campaign_id is intentionally NOT forwarded from the inbound URL:
        // campaign membership is re-decided by campaignEligible on this click and
        // written only through __odAttributedUrl so a closed window cannot
        // inherit a desktop-badge campaign id into Cloud checkout.
        for (const key of [
          'od_origin',
          'od_entry_id',
          'od_entry_source',
          'od_entry_at',
          'od_conversion_source',
          'od_device_id',
        ]) {
          const value = inboundParams.get(key);
          if (value) target.searchParams.set(key, value);
        }
        return target.toString();
      };
      // Mirrors `formatUsd` in _lib/pricing.ts: cents only when the amount has
      // them, so Team seat prices like $73.50 are not rounded into a wrong quote.
      const usd = (n) => {
        const cents = Math.round(n * 100);
        return (
          '$' +
          (cents / 100).toLocaleString('en-US', {
            minimumFractionDigits: cents % 100 === 0 ? 0 : 2,
            maximumFractionDigits: 2,
          })
        );
      };
      const fill = (tpl, vals) =>
        tpl.replace(/\{(\w+)\}/g, (_, k) => (k in vals ? vals[k] : '{' + k + '}'));
      const set = (scope, sel, text) => {
        const el = root.querySelector(scope + ' ' + sel);
        if (el) el.textContent = text;
      };
      const syncCtas = () => {
        const interval = root.getAttribute('data-interval') === 'monthly' ? 'monthly' : 'yearly';
        for (const cta of root.querySelectorAll('[data-pricing-cta]')) {
          if (!cloudConsoleHandoffValid) {
            cta.setAttribute('data-subscription-disabled', '');
            cta.setAttribute('aria-disabled', 'true');
            cta.setAttribute('tabindex', '-1');
            cta.removeAttribute('href');
            continue;
          }
          if (cta.hasAttribute('data-subscription-disabled')) {
            cta.removeAttribute('href');
            continue;
          }
          const tier = cta.getAttribute('data-tier') || '';
          if (tier === 'free') {
            cta.setAttribute('href', cloudConsoleDashboardUrl);
            continue;
          }
          if (tier === 'team') {
            const selectedTier = teamTiers.find(
              (candidate) =>
                candidate.tier ===
                root.querySelector('[data-team-tier]')?.getAttribute('data-value'),
            );
            const selectedSeats = Number(
              root.querySelector('[data-team-seats]')?.textContent || '',
            );
            if (!selectedTier || !Number.isSafeInteger(selectedSeats)) {
              cta.setAttribute('href', scopedBillingPlanUrl());
              continue;
            }
            const target = new URL(scopedBillingPlanUrl());
            target.searchParams.set('billing', 'plan');
            target.searchParams.set('plan', selectedTier.tier);
            target.searchParams.set('interval', interval);
            target.searchParams.set(
              'seats',
              String(Math.max(selectedTier.minSeats, selectedSeats)),
            );
            target.searchParams.set('checkout', 'auto');
            cta.setAttribute('href', target.toString());
            continue;
          }
          const target = new URL(scopedBillingPlanUrl());
          target.searchParams.set('billing', 'plan');
          target.searchParams.set('plan', tier);
          target.searchParams.set('interval', interval);
          target.searchParams.set('checkout', 'auto');
          cta.setAttribute('href', target.toString());
        }
      };
      syncCtas();

      // ── Creator / Team audience toggle ─────────────────────────────────
      let lastCampaignBenefitAudience = null;
      const trackCampaignBenefit = (audience) => {
        if (!campaignVisible) return;
        if (lastCampaignBenefitAudience === audience) return;
        lastCampaignBenefitAudience = audience;
        track('surface_view', {
          area: audience === 'team' ? 'pricing_team_plan' : 'pricing_personal_plan',
          element: 'deepseek_v4_pro_benefit',
          campaign_id: 'deepseek_v4_pro',
          user_state: 'unknown',
          audience,
        });
        track('surface_view', {
          area: audience === 'team' ? 'pricing_team_plan' : 'pricing_personal_plan',
          element: 'deepseek_v4_flash_benefit',
          campaign_id: 'deepseek_v4_flash',
          user_state: 'unknown',
          audience,
        });
      };
      const activateAudience = (audience, shouldTrackClick = true) => {
        root.setAttribute('data-audience', audience);
        for (const button of root.querySelectorAll('[data-audience-btn]')) {
          const active = button.getAttribute('data-audience-btn') === audience;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-selected', active ? 'true' : 'false');
          button.setAttribute('tabindex', active ? '0' : '-1');
        }
        for (const panel of root.querySelectorAll('[data-audience-panel]')) {
          panel.hidden = panel.getAttribute('data-audience-panel') !== audience;
        }
        if (shouldTrackClick) {
          track('ui_click', {
            area: 'pricing_controls',
            element: 'audience_toggle',
            audience,
          });
        }
        trackCampaignBenefit(audience);
        root.dispatchEvent(new CustomEvent('pricing:audience-changed', {
          detail: { audience },
        }));
      };
      for (const button of root.querySelectorAll('[data-audience-btn]')) {
        button.addEventListener('click', () => {
          activateAudience(button.getAttribute('data-audience-btn'));
        });
        button.addEventListener('keydown', (event) => {
          const buttons = Array.from(root.querySelectorAll('[data-audience-btn]'));
          const current = buttons.indexOf(button);
          let next = current;
          if (event.key === 'ArrowRight') next = (current + 1) % buttons.length;
          else if (event.key === 'ArrowLeft') next = (current - 1 + buttons.length) % buttons.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = buttons.length - 1;
          else return;
          event.preventDefault();
          const nextButton = buttons[next];
          activateAudience(nextButton.getAttribute('data-audience-btn'));
          nextButton.focus();
        });
      }
      const requestedAudience = new URLSearchParams(window.location.search).get('audience');
      if (requestedAudience === 'team') activateAudience('team', false);
      else trackCampaignBenefit('creator');

      // Campaign impressions must fire when the surfaces become visible, which
      // happens either on load (window already open) or mid-session when the
      // visibility loop flips `campaignVisible` at startAt.
      // A one-time flag + the same 1s cadence as the reveal loop covers both
      // paths; the benefit impression reuses trackCampaignBenefit's own audience
      // dedupe.
      const trackCampaignImpressionsOnce = () => {
        if (!campaignVisible) return;
        trackCampaignBenefit(root.getAttribute('data-audience') === 'team' ? 'team' : 'creator');
      };
      trackCampaignImpressionsOnce();
      const campaignImpressionTimer = window.setInterval(trackCampaignImpressionsOnce, 1000);
      window.addEventListener('pagehide', () => window.clearInterval(campaignImpressionTimer), { once: true });

      // ── Billing interval toggle ──────────────────────────────────────────
      // One entry point so user clicks and subscription-state initialization
      // share the same rendering path without misreporting initialization as a click.
      const activateInterval = (interval, via, shouldTrack = true) => {
        const previousInterval = root.getAttribute('data-interval') === 'monthly'
          ? 'monthly'
          : 'yearly';
        root.setAttribute('data-interval', interval);
        for (const b of root.querySelectorAll('[data-interval-btn]')) {
          const on = b.getAttribute('data-interval-btn') === interval;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        }
        updateTeamPlan();
        syncCtas();
        root.dispatchEvent(new CustomEvent('pricing:interval-changed', {
          detail: { interval, previousInterval, shouldTrack },
        }));
        if (shouldTrack) {
          track('ui_click', {
            area: 'pricing_controls',
            element: 'billing_interval',
            interval,
            via: via || 'toggle',
          });
        }
      };

      root.addEventListener('pricing:set-interval', (event) => {
        const interval = event.detail?.interval;
        if (interval === 'monthly' || interval === 'yearly') {
          activateInterval(interval, 'subscription_state', false);
        }
      });
      root.addEventListener('pricing:sync-ctas', syncCtas);

      for (const btn of root.querySelectorAll('[data-interval-btn]')) {
        btn.addEventListener('click', () => activateInterval(btn.getAttribute('data-interval-btn'), 'toggle'));
      }

      // Monthly-tab "save $X yearly" nudge → switch to the yearly tab.
      for (const nudge of root.querySelectorAll('[data-goto-yearly]')) {
        nudge.addEventListener('click', () => activateInterval('yearly', 'nudge'));
      }

      // ── Static Team snapshot controls ───────────────────────────────────
      const teamTierTrigger = root.querySelector('[data-team-tier]');
      const teamTierSelect = root.querySelector('[data-team-tier-select]');
      const teamTierOptions = root.querySelector('[data-team-tier-options]');
      const teamTierValue = root.querySelector('[data-team-tier-value]');
      const teamTierOptionList = Array.from(root.querySelectorAll('[data-team-tier-option]'));
      const teamSeatsOutput = root.querySelector('[data-team-seats]');
      const teamSeatsDec = root.querySelector('[data-team-seats-dec]');
      const teamSeatsInc = root.querySelector('[data-team-seats-inc]');
      let teamSeats = Number(teamSeatsOutput?.textContent || 3);
      const teamTier = () =>
        teamTiers.find((tier) => tier.tier === teamTierTrigger?.getAttribute('data-value')) ||
        teamTiers[0];

      const closeTeamTierMenu = (restoreFocus) => {
        if (!teamTierTrigger || !teamTierOptions) return;
        teamTierOptions.hidden = true;
        teamTierTrigger.setAttribute('aria-expanded', 'false');
        if (restoreFocus) teamTierTrigger.focus();
      };
      const openTeamTierMenu = (focusIndex) => {
        if (!teamTierTrigger || !teamTierOptions) return;
        teamTierOptions.hidden = false;
        teamTierTrigger.setAttribute('aria-expanded', 'true');
        const selectedIndex = Math.max(
          0,
          teamTierOptionList.findIndex((option) => option.getAttribute('aria-selected') === 'true'),
        );
        const index =
          typeof focusIndex === 'number'
            ? Math.max(0, Math.min(teamTierOptionList.length - 1, focusIndex))
            : selectedIndex;
        teamTierOptionList[index]?.focus();
      };
      const selectTeamTier = (option) => {
        const value = option?.getAttribute('data-value');
        const tier = teamTiers.find((candidate) => candidate.tier === value);
        if (!tier || !teamTierTrigger) return;
        teamTierTrigger.setAttribute('data-value', tier.tier);
        if (teamTierValue) teamTierValue.textContent = option.querySelector('span')?.textContent || '';
        for (const candidate of teamTierOptionList) {
          const selected = candidate === option;
          candidate.classList.toggle('is-selected', selected);
          candidate.setAttribute('aria-selected', selected ? 'true' : 'false');
        }
        teamSeats = Math.max(tier.minSeats, teamSeats);
        closeTeamTierMenu(true);
        updateTeamPlan();
        track('ui_click', {
          area: 'pricing_team_plan',
          element: 'tier_select',
          tier: tier.tier,
        });
      };

      const fillTeam = (template, values) =>
        template.replace(/\{(\w+)\}/g, (_, key) =>
          Object.prototype.hasOwnProperty.call(values, key) ? values[key] : `{${key}}`,
        );
      const updateTeamPlan = () => {
        const tier = teamTier();
        if (!tier) return;
        teamSeats = Math.max(tier.minSeats, teamSeats);
        if (teamSeatsOutput) teamSeatsOutput.textContent = String(teamSeats);
        if (teamSeatsDec) teamSeatsDec.disabled = teamSeats <= tier.minSeats;

        const interval = root.getAttribute('data-interval') === 'monthly' ? 'monthly' : 'yearly';
        const selected = tier[interval];
        const months = interval === 'yearly' ? 12 : 1;
        const introSeatMonth = selected.introPriceUsd / months;
        const listSeatMonth = interval === 'yearly' ? tier.monthly.priceUsd : selected.priceUsd;
        const discountPct = Math.round((1 - introSeatMonth / listSeatMonth) * 100);
        const intervalTotal = selected.introPriceUsd * teamSeats;
        const monthlyTeamTotal = intervalTotal / months;
        const amount = usd(introSeatMonth);
        const strike = usd(listSeatMonth);
        const monthlyTotal = usd(monthlyTeamTotal).replace(/^\$/, '');
        const total = usd(intervalTotal).replace(/^\$/, '');

        set('[data-audience-panel="team"]', '[data-team-amount]', amount);
        set('[data-audience-panel="team"]', '[data-team-strike]', strike);
        set(
          '[data-audience-panel="team"]',
          '[data-team-discount]',
          fill(
            interval === 'yearly' ? labels.yearlyDiscountTag : labels.firstMonthTag,
            { pct: String(discountPct) },
          ),
        );
        set(
          '[data-audience-panel="team"]',
          '[data-team-monthly-summary]',
          fillTeam(teamCopy.monthlyTotal, { amount: monthlyTotal }),
        );
        set(
          '[data-audience-panel="team"]',
          '[data-team-yearly-summary]',
          fillTeam(teamCopy.yearlyTotal, { amount: total }),
        );
        set(
          '[data-audience-panel="team"]',
          '[data-team-checkout-total]',
          fillTeam(
            interval === 'yearly' ? teamCopy.yearlyCheckout : teamCopy.monthlyCheckout,
            { amount: total },
          ),
        );
        set(
          '[data-audience-panel="team"]',
          '[data-team-min]',
          fillTeam(teamCopy.minSeatsNote, { count: String(tier.minSeats) }),
        );
        syncCtas();
      };

      teamTierTrigger?.addEventListener('click', () => {
        const isOpen = teamTierTrigger.getAttribute('aria-expanded') === 'true';
        if (isOpen) closeTeamTierMenu(false);
        else openTeamTierMenu();
      });
      teamTierTrigger?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          openTeamTierMenu(event.key === 'ArrowUp' ? teamTierOptionList.length - 1 : undefined);
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openTeamTierMenu();
        } else if (event.key === 'Escape') {
          closeTeamTierMenu(false);
        }
      });
      for (const option of teamTierOptionList) {
        option.addEventListener('click', () => selectTeamTier(option));
        option.addEventListener('keydown', (event) => {
          const current = teamTierOptionList.indexOf(option);
          let next = current;
          if (event.key === 'ArrowDown') next = (current + 1) % teamTierOptionList.length;
          else if (event.key === 'ArrowUp') {
            next = (current - 1 + teamTierOptionList.length) % teamTierOptionList.length;
          } else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = teamTierOptionList.length - 1;
          else if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            selectTeamTier(option);
            return;
          } else if (event.key === 'Escape') {
            event.preventDefault();
            closeTeamTierMenu(true);
            return;
          } else {
            return;
          }
          event.preventDefault();
          teamTierOptionList[next]?.focus();
        });
      }
      document.addEventListener('pointerdown', (event) => {
        if (teamTierSelect && !teamTierSelect.contains(event.target)) closeTeamTierMenu(false);
      });
      teamSeatsDec?.addEventListener('click', () => {
        teamSeats = Math.max(teamTier()?.minSeats || 3, teamSeats - 1);
        updateTeamPlan();
      });
      teamSeatsInc?.addEventListener('click', () => {
        teamSeats += 1;
        updateTeamPlan();
      });
      updateTeamPlan();

      // CTA analytics + cross-product payment attribution. A new entry id is
      // minted at this conversion click, not at campaign impression.
      root.addEventListener('click', (event) => {
        const cta = event.target && event.target.closest && event.target.closest('[data-pricing-cta]');
        if (!cta) return;
        if (cta.hasAttribute('data-subscription-disabled')) {
          event.preventDefault();
          return;
        }
        try {
          const audience = root.getAttribute('data-audience') || 'creator';
          // Outside the activity window the CTA still records od_entry_*
          // attribution, but must not stamp the campaign — clicks outside
          // the window may not count toward it.
          const attribution = window.__odRecordCampaignEntry?.(
            audience === 'team' ? 'landing_pricing_team_plan' : 'landing_pricing_personal_plan',
            campaignEligible ? 'deepseek_v4_pro' : undefined,
          );
          const props = {
            page_name: 'pricing',
            area: audience === 'team' ? 'pricing_team_plan' : 'pricing_personal_plan',
            element: 'subscribe',
            tier: cta.getAttribute('data-tier') || 'unknown',
            interval: root.getAttribute('data-interval') || 'monthly',
            audience,
            ...(campaignEligible ? { campaign_id: 'deepseek_v4_pro' } : {}),
            user_state: 'unknown',
            ...(attribution || {}),
          };
          if (typeof window.__odTrack === 'function') window.__odTrack('ui_click', props);
          else if (window.posthog && window.posthog.capture) window.posthog.capture('ui_click', props);
          if (attribution && window.__odAttributedUrl) {
            event.preventDefault();
            const destination = cta.getAttribute('href') || scopedBillingPlanUrl();
            window.location.href = window.__odAttributedUrl(destination, attribution);
          }
        } catch (e) {}
      });

      // ── Enterprise lead-capture modal ─────────────────────────────────────
      // The modal lives OUTSIDE [data-pricing-root], so query document.
      // Form fields, validation, and the /contact-sales submit are owned by
      // the shared enterprise-lead-form component; this block only owns the
      // modal shell (open/close/focus) and the legacy analytics bridge.
      const modal = document.querySelector('[data-lead-modal]');
      if (modal) {
        let lastFocus = null;

        const card = modal.querySelector('.pr-modal-card');
        const closeBtn = modal.querySelector('.pr-modal-x');
        const openModal = () => {
          lastFocus = document.activeElement;
          // Drop any stale error state from a previous failed attempt before
          // re-presenting the form (entered values and the sticky success
          // panel are intentionally preserved).
          const form = modal.querySelector('#ent-form');
          if (form) form.dispatchEvent(new Event('od:lead-reset'));
          modal.hidden = false;
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          // After a successful submit the form is hidden and the sticky success
          // panel takes its place, so the usual email-field focus target and
          // the form-heading label are both gone. Point the dialog's name at
          // whichever heading is actually visible and land focus on a real
          // target (the close button) so keyboard / SR users are never stranded
          // on the background trigger.
          const showingSuccess = !!(form && form.hidden);
          if (card) {
            card.setAttribute('aria-labelledby', showingSuccess ? 'ent-success-heading' : 'ent-form-heading');
          }
          const focusTarget = showingSuccess
            ? closeBtn
            : modal.querySelector('#ent-email');
          if (focusTarget) setTimeout(() => focusTarget.focus(), 40);
        };
        const closeModal = () => {
          modal.hidden = true;
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        };

        for (const btn of document.querySelectorAll('[data-open-lead-modal]')) {
          btn.addEventListener('click', () => {
            track('team_lead_open', { area: 'enterprise_card' });
            root.dispatchEvent(new CustomEvent('pricing:enterprise-open'));
            openModal();
          });
        }
        for (const el of modal.querySelectorAll('[data-lead-close]')) {
          el.addEventListener('click', closeModal);
        }
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.hidden) closeModal();
        });

        // Legacy funnel continuity: the shared form emits lead_submit_success
        // (page_name: 'pricing'); existing dashboards also watch
        // team_lead_submit, so mirror it here. The legacy schema (team_size /
        // budget with '(none)' fallbacks + has_* presence booleans) is
        // preserved verbatim so pre-existing filters keep matching, and the
        // shared form's richer props (seats, country, industry, use case)
        // ride alongside.
        modal.addEventListener('od:lead-success', (e) => {
          const d = (e && e.detail) || {};
          track('team_lead_submit', {
            team_size: d.team_size || '(none)',
            budget: d.budget || '(none)',
            has_company: !!d.has_company,
            has_role: !!d.has_role,
            has_seats: !!d.seats,
            has_message: !!d.has_message,
            seats: d.seats || '',
            country: d.country || '',
            industry: d.industry || '',
            use_case: d.use_case || '',
            use_case_count: d.use_case_count || 0,
          });
        });
      }
    })();
  </script>
  <script>
    import {
      loadPersonalPricingContext,
      resolvePersonalPlanAction,
    } from '../../_lib/pricing-current-plan';
    import type {
      PersonalBillingInterval,
      PersonalPlanTier,
      PersonalPricingContext,
    } from '../../_lib/pricing-current-plan';

    const pricingRoot = document.querySelector('[data-pricing-root]');
    if (pricingRoot?.getAttribute('data-cloud-console-environment') === 'production') {
      const apiOrigin = pricingRoot.getAttribute('data-billing-api-origin') || '';
      const personalTiers = new Set(['go', 'plus', 'pro', 'max']);
      const actionLabels = {
        current: pricingRoot.getAttribute('data-current-plan-label') || '',
        currentCanceling: pricingRoot.getAttribute('data-current-canceling-label') || '',
        downgrade: pricingRoot.getAttribute('data-downgrade-plan-label') || '',
        upgrade: pricingRoot.getAttribute('data-upgrade-plan-label') || '',
        intervalUpgrade: pricingRoot.getAttribute('data-interval-upgrade-label') || '',
        switchBack: pricingRoot.getAttribute('data-switch-back-interval-label') || '',
        intervalDowngradeUnavailable:
          pricingRoot.getAttribute('data-interval-downgrade-unavailable-label') || '',
        checkoutUnavailable: pricingRoot.getAttribute('data-checkout-unavailable-label') || '',
        scheduled: pricingRoot.getAttribute('data-scheduled-plan-label') || '',
      };
      const intervalLabels = {
        monthly: pricingRoot.getAttribute('data-monthly-label') || 'Monthly',
        yearly: pricingRoot.getAttribute('data-yearly-label') || 'Yearly',
      };
      const fillActionLabel = (
        template: string,
        values: Record<string, string>,
      ) => template.replace(/\{(\w+)\}/g, (_, key) => values[key] ?? `{${key}}`);
      let pricingContext: PersonalPricingContext | null = null;

      const applyIntroEligibility = () => {
        if (!pricingContext) return;
        const eligible = pricingContext.firstMonthIntroEligible;
        pricingRoot.setAttribute('data-first-month-intro-eligible', eligible ? 'true' : 'false');
        for (const amount of pricingRoot.querySelectorAll('[data-monthly-price]')) {
          const value = amount.getAttribute(eligible ? 'data-intro-price' : 'data-regular-price');
          if (value) amount.textContent = value;
        }
      };

      const applyPersonalActions = () => {
        if (!pricingContext) return;
        const interval: PersonalBillingInterval = pricingRoot.getAttribute('data-interval') === 'monthly'
          ? 'monthly'
          : 'yearly';
        pricingRoot.setAttribute(
          'data-current-personal-plan-id',
          pricingContext.current?.tier ?? '',
        );
        pricingRoot.setAttribute(
          'data-current-personal-billing-interval',
          pricingContext.current?.interval ?? '',
        );
        for (const cta of pricingRoot.querySelectorAll('[data-pricing-cta]')) {
          const tier = cta.getAttribute('data-tier') || '';
          if (!personalTiers.has(tier)) continue;
          const label = cta.querySelector(':scope > span');
          const plan = cta.getAttribute('data-plan-name') || tier;
          const action = resolvePersonalPlanAction(pricingContext, {
            tier: tier as PersonalPlanTier,
            interval,
          });
          let text = cta.getAttribute('data-default-label') || plan;
          if (action.kind === 'current') text = actionLabels.current;
          else if (action.kind === 'current_canceling') text = actionLabels.currentCanceling;
          else if (action.kind === 'scheduled') {
            text = fillActionLabel(actionLabels.scheduled, { plan });
          } else if (action.kind === 'upgrade') {
            text = fillActionLabel(actionLabels.upgrade, { plan });
          } else if (action.kind === 'interval_upgrade') {
            text = fillActionLabel(actionLabels.intervalUpgrade, {
              plan,
              interval: intervalLabels[interval],
            });
          } else if (action.kind === 'dual_change') {
            const currentInterval: PersonalBillingInterval =
              pricingContext.current?.interval ?? interval;
            text = fillActionLabel(actionLabels.switchBack, {
              interval: intervalLabels[currentInterval],
            });
          } else if (action.kind === 'interval_downgrade_unavailable') {
            text = fillActionLabel(actionLabels.intervalDowngradeUnavailable, {
              interval: intervalLabels[interval],
            });
          } else if (action.kind === 'checkout_unavailable') {
            text = actionLabels.checkoutUnavailable;
          } else if (action.kind === 'downgrade_unavailable') {
            text = fillActionLabel(actionLabels.downgrade, { plan });
          }
          if (label) label.textContent = text;
          if (action.enabled) {
            cta.removeAttribute('data-subscription-disabled');
            cta.removeAttribute('aria-disabled');
            cta.removeAttribute('tabindex');
          } else {
            cta.setAttribute('data-subscription-disabled', '');
            cta.setAttribute('aria-disabled', 'true');
            cta.setAttribute('tabindex', '-1');
            cta.removeAttribute('href');
          }
        }
        pricingRoot.dispatchEvent(new CustomEvent('pricing:sync-ctas'));
        const status = pricingRoot.querySelector<HTMLElement>('[data-personal-pricing-status]');
        if (status) {
          let message = '';
          if (!pricingContext.current && !pricingContext.checkoutAllowed) {
            message = actionLabels.checkoutUnavailable;
          } else if (pricingContext.pendingChange) {
            const plan = pricingContext.pendingChange.tier.charAt(0).toUpperCase()
              + pricingContext.pendingChange.tier.slice(1);
            message = fillActionLabel(actionLabels.scheduled, { plan });
          }
          status.textContent = message;
          status.hidden = !message;
        }
      };

      pricingRoot.addEventListener('pricing:interval-changed', applyPersonalActions);
      void loadPersonalPricingContext(apiOrigin).then((context) => {
        if (!context) return;
        pricingContext = context;
        applyIntroEligibility();
        if (context.current) {
          pricingRoot.dispatchEvent(new CustomEvent('pricing:set-interval', {
            detail: { interval: context.current.interval },
          }));
        } else {
          applyPersonalActions();
        }
        (pricingRoot as HTMLElement & {
          __personalPricingContext?: PersonalPricingContext;
        }).__personalPricingContext = context;
        pricingRoot.setAttribute('data-personal-pricing-context-resolved', 'true');
        pricingRoot.dispatchEvent(new CustomEvent('pricing:personal-context-resolved', {
          detail: { authenticated: true, context },
        }));
      });
    }
  </script>
  <script>
    import {
      createPricingCompatibilityAnalytics,
    } from '../../_lib/pricing-compat-analytics';
    import {
      resolvePricingBridgeSource,
    } from '../../_lib/pricing-analytics-bridge';
    import type {
      PersonalPricingContext,
    } from '../../_lib/pricing-current-plan';
    import type { BillingInterval } from '../../_lib/pricing';

    const compatibilityRoot = document.querySelector<HTMLElement>('[data-pricing-root]');
    const sourceSurface = resolvePricingBridgeSource({
      search: new URLSearchParams(window.location.search),
      referrer: document.referrer,
    });
    if (compatibilityRoot && sourceSurface) {
      const apiOrigin = compatibilityRoot.getAttribute('data-billing-api-origin') || '';
      const sessionId = typeof globalThis.crypto?.randomUUID === 'function'
        ? globalThis.crypto.randomUUID()
        : `pricing-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      const compatibility = createPricingCompatibilityAnalytics({
        apiOrigin,
        sessionId,
      });
      const readAudience = () =>
        compatibilityRoot.getAttribute('data-audience') === 'team'
          ? 'team' as const
          : 'creator' as const;
      const readInterval = (): BillingInterval =>
        compatibilityRoot.getAttribute('data-interval') === 'monthly'
          ? 'monthly'
          : 'yearly';
      const exposeVisiblePlans = () => {
        compatibility.exposePlans({
          audience: readAudience(),
          interval: readInterval(),
        });
      };

      const resolveCompatibilityContext = (context: PersonalPricingContext | null) => {
        if (!context) return;
        compatibility.resolveContext({
          authenticated: true,
          sourceSurface,
          currentPlanId: context.current?.tier ?? null,
          currentBillingInterval: context.current?.interval ?? null,
          firstMonthEligible: context.firstMonthIntroEligible,
        });
        exposeVisiblePlans();
      };
      compatibilityRoot.addEventListener('pricing:personal-context-resolved', (event) => {
        const detail = (event as CustomEvent<{
          authenticated?: boolean;
          context?: PersonalPricingContext | null;
        }>).detail;
        if (detail?.authenticated !== true) return;
        resolveCompatibilityContext(detail.context ?? null);
      });
      resolveCompatibilityContext((compatibilityRoot as HTMLElement & {
        __personalPricingContext?: PersonalPricingContext;
      }).__personalPricingContext ?? null);
      compatibilityRoot.addEventListener('pricing:audience-changed', exposeVisiblePlans);
      compatibilityRoot.addEventListener('pricing:interval-changed', (event) => {
        const detail = (
          event as CustomEvent<{
            interval?: string;
            previousInterval?: string;
            shouldTrack?: boolean;
          }>
        ).detail;
        const targetInterval = detail?.interval === 'monthly' ? 'monthly' : 'yearly';
        const currentInterval = detail?.previousInterval === 'monthly'
          ? 'monthly'
          : 'yearly';
        compatibility.changeInterval({
          audience: readAudience(),
          currentInterval,
          targetInterval,
          userInitiated: detail?.shouldTrack === true,
        });
      });
      compatibilityRoot.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const cta = target.closest<HTMLElement>('[data-pricing-cta]');
        if (!cta) return;
        compatibility.clickPlan({
          audience: readAudience(),
          planId: cta.getAttribute('data-tier') || '',
          interval: readInterval(),
          enabled: !cta.hasAttribute('data-subscription-disabled'),
        });
      });
      compatibilityRoot.addEventListener(
        'pricing:enterprise-open',
        compatibility.openEnterpriseLead,
      );
      document.addEventListener(
        'pricing:enterprise-submit',
        compatibility.submitEnterpriseLead,
      );
    }
  </script>
</Layout>

