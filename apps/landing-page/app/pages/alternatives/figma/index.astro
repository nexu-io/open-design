---
/*
 * /alternatives/figma/ — Figma reverse-keyword comparison spoke.
 *
 * Captures the "figma alternative" cluster (figma alternatives, figma open
 * source alternative, free figma alternative, …) — the lowest-difficulty,
 * highest-volume entry in OD's SEO landscape. A spoke off the /compare/ hub,
 * mirroring /alternatives/claude-design/.
 *
 * Editorial guardrails (SEO strategy v2 §10 + 6/6 audit §3.2):
 *  - H1 does NOT lead with "Figma Alternative" — OD's narrative ("agent-native")
 *    comes first; "alternative" is only the SEO entry term.
 *  - Honesty principle: acknowledge Figma's genuine strengths; Penpot is treated
 *    as a fellow open-source option, not a hostile competitor.
 *  - Visible FAQ mirrors the FAQPage JSON-LD (People-Also-Ask eligibility).
 */
import Layout from '../../../_components/sub-page-layout.astro';
import { getInfoPageCopy } from '../../../info-page-i18n';
import { localeFromPath, localizedHref } from '../../../i18n';

const SITE = Astro.site?.toString() ?? 'https://open-design.ai/';
const REPO = 'https://github.com/nexu-io/open-design';
const REPO_RELEASES = `${REPO}/releases`;
const locale = localeFromPath(Astro.url.pathname);
const href = (path: string) => localizedHref(path, locale);
const copy = getInfoPageCopy(locale);
const page = copy.figmaAlternative;
const common = copy.common;
const compare = copy.compare;

const title = page.title;
const description = page.description;

const features = page.features;
const faq = page.faq.map(({ name, text }) => ({ q: name, a: text }));

const jsonLd = [
  {
    // Three-level breadcrumb: Home → Compare (the hub) → this spoke. The
    // /compare/ hub is a real index page, so we can model the middle node
    // honestly (unlike the claude-design page, which predates a hub link).
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Open Design', item: SITE },
      { '@type': 'ListItem', position: 2, name: compare.breadcrumb, item: `${SITE}compare/` },
      { '@type': 'ListItem', position: 3, name: page.breadcrumb, item: `${SITE}alternatives/figma/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `${SITE}alternatives/figma/`,
    isPartOf: { '@id': `${SITE}#website` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Open Design',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'macOS, Windows, Linux',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: SITE,
  },
  {
    // The feature comparison table as an ItemList (one entry per row).
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: page.featureTitle,
    itemListElement: features.map((f, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: f.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<Layout title={title} description={description} active="home" jsonLd={jsonLd}>
  <nav class="breadcrumb" aria-label={common.breadcrumbAria}>
    <a href={href('/')}>Open Design</a>
    <span>/</span>
    <a href={href('/compare/')}>{compare.breadcrumb}</a>
    <span>/</span>
    <span aria-current="page">{page.breadcrumb}</span>
  </nav>

  <article class="info-page">
    <header class="catalog-head">
      <span class="label">{page.label}</span>
      <h1 class="display">{page.heading}</h1>
      <p class="lead">{page.lead}</p>
    </header>

    <div class="tldr-card">
      <h3>{page.tldrTitle}</h3>
      <p>{page.tldrBody}</p>
    </div>

    <nav class="info-toc" aria-label={common.onThisPage}>
      <span>{common.onThisPage}</span>
      <a href="#why-leave">{page.toc[0]}</a>
      <a href="#open-source">{page.toc[1]}</a>
      <a href="#compare">{page.toc[2]}</a>
      <a href="#who">{page.toc[3]}</a>
      <a href="#migrate">{page.toc[4]}</a>
      <a href="#faq">{page.toc[5]}</a>
    </nav>

    <section class="info-section" id="why-leave">
      <h2>{page.whyTitle}</h2>
      <p>{page.whyLead}</p>
      <ol>
        {page.reasons.map((item) => (
          <li><strong>{item.label}</strong> {item.body}</li>
        ))}
      </ol>
    </section>

    <section class="info-section" id="open-source">
      <h2>{page.openSourceTitle}</h2>
      {page.openSourceBody.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </section>

    <section class="info-section" id="compare">
      <h2>{page.featureTitle}</h2>
      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Open Design</th>
              <th>Figma</th>
            </tr>
          </thead>
          <tbody>
            {features.map((f) => (
              <tr>
                <th scope="row">{f.name}</th>
                <td class="yes"><span class="check">●</span>{f.od}</td>
                <td>{f.cd}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="info-section" id="who">
      <h2>{page.whoTitle}</h2>
      <h3>{page.pickFigmaTitle}</h3>
      <ul>
        {page.pickFigma.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <h3>{page.pickOpenTitle}</h3>
      <ul>
        {page.pickOpen.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="info-section" id="migrate">
      <h2>{page.migrateTitle}</h2>
      <p>{page.migrateLead}</p>
      <ol>
        {page.migrateSteps.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
      <p>{page.migrateClosing}</p>
    </section>

    <section class="info-section" id="faq">
      <h2>{page.faqTitle}</h2>
      <ol class="faq-list">
        {faq.map(({ q, a }, idx) => (
          <li class="faq-item">
            <details>
              <summary>
                <span class="faq-index">{String(idx + 1).padStart(2, '0')}</span>
                <span class="faq-q">{q}</span>
                <span class="faq-toggle" aria-hidden="true">+</span>
              </summary>
              <p class="faq-a">{a}</p>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section class="info-section" aria-label="Related comparisons">
      <p>
        <a href={href('/compare/')}>{compare.breadcrumb}</a>
        {' · '}
        <a href={href('/alternatives/claude-design/')}>{copy.claudeAlternative.breadcrumb}</a>
      </p>
    </section>

    <section class="info-cta" aria-label="Open Design call to action">
      <div>
        <h2>{page.ctaTitle}</h2>
        <p>{page.ctaBody}</p>
      </div>
      <div class="info-cta-actions">
        <a class="btn btn-primary" href={REPO} target="_blank" rel="noreferrer noopener">{common.starOnGithub}</a>
        <a class="btn btn-ghost" href={href('/quickstart/')}>{common.quickstart}</a>
        <a class="btn btn-ghost" href={REPO_RELEASES} target="_blank" rel="noreferrer noopener">{common.downloadDesktop}</a>
      </div>
      <div class="info-cta-meta">
        <span class="stamp">● {common.apache}</span>
        <span>{common.localFirst} · {common.byok}</span>
        <span>{common.macWinLinux}</span>
      </div>
    </section>
  </article>
</Layout>
