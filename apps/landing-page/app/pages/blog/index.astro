---
/*
 * Blog index — `/blog/`
 *
 * Editorial list page that reuses the landing-page CSS variables and the
 * shared <Header /> component so the magazine aesthetic stays consistent
 * with `/`.
 *
 * Posts come from the `blog` Content Collection defined in
 * `app/content.config.ts`. Sorted by date descending. A tiny inline script
 * powers category filtering via `?category=...`.
 */
import { getCollection } from 'astro:content';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import { Header, type HeaderProps } from '../../_components/header';
import SeoHead from '../../_components/seo-head.astro';
import '../../globals.css';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredPost = posts[0];

const headerHtml = renderToStaticMarkup(
  createElement<HeaderProps>(Header, { basePath: '/' }),
);

const seoTitle = 'Blog — Open Design';
const seoDescription =
  'Field notes on skills, systems, BYOK workflows, and machine-made form. Published as we ship.';
const categoryChips = [
  { label: 'All', value: 'all' },
  { label: 'Product', value: 'product' },
  { label: 'Guides', value: 'guides' },
  { label: 'Use cases', value: 'use-cases' },
  { label: 'Community', value: 'community' },
];
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <SeoHead
      kind='website'
      title={seoTitle}
      description={seoDescription}
      pathname={Astro.url.pathname}
    />
  </head>
  <body>
    <Fragment set:html={headerHtml} />

    <main class='blog-shell'>
      <section class='blog-masthead'>
        <div class='container'>
          <h1 class='blog-title'>Blog</h1>
          <p class='blog-sub'>
            Field notes on skills, systems, BYOK workflows, and machine-made
            form. Published as we ship.
          </p>
        </div>
      </section>

      {
        featuredPost && (
          <section
            class='blog-feature'
            data-blog-item
            data-category={featuredPost.data.category.toLowerCase().replace(/\s+/g, '-')}
          >
            <div class='container'>
              <a class='blog-feature-card' href={`/blog/${featuredPost.id}/`}>
                <span class='blog-feature-kicker'>Featured</span>
                <div class='blog-feature-main'>
                  <span class='blog-card-cat'>{featuredPost.data.category}</span>
                  <h2 class='blog-feature-title'>{featuredPost.data.title}</h2>
                  <p class='blog-feature-summary'>
                    {featuredPost.data.summary}
                  </p>
                </div>
                <span class='blog-feature-meta'>
                  <span>{fmtDate(featuredPost.data.date)}</span>
                  <span>·</span>
                  <span>{featuredPost.data.readingTime} min read</span>
                  <span class='blog-feature-cta'>Read more →</span>
                </span>
              </a>
            </div>
          </section>
        )
      }

      <section class='blog-categories'>
        <div class='container'>
          <div class='blog-category-strip' aria-label='Blog categories'>
            {categoryChips.map((category, index) => (
              <a
                class:list={['blog-chip', index === 0 && 'is-active']}
                href={category.value === 'all' ? '/blog/' : `/blog/?category=${category.value}`}
                data-category-filter={category.value}
              >
                {category.label}
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class='blog-list'>
        <div class='container'>
          {
            posts.length === 0 ? (
              <p class='blog-empty'>No entries yet. Check back soon.</p>
            ) : (
              <ol class='blog-grid'>
                {posts.map((post) => (
                  <li
                    class='blog-card'
                    data-blog-item
                    data-category={post.data.category.toLowerCase().replace(/\s+/g, '-')}
                    data-featured-list-item={post.id === featuredPost?.id ? 'true' : undefined}
                  >
                    <a class='blog-card-link' href={`/blog/${post.id}/`}>
                      <span class='blog-card-cat'>{post.data.category}</span>
                      <h2 class='blog-card-title'>{post.data.title}</h2>
                      <p class='blog-card-summary'>{post.data.summary}</p>
                      <span class='blog-card-foot'>
                        <span class='blog-card-date'>
                          {fmtDate(post.data.date)}
                        </span>
                        <span class='blog-card-rt'>
                          {post.data.readingTime} min read
                        </span>
                        <span class='blog-card-cta'>Read →</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            )
          }
          <p class='blog-empty is-filter-empty' data-blog-empty hidden>
            No posts in this category yet. More field notes are coming.
          </p>
        </div>
      </section>

      <footer class='blog-foot'>
        <div class='container'>
          <a class='blog-foot-back' href='/'>
            ← Back to Open Design
          </a>
          <span class='blog-foot-mark'>● Open Design · Apache-2.0 · MMXXVI</span>
        </div>
      </footer>
    </main>

    <script is:inline>
      (() => {
        const normalize = (value) => (value || 'all').toLowerCase();
        const params = new URLSearchParams(window.location.search);
        const active = normalize(params.get('category'));
        const filters = document.querySelectorAll('[data-category-filter]');
        const items = document.querySelectorAll('[data-blog-item]');
        const empty = document.querySelector('[data-blog-empty]');

        let visibleCount = 0;
        for (const item of items) {
          const matchesCategory =
            active === 'all' || item.getAttribute('data-category') === active;
          const isDuplicateFeatured =
            active === 'all' && item.hasAttribute('data-featured-list-item');
          const matches = matchesCategory && !isDuplicateFeatured;
          item.hidden = !matches;
          if (matches) visibleCount += 1;
        }

        for (const filter of filters) {
          const isActive = filter.getAttribute('data-category-filter') === active;
          filter.classList.toggle('is-active', isActive);
          if (isActive) filter.setAttribute('aria-current', 'page');
          else filter.removeAttribute('aria-current');
        }

        if (empty) empty.hidden = visibleCount !== 0;
      })();
    </script>

    <style>
      .blog-shell {
        position: relative;
        z-index: 2;
      }

      .blog-masthead {
        padding: 34px 0 20px;
        border-bottom: 1px solid var(--line-soft);
      }
      .blog-title {
        font-family: var(--sans);
        font-weight: 800;
        letter-spacing: -0.028em;
        font-size: clamp(52px, 6.4vw, 96px);
        line-height: 0.94;
        color: var(--ink);
        margin: 0 0 12px;
      }
      .blog-title em {
        font-family: var(--serif);
        font-style: italic;
        font-weight: 500;
        letter-spacing: -0.018em;
        color: var(--coral);
      }
      .blog-sub {
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.48;
        color: var(--ink-soft);
        max-width: 58ch;
        margin-bottom: 0;
      }
      .blog-category-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 0 0 14px;
      }
      .blog-chip {
        display: inline-flex;
        align-items: center;
        min-height: 34px;
        padding: 8px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-family: var(--sans);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-mute);
        background: rgba(247, 241, 222, 0.38);
        text-decoration: none;
        transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
      }
      .blog-chip:hover {
        color: var(--ink);
        border-color: rgba(21, 20, 15, 0.42);
        background: rgba(247, 241, 222, 0.72);
      }
      .blog-chip.is-active {
        color: var(--paper);
        background: var(--ink);
        border-color: var(--ink);
      }
      .blog-feature {
        padding: 16px 0 6px;
      }
      .blog-feature-card {
        display: grid;
        grid-template-columns: 132px minmax(0, 1fr);
        gap: 18px;
        padding: 22px 28px;
        border: 1px solid var(--line);
        background: var(--bone);
        color: var(--ink);
        text-decoration: none;
        box-shadow: var(--shadow);
        transition: transform 180ms ease, background 180ms ease;
      }
      .blog-feature-card:hover {
        background: var(--paper-warm);
        transform: translateY(-2px);
      }
      .blog-feature-kicker {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }
      .blog-feature-main {
        display: grid;
        gap: 10px;
      }
      .blog-feature-title {
        font-family: var(--serif);
        font-size: clamp(28px, 3.2vw, 44px);
        font-weight: 500;
        line-height: 1.06;
        letter-spacing: -0.02em;
        color: var(--ink);
        max-width: 18ch;
      }
      .blog-feature-card:hover .blog-feature-title {
        color: var(--coral);
      }
      .blog-feature-summary {
        font-family: var(--body);
        font-size: 15px;
        line-height: 1.48;
        color: var(--ink-mute);
        max-width: 62ch;
      }
      .blog-feature-meta {
        grid-column: 2;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--line-soft);
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--ink-faint);
      }
      .blog-feature-cta {
        margin-left: auto;
        font-family: var(--sans);
        font-size: 13px;
        letter-spacing: 0;
        color: var(--ink);
      }
      .blog-feature-card:hover .blog-feature-cta {
        color: var(--coral);
      }

      .blog-categories {
        padding: 6px 0 0;
      }
      .blog-list {
        padding: 12px 0 52px;
      }
      .blog-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }
      .blog-card {
        border-bottom: 1px solid var(--line);
      }
      .blog-card:nth-child(odd) {
        border-right: 1px solid var(--line);
      }
      .blog-card-link {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 28px 28px 26px;
        text-decoration: none;
        color: var(--ink);
        position: relative;
        transition: background 200ms ease;
      }
      .blog-card-link:hover {
        background: var(--paper-warm);
      }
      .blog-card-cat {
        font-family: var(--sans);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--coral);
        display: inline-flex;
        align-items: center;
        gap: 12px;
      }
      .blog-card-cat::before {
        content: '';
        width: 18px;
        height: 1px;
        background: var(--coral);
      }
      .blog-card-title {
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(24px, 2.2vw, 32px);
        line-height: 1.14;
        letter-spacing: -0.012em;
        color: var(--ink);
        margin: 4px 0 8px;
      }
      .blog-card-link:hover .blog-card-title {
        color: var(--coral);
      }
      .blog-card-summary {
        font-family: var(--body);
        font-size: 14px;
        line-height: 1.55;
        color: var(--ink-mute);
        max-width: 50ch;
      }
      .blog-card-foot {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 8px;
        padding-top: 14px;
        border-top: 1px solid var(--line-soft);
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--ink-faint);
      }
      .blog-card-cta {
        margin-left: auto;
        color: var(--ink);
        font-family: var(--sans);
        font-size: 13px;
        letter-spacing: 0;
      }
      .blog-card-link:hover .blog-card-cta {
        color: var(--coral);
      }

      .blog-empty {
        font-family: var(--body);
        color: var(--ink-mute);
        padding: 32px 0;
      }
      .blog-empty.is-filter-empty {
        border-top: 1px solid var(--line);
      }

      .blog-foot {
        padding: 36px 0 64px;
        border-top: 1px solid var(--line-soft);
      }
      .blog-foot .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }
      .blog-foot-back {
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
        transition: color 160ms ease;
      }
      .blog-foot-back:hover {
        color: var(--coral);
      }
      .blog-foot-mark {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--ink-faint);
      }

      @media (max-width: 760px) {
        .blog-masthead {
          padding: 22px 0 18px;
        }
        .blog-title {
          font-size: clamp(42px, 13vw, 50px);
          margin-bottom: 10px;
        }
        .blog-sub {
          font-size: 15.5px;
          line-height: 1.35;
          margin-bottom: 12px;
        }
        .blog-feature {
          padding: 12px 0 4px;
        }
        .blog-feature-card {
          grid-template-columns: 1fr;
          gap: 9px;
          padding: 16px;
        }
        .blog-feature-kicker {
          display: none;
        }
        .blog-feature-main {
          gap: 7px;
        }
        .blog-feature-title {
          font-size: clamp(23px, 6.6vw, 26px);
          line-height: 1.02;
          max-width: none;
        }
        .blog-feature-summary {
          display: -webkit-box;
          overflow: hidden;
          font-size: 13.5px;
          line-height: 1.4;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 2;
        }
        .blog-feature-meta {
          grid-column: 1;
          gap: 8px;
          padding-top: 8px;
          font-size: 10px;
        }
        .blog-feature-cta {
          display: none;
        }
        .blog-categories {
          padding-top: 8px;
        }
        .blog-category-strip {
          gap: 8px;
          margin-bottom: 18px;
        }
        .blog-chip {
          min-height: 30px;
          padding: 6px 11px;
          font-size: 10.5px;
        }
        .blog-grid {
          grid-template-columns: 1fr;
        }
        .blog-card:nth-child(odd) {
          border-right: 0;
        }
        .blog-list {
          padding: 24px 0 56px;
        }
        .blog-card-link {
          padding: 28px 0;
        }
      }
    </style>
  </body>
</html>
