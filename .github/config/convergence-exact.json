{
  "schema": { "version": 1 },
  "suites": {
    "convergence-control": [
      ".github/config/convergence-exact.json",
      ".github/config/exact-topology.json",
      ".github/scripts/convergence.py",
      ".github/scripts/handoff.py",
      ".github/scripts/lib/config.py",
      ".github/scripts/lib/github.py",
      ".github/scripts/lib/r2.py",
      ".github/workflows/convergence-exact.atom.yml",
      ".github/workflows/release-exact.yml",
      ".github/workflows/release-prerelease.yml",
      ".github/workflows/release-stable.yml",
      "tools/release/resources/exact-plan-identities.json",
      "tools/release/src/exact/plan.ts",
      "packages/metatool/",
      "tools/release/src/exact/scene-artifact.ts",
      "tools/release/src/exact/scene-cache.ts",
      "tools/release/src/exact/convergence-product.ts",
      "tools/release/src/exact/resource-cache.ts",
      "tools/release/src/exact/resource-composition.ts",
      "tools/release/src/exact/scene-contribution.ts",
      "tools/release/src/exact/native-build.ts",
      "tools/release/src/exact/topology.ts",
      "tools/release/src/exact/commands.ts",
      "tools/release/src/exact/control-cli.ts",
      "tools/release/esbuild.config.mjs"
    ],
    "terminal-scene": [
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "scripts/postinstall.mjs",
      "apps/closure/",
      "packages/download/",
      "packages/platform/",
      "packages/sidecar/",
      "packages/standalone/",
      "shells/terminal/"
    ],
    "electron-scene": [
      ".node-version",
      "suite://closure-resources",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "scripts/postinstall.mjs",
      "apps/closure/",
      "packages/download/",
      "packages/electron-kit/",
      "packages/electron-capsule/",
      "packages/platform/",
      "packages/sidecar/",
      "packages/standalone/",
      "shells/electron/"
    ],
    "closure-resources": [
      "apps/daemon/",
      "apps/web/",
      "packages/agui-adapter/",
      "packages/components/",
      "packages/contracts/",
      "packages/diagnostics/",
      "packages/electron-contract/",
      "packages/plugin-runtime/",
      "packages/registry-protocol/",
      "packages/release/",
      "packages/sidecar-proto/",
      "skills/",
      "design-templates/",
      "design-systems/",
      "craft/",
      "plugins/_official/",
      "plugins/registry/",
      "assets/frames/",
      "assets/community-pets/",
      "prompt-templates/",
      "data/plugin-previews/"
    ]
  },
  "workflows": {
    "release-exact": {
      "policy": "shell-scenes-v3",
      "workloads": {
        "terminal_scene_darwin_arm64": {
          "inputs": ["suite://terminal-scene"],
          "runnerClass": "terminal_darwin_arm64",
          "products": "manifest",
          "reusable": true
        },
        "electron_scene_darwin_arm64": {
          "inputs": ["suite://electron-scene"],
          "runnerClass": "electron_darwin_arm64",
          "products": "manifest",
          "reusable": true
        },
        "electron_scene_win32_x64": {
          "inputs": ["suite://electron-scene"],
          "runnerClass": "electron_win32_x64",
          "products": "manifest",
          "reusable": false
        }
      }
    }
  }
}
