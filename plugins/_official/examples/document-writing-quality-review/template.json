  "referenceHtml": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Editorial review · Open Design template launch note</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;650;700&family=Source+Serif+4:opsz,wght@8..60,550;8..60,650&display=swap\" rel=\"stylesheet\" />\n  <style>\n    @page { size:A4; margin:0; }\n    :root { --canvas:#edeeec; --paper:#fffefd; --ink:#202321; --muted:#6d736e; --line:#dde1de; --blue:#365f82; --blue-soft:#edf3f7; --amber:#a96d25; --amber-soft:#fbf2e8; --red:#a44c3e; --red-soft:#f9ece9; --green:#377158; --green-soft:#edf6f1; --shadow:0 20px 52px rgba(34,38,34,.11),0 3px 9px rgba(34,38,34,.05); }\n    * { box-sizing:border-box; }\n    body { margin:0; padding:34px 22px; background:var(--canvas); color:var(--ink); font:13px/1.55 Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; }\n    .mono { font-family:\"DM Mono\",ui-monospace,SFMono-Regular,Menlo,monospace; }\n    .page { width:min(100%,210mm); min-height:297mm; margin:0 auto; padding:12mm 15mm 11mm; background:var(--paper); box-shadow:var(--shadow); }\n    .topline { display:flex; justify-content:space-between; gap:18px; color:var(--muted); font:10.5px \"DM Mono\",monospace; letter-spacing:.07em; text-transform:uppercase; }\n    .topline strong { color:var(--blue); font-weight:500; }\n    .head { display:grid; grid-template-columns:1.25fr .75fr; gap:32px; padding:30px 0 24px; }\n    h1 { margin:0 0 8px; font:650 36px/1.08 \"Source Serif 4\",Georgia,serif; letter-spacing:-.04em; }\n    .head p { margin:0; color:#4a534e; font-size:13px; line-height:1.62; }\n    .decision { align-self:end; padding:18px; background:var(--red-soft); }\n    .decision b { display:inline-flex; align-items:center; padding:5px 10px; border-radius:99px; background:var(--red); color:#fff; font-size:13px; line-height:1; letter-spacing:0; }\n    .decision p { margin:12px 0 0; color:#76524b; font-size:12px; line-height:1.5; }\n    .context { display:grid; grid-template-columns:1.1fr 1fr .8fr; gap:0; margin-top:0; padding:0; border:1px solid var(--line); background:transparent; }\n    .context div { min-height:62px; padding:14px 16px; }\n    .context div + div { border-left:1px solid var(--line); }\n    .context span { display:block; margin-bottom:5px; color:#5f6a70; font:10.5px \"DM Mono\",monospace; letter-spacing:.07em; text-transform:uppercase; }\n    .context b { color:#4c5350; font-size:12.5px; font-weight:400; line-height:1.45; }\n    section { margin-top:33px; }\n    .section-head { display:flex; align-items:baseline; gap:11px; margin-bottom:13px; }\n    .section-no { min-width:25px; color:var(--blue); font:600 17px/1 Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; letter-spacing:.015em; font-variant-numeric:tabular-nums; }\n    h2 { margin:0; font:650 22px/1.1 \"Source Serif 4\",Georgia,serif; letter-spacing:-.025em; }\n    .priority-section .section-no { color:var(--red); }\n    .keep-section .section-no { color:var(--green); }\n    .rewrite-section .section-no { color:var(--blue); }\n    .keep { display:grid; grid-template-columns:16px 1fr; gap:7px; padding:16px 18px; border-left:3px solid var(--green); background:var(--green-soft); color:#474d49; font-size:12px; line-height:1.6; }\n    .keep > strong { color:var(--green); }\n    .keep div strong { color:var(--ink); }\n    .issues { border-top:0; border-right:1px solid var(--line); border-left:3px solid var(--red); }\n    .issue-columns { display:grid; grid-template-columns:102px 1fr 1fr; align-items:center; gap:18px; min-height:34px; padding:0 16px; background:#f6f8f8; color:#6b7478; font:9.5px/1 \"DM Mono\",monospace; letter-spacing:.07em; text-transform:uppercase; }\n    .priority-section .issue-columns { color:#86564f; background:#faf1ef; }\n    .issue { display:grid; grid-template-columns:102px 1fr 1fr; gap:18px; padding:15px 16px; border-bottom:1px solid var(--line); }\n    .severity { display:inline-block; width:max-content; padding:3px 7px; border-radius:99px; font:10.5px \"DM Mono\",monospace; letter-spacing:.02em; }\n    .severity.important { color:#96584e; background:#faebe8; }\n    .severity.blocker { color:#873c32; background:#f3dcd8; }\n    .issue .loc { display:block; margin-top:7px; color:#66706a; font-size:10.5px; line-height:1.4; }\n    .issue h3 { margin:0 0 5px; font-size:13px; }\n    .issue p { margin:0; color:var(--muted); font-size:12.5px; line-height:1.5; }\n    .rewrite { overflow:hidden; border:1px solid var(--line); border-left:3px solid var(--blue); }\n    .rewrite-row { display:grid; grid-template-columns:112px 1fr; border-bottom:1px solid var(--line); }\n    .rewrite-row:last-child { border-bottom:0; }\n    .rewrite-label { padding:15px; background:#fafbf9; color:var(--muted); font:10.5px \"DM Mono\",monospace; letter-spacing:.07em; text-transform:uppercase; }\n    .rewrite-copy { padding:15px 17px; color:#435049; font-size:13px; line-height:1.6; }\n    .rewrite-row.original .rewrite-label { color:var(--blue); background:var(--blue-soft); }\n    .rewrite-row.suggested .rewrite-label { color:var(--blue); background:var(--blue-soft); }\n    .rewrite-row.original .rewrite-copy,\n    .rewrite-row.suggested .rewrite-copy { color:var(--ink); background:var(--paper); }\n    .rewrite-row.original .rewrite-copy { font-weight:400; }\n    .rewrite-row.suggested .rewrite-copy { font-weight:500; }\n    .checks { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:0; border:0; background:transparent; }\n    .checks-head { display:flex; grid-column:1 / -1; align-items:baseline; gap:10px; margin-bottom:2px; }\n    .checks-head strong { color:var(--ink); font:650 22px/1.1 \"Source Serif 4\",Georgia,serif; letter-spacing:-.025em; }\n    .checks .section-no { color:var(--amber); }\n    .check { display:grid; grid-template-columns:13px 1fr; align-items:start; gap:7px; min-height:50px; padding:10px 12px; border-left:3px solid var(--amber); background:var(--amber-soft); color:var(--ink); font-size:12.5px; line-height:1.48; }\n    .check::before { content:\"□\"; color:var(--amber); line-height:1.48; }\n    footer { display:flex; justify-content:space-between; gap:12px; margin-top:44px; padding-top:14px; border-top:1px solid var(--line); color:#68716c; font:11px \"DM Mono\",monospace; }\n    @media print {\n      html, body { width:210mm; margin:0; padding:0; background:#fff; }\n      body { -webkit-print-color-adjust:exact; print-color-adjust:exact; }\n      .page { width:210mm; min-height:297mm; margin:0; padding:12mm 15mm 11mm; box-shadow:none; }\n      section, .issue, .rewrite-row, .check { break-inside:avoid; page-break-inside:avoid; }\n    }\n    @media (max-width:650px) { body { padding:0; } .page { min-height:100vh; padding:28px 25px; box-shadow:none; } .head { grid-template-columns:1fr; } .context { grid-template-columns:1fr; gap:14px; } .context div { min-height:0; } .context div + div { padding-top:14px; border-top:1px solid #d6e0e6; border-left:0; } .issue-columns { display:none; } .issue { grid-template-columns:1fr; gap:9px; } .rewrite-row { grid-template-columns:1fr; } .checks { grid-template-columns:1fr; } }\n  </style>\n</head>\n<body>\n  <main class=\"page\">\n    <header class=\"topline\"><span><strong>Editorial review</strong> · Release copy</span><span>Scope · clarity, claims &amp; action</span></header>\n    <div class=\"head\"><div><h1>Review before distribution</h1><p>Review of an internal launch note for contributors and reviewers who need to understand the first five document templates and how to give feedback.</p></div><aside class=\"decision\"><b>Revise</b><p>Narrow the claims and give reviewers a specific task before release.</p></aside></div>\n    <section class=\"context\"><div><span>Purpose</span><b>Introduce five directions and request review.</b></div><div><span>Known facts</span><b>Five structured HTML previews are ready.</b></div><div><span>Review range</span><b>Internal note · one paragraph</b></div></section>\n    <section class=\"priority-section\"><div class=\"section-head\"><span class=\"section-no\">01</span><h2>Priority revisions</h2></div><div class=\"issues\"><div class=\"issue-columns\"><span>Priority</span><span>Editorial finding</span><span>Recommended change</span></div><article class=\"issue\"><div><span class=\"severity blocker\">BLOCKER</span><span class=\"loc\">Opening sentence</span></div><div><h3>“Works for every document workflow” is unsupported.</h3><p>The current examples cover five directions, not every possible document task. The claim makes the launch note less credible.</p></div><div><h3>Name the current scope.</h3><p>Describe the five prepared directions and invite reviewers to identify gaps or unclear scenarios.</p></div></article><article class=\"issue\"><div><span class=\"severity important\">IMPORTANT</span><span class=\"loc\">Second sentence</span></div><div><h3>“Makes document creation effortless” is a vague promise.</h3><p>The note does not identify what users can inspect or improve in the current template set.</p></div><div><h3>Point to reviewable artifacts.</h3><p>Say that each direction includes a structured example and a shareable HTML preview.</p></div></article><article class=\"issue\"><div><span class=\"severity important\">IMPORTANT</span><span class=\"loc\">Closing sentence</span></div><div><h3>The call to action lacks a review task.</h3><p>“Take a look” does not tell contributors what feedback would be useful.</p></div><div><h3>Ask for a concrete check.</h3><p>Invite reviewers to check scenario fit, first-screen priority and the clarity of the final document output.</p></div></article></div></section>\n    <section class=\"keep-section\"><div class=\"section-head\"><span class=\"section-no\">02</span><h2>Keep</h2></div><div class=\"keep\"><strong>✓</strong><div><strong>Retain the availability message.</strong> The draft clearly states that the first templates are ready for review. This is the strongest verified reason for contributors to continue.</div></div></section>\n    <section class=\"rewrite-section\"><div class=\"section-head\"><span class=\"section-no\">03</span><h2>Suggested replacement</h2></div><div class=\"rewrite\"><div class=\"rewrite-row original\"><div class=\"rewrite-label\">Current draft</div><div class=\"rewrite-copy\">“Open Design now has document templates that work for every workflow and make document creation effortless. The templates turn any request into a polished result and are ready for everyone to use. Take a look and let us know what you think.”</div></div><div class=\"rewrite-row suggested\"><div class=\"rewrite-label\">Suggested copy</div><div class=\"rewrite-copy\">“Open Design has prepared five document template directions for review: PDF Workspace, DOCX Workspace, Branded PDF, Branded DOCX and Writing Quality Review. Each direction includes a structured example and a shareable HTML preview. Please review the scenario fit, the information shown first and whether the output is clear enough to use or adapt.”</div></div></div></section>\n    <section class=\"checks\"><div class=\"checks-head\"><span class=\"section-no\">04</span><strong>Before distribution</strong></div><div class=\"check\"><span>Confirm the final names used for the five template directions.</span></div><div class=\"check\"><span>Add the approved locations for each HTML preview.</span></div><div class=\"check\"><span>Keep the scope limited to the five prepared directions.</span></div><div class=\"check\"><span>Ask reviewers for scenario, priority and output feedback.</span></div></section>\n    <footer><span>Open Design template launch note</span><span>Writing quality review</span><span>Page 1</span></footer>\n  </main>\n</body>\n</html>\n"
}
