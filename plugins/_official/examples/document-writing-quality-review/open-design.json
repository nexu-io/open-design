{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "document-writing-quality-review",
  "title": "Writing Quality Review",
  "title_i18n": {
    "en": "Writing Quality Review",
    "zh-CN": "写作质量评审"
  },
  "version": "0.1.0",
  "publishedAt": "2026-08-27T00:00:00Z",
  "description": "An editorial review sheet that prioritizes findings, preserves what works, and supplies a concrete replacement draft.",
  "description_i18n": {
    "en": "An editorial review sheet that prioritizes findings, preserves what works, and supplies a concrete replacement draft.",
    "zh-CN": "按优先级呈现编辑问题、保留项和替换稿的写作质量评审单。"
  },
  "license": "MIT",
  "author": {
    "name": "Open Design",
    "url": "https://github.com/nexu-io/open-design"
  },
  "homepage": "https://github.com/nexu-io/open-design/tree/main/plugins/_official/examples/document-writing-quality-review",
  "tags": [
    "document-template",
    "first-party",
    "prototype",
    "web",
    "desktop",
    "writing",
    "review",
    "editorial",
    "quality",
    "revision",
    "a4"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "prototype",
    "platform": "desktop",
    "scenario": "documents",
    "surface": "web",
    "preview": {
      "type": "image",
      "poster": "./example.webp"
    },
    "useCase": {
      "query": {
        "en": "Use the Writing Quality Review to turn my real content into a polished, self-contained HTML document. Start from the embedded reference HTML, preserve its visual signature and A4 print contract, and do not invent facts.",
        "zh-CN": "用「写作质量评审」把我的真实内容做成一份精致、可独立打开的 HTML 文档。必须从内嵌参考 HTML 开始，保留视觉特征和 A4 打印契约，不要虚构事实。"
      },
      "exampleOutputs": [
        {
          "path": "./example.webp",
          "title": "Writing Quality Review",
          "title_i18n": {
            "en": "Writing Quality Review",
            "zh-CN": "写作质量评审"
          }
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./template.json",
        "./example.webp"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
