  "referenceHtml": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Community Workshop Agreement · Fill &amp; prepare</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;650;700&display=swap\" rel=\"stylesheet\" />\n  <style>\n    :root { --canvas:#eef1f2; --paper:#fffefd; --ink:#18211f; --muted:#68736e; --faint:#97a19c; --line:#dbe2e4; --accent:#145a66; --accent-soft:#e6f0f4; --panel:#f4f8fa; --success:#187452; --radius:8px; --shadow:0 20px 48px rgba(34,47,42,.10),0 3px 10px rgba(34,47,42,.05); }\n    * { box-sizing:border-box; }\n    body { margin:0; padding:46px 22px; background:var(--canvas); color:var(--ink); font:13px/1.55 Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; }\n    .mono { font-family:\"DM Mono\",ui-monospace,SFMono-Regular,Menlo,monospace; }\n    .sheet { width:min(100%,794px); min-height:1123px; margin:0 auto; padding:32px 52px 36px; background:var(--paper); border:1px solid #e3e4df; box-shadow:var(--shadow); }\n    .context { display:flex; align-items:center; justify-content:space-between; gap:16px; padding-bottom:18px; border-bottom:1px solid var(--line); color:var(--muted); font-size:10px; letter-spacing:.06em; text-transform:uppercase; }\n    .context-left,.context-right { display:flex; align-items:center; gap:8px; }\n    .pdf-mark { display:inline-grid; width:28px; height:28px; place-items:center; border:0; border-radius:var(--radius); color:var(--accent); background:var(--accent-soft); font:9px \"DM Mono\",monospace; }\n    .task { padding:4px 7px; border-radius:999px; color:#124d55; background:var(--accent-soft); font:10px \"DM Mono\",monospace; letter-spacing:0; text-transform:none; }\n    .doc-header { position:relative; display:flex; justify-content:space-between; gap:24px; padding:28px 0 23px; }\n    .doc-header::after { position:absolute; bottom:0; left:0; width:136px; height:1px; background:var(--line); content:\"\"; }\n    .kicker,.meta,.section-label { color:var(--muted); font:10px/1.55 \"DM Mono\",monospace; letter-spacing:.07em; text-transform:uppercase; }\n    h1 { margin:9px 0 8px; font-size:33px; line-height:1.08; letter-spacing:-.05em; }\n    .meta { font-size:9.5px; }\n    .wordmark { min-width:102px; padding-top:3px; color:var(--accent); font-size:11px; font-weight:700; letter-spacing:.09em; line-height:1.45; text-align:right; }\n    .intro { margin:16px 0 0; color:#3c4742; font-size:12.5px; line-height:1.75; }\n    .source { display:grid; grid-template-columns:auto minmax(0,1fr); align-items:center; gap:12px; margin-top:21px; padding:13px 15px; border:0; border-radius:var(--radius); background:var(--panel); }\n    .source-copy { min-width:0; }\n    .source-copy b,.source-copy span { display:block; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }\n    .source-copy b { font-size:11.5px; }\n    .source-copy span { margin-top:2px; color:var(--muted); font:10px \"DM Mono\",monospace; }\n    section { margin-top:25px; }\n    .source + section { margin-top:53px; }\n    .section-label { margin-bottom:12px; color:var(--ink); font-size:14px; font-weight:650; letter-spacing:.055em; line-height:1.25; }\n    .agreement-grid { display:grid; grid-template-columns:1fr 1fr; overflow:hidden; border:1px solid var(--line); border-radius:var(--radius); }\n    .field { min-height:74px; padding:14px 16px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); }\n    .field:nth-child(2n) { border-right:0; }\n    .field:nth-last-child(-n+2) { border-bottom:0; }\n    .field span { display:table; width:max-content; margin-bottom:6px; padding:2px 5px; border-radius:4px; color:#526773; background:var(--accent-soft); font:500 9px \"DM Mono\",monospace; letter-spacing:.075em; text-transform:uppercase; }\n    .field b { font-size:12px; font-weight:600; }\n    .filled { color:var(--ink); }\n    .copy { color:#3c4742; font-size:12px; line-height:1.76; }\n    .copy p { margin:0 0 13px; }\n    .review { padding:0; background:none; }\n    .review-intro { padding:17px 18px; border-radius:var(--radius); background:var(--panel); }\n    .review h2 { margin:0 0 7px; font-size:14px; letter-spacing:-.02em; }\n    .review p { margin:0; color:var(--muted); font-size:11px; line-height:1.55; }\n    .review-status { margin-top:7px; padding:14px 18px 17px; border-radius:var(--radius); background:var(--panel); }\n    .output-file { display:grid; gap:4px; }\n    .output-file span { color:var(--accent); font:9px \"DM Mono\",monospace; letter-spacing:.07em; text-transform:uppercase; }\n    .file-row { display:flex; align-items:baseline; justify-content:space-between; min-width:0; gap:16px; }\n    .output-file b { min-width:0; color:var(--ink); font-size:12px; line-height:1.35; overflow-wrap:anywhere; }\n    .output-file small { flex:0 0 auto; color:var(--muted); font:9.5px \"DM Mono\",monospace; white-space:nowrap; }\n    .checks { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; margin-top:13px; padding-top:13px; border-top:1px solid var(--line); }\n    .checks-label { grid-column:1 / -1; margin-bottom:2px; color:var(--accent); font:9px \"DM Mono\",monospace; letter-spacing:.07em; text-transform:uppercase; }\n    .check { display:flex; align-items:center; gap:7px; min-height:48px; padding:10px 10px; border-radius:var(--radius); background:#fff; color:#33413b; font-size:10px; line-height:1.35; }\n    .tick { display:grid; width:13px; height:13px; flex:0 0 13px; place-items:center; border-radius:50%; color:white; background:#246f86; font-size:9px; }\n    .signature { display:grid; grid-template-columns:1fr 1fr; gap:7px; margin-top:72px; }\n    .signature div { min-height:62px; padding:13px 15px; border:1px solid var(--line); border-radius:var(--radius); background:transparent; color:var(--muted); font-size:10px; }\n    .signature b { display:block; margin-top:5px; color:var(--ink); font-size:12px; }\n    footer { display:flex; justify-content:space-between; gap:12px; margin-top:47px; padding-top:14px; border-top:1px solid var(--line); color:var(--faint); font:9px \"DM Mono\",monospace; }\n    @media (max-width:680px) { body { padding:0; } .sheet { min-height:100vh; padding:27px 24px; border:0; box-shadow:none; } .doc-header { grid-template-columns:1fr; display:grid; } .wordmark { text-align:left; } .agreement-grid,.signature,.checks { grid-template-columns:1fr; } .context-right { display:none; } }\n    @page { size:A4; margin:0; }\n    @media print {\n      body { padding:0; background:white; }\n      .sheet { width:210mm; min-height:297mm; margin:0; padding:8.47mm 13.76mm 9.53mm; border:0; box-shadow:none; }\n      .source, .agreement-grid, .review-intro, .review-status, .signature { break-inside:avoid; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"sheet\">\n    <div class=\"context\">\n      <div class=\"context-left\"><span>Fill &amp; prepare</span><span class=\"task\">4 fields complete</span></div>\n      <div class=\"context-right mono\">open-design-community-workshop-agreement.pdf</div>\n    </div>\n\n    <header class=\"doc-header\">\n      <div>\n        <div class=\"kicker\">Open Design · Community Programs</div>\n        <h1>Community Workshop Agreement</h1>\n        <div class=\"meta\">Reference OD-COMM-2026-014 · Prepared 18 August 2026</div>\n      </div>\n      <div class=\"wordmark\">OPEN<br />DESIGN</div>\n    </header>\n\n    <p class=\"intro\">This agreement confirms the reservation of event facilities and related services for an Open Design community workshop and the host named below.</p>\n\n    <div class=\"source\">\n      <span class=\"pdf-mark\">PDF</span>\n      <div class=\"source-copy\"><b>open-design-community-workshop-agreement.pdf</b><span>1.8 MB · supplied for internal review</span></div>\n    </div>\n\n    <section>\n      <div class=\"section-label\">Event details</div>\n      <div class=\"agreement-grid\">\n        <div class=\"field\"><span>Event name</span><b class=\"filled\">Open Design Community Workshop</b></div>\n        <div class=\"field\"><span>Venue</span><b class=\"filled\">Studio North</b></div>\n        <div class=\"field\"><span>Event dates</span><b class=\"filled\">14–16 September 2026</b></div>\n        <div class=\"field\"><span>Client company</span><b class=\"filled\">Open Design</b></div>\n      </div>\n    </section>\n\n    <section class=\"copy\">\n      <div class=\"section-label\">General terms</div>\n      <p>Open Design shall provide the final attendee estimate no later than ten business days before the first event date. Any variation to the reserved rooms or workshop programme must be confirmed in writing by both parties.</p>\n      <p>Payment terms, cancellation provisions and venue rules are set out in Schedule A. Open Design confirms that the event details above are accurate before the agreement is signed.</p>\n    </section>\n\n    <section class=\"review\">\n      <div class=\"review-intro\">\n        <h2>Prepared for final review</h2>\n        <p>The agreement details match the approved workshop brief and are ready to circulate for signature review.</p>\n      </div>\n      <div class=\"review-status\">\n        <div class=\"output-file\"><span>Output PDF</span><div class=\"file-row\"><b>open-design-community-workshop-agreement-review.pdf</b><small>Editable review copy</small></div></div>\n        <div class=\"checks\"><div class=\"checks-label\">Pre-export checks</div><div class=\"check\"><span class=\"tick\">✓</span>Mandatory fields completed</div><div class=\"check\"><span class=\"tick\">✓</span>Dates match the source brief</div><div class=\"check\"><span class=\"tick\">✓</span>Output details confirmed</div></div>\n      </div>\n    </section>\n\n    <div class=\"signature\"><div>Open Design signatory<b>To be confirmed</b></div><div>Date<b>Added after sign-off</b></div></div>\n    <footer><span>Open Design Community Workshop Agreement</span><span>Review copy · 1 of 1</span><span>Internal review</span></footer>\n  </main>\n</body>\n</html>\n"
}
