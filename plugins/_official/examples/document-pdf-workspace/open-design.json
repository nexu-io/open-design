{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "document-pdf-workspace",
  "title": "PDF Workspace Template",
  "title_i18n": {
    "en": "PDF Workspace Template",
    "zh-CN": "PDF 工作区模板"
  },
  "version": "0.1.0",
  "publishedAt": "2026-08-27T00:00:00Z",
  "description": "A fill-and-prepare agreement workspace that turns supplied facts into a review-ready, printable PDF document.",
  "description_i18n": {
    "en": "A fill-and-prepare agreement workspace that turns supplied facts into a review-ready, printable PDF document.",
    "zh-CN": "把已有信息整理为可填写、可复核、可打印的 PDF 协议工作区。"
  },
  "license": "MIT",
  "author": {
    "name": "Open Design",
    "url": "https://github.com/nexu-io/open-design"
  },
  "homepage": "https://github.com/nexu-io/open-design/tree/main/plugins/_official/examples/document-pdf-workspace",
  "tags": [
    "document-template",
    "first-party",
    "prototype",
    "web",
    "desktop",
    "pdf",
    "workspace",
    "agreement",
    "form",
    "print",
    "a4"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "prototype",
    "platform": "desktop",
    "scenario": "documents",
    "surface": "web",
    "preview": {
      "type": "image",
      "poster": "./example.webp"
    },
    "useCase": {
      "query": {
        "en": "Use the PDF Workspace Template to turn my real content into a polished, self-contained HTML document. Start from the embedded reference HTML, preserve its visual signature and A4 print contract, and do not invent facts.",
        "zh-CN": "用「PDF 工作区模板」把我的真实内容做成一份精致、可独立打开的 HTML 文档。必须从内嵌参考 HTML 开始，保留视觉特征和 A4 打印契约，不要虚构事实。"
      },
      "exampleOutputs": [
        {
          "path": "./example.webp",
          "title": "PDF Workspace Template",
          "title_i18n": {
            "en": "PDF Workspace Template",
            "zh-CN": "PDF 工作区模板"
          }
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./template.json",
        "./example.webp"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
