{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "document-decision-memo",
  "title": "Decision Memo",
  "title_i18n": {
    "en": "Decision Memo",
    "zh-CN": "决策备忘录"
  },
  "version": "0.1.0",
  "publishedAt": "2026-08-27T00:00:00Z",
  "description": "A one-page decision memo that makes the recommendation, evidence, option trade-offs, controls, and next action immediately scannable.",
  "description_i18n": {
    "en": "A one-page decision memo that makes the recommendation, evidence, option trade-offs, controls, and next action immediately scannable.",
    "zh-CN": "把核心建议、事实依据、选项权衡、风险控制与下一步行动压缩到一页的决策备忘录。"
  },
  "license": "MIT",
  "author": {
    "name": "Open Design",
    "url": "https://github.com/nexu-io/open-design"
  },
  "homepage": "https://github.com/nexu-io/open-design/tree/main/plugins/_official/examples/document-decision-memo",
  "tags": [
    "document-template",
    "first-party",
    "prototype",
    "web",
    "desktop",
    "decision",
    "memo",
    "recommendation",
    "options",
    "risk",
    "a4"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "prototype",
    "platform": "desktop",
    "scenario": "documents",
    "surface": "web",
    "preview": {
      "type": "image",
      "poster": "./example.webp"
    },
    "useCase": {
      "query": {
        "en": "Use the Decision Memo to turn my real content into a polished, self-contained HTML document. Start from the embedded reference HTML, preserve its visual signature and A4 print contract, and do not invent facts.",
        "zh-CN": "用「决策备忘录」把我的真实内容做成一份精致、可独立打开的 HTML 文档。必须从内嵌参考 HTML 开始，保留视觉特征和 A4 打印契约，不要虚构事实。"
      },
      "exampleOutputs": [
        {
          "path": "./example.webp",
          "title": "Decision Memo",
          "title_i18n": {
            "en": "Decision Memo",
            "zh-CN": "决策备忘录"
          }
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./template.json",
        "./example.webp"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
