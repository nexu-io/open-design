  "referenceHtml": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Open Design document template pilot proposal</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;650;700&family=Roboto+Condensed:wght@500;600&display=swap\" rel=\"stylesheet\" />\n  <style>\n    :root { --canvas:#eef1f5; --paper:#fbfcfe; --surface:#f6f8fb; --ink:#152638; --muted:#657789; --line:#d7e2ec; --navy:#174b6b; --navy-soft:#eaf3fb; --signal:#3c8fd8; --radius:8px; --radius-small:5px; --shadow:0 24px 60px rgba(21,38,56,.13),0 3px 9px rgba(21,38,56,.05); }\n    * { box-sizing:border-box; } body { margin:0; padding:36px 22px; background:var(--canvas); color:var(--ink); font:13px/1.55 Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; } .mono { font-family:\"DM Mono\",ui-monospace,SFMono-Regular,Menlo,monospace; }\n    .document { width:min(100%,900px); min-height:1120px; margin:0 auto; padding:0 72px 40px; border-top:8px solid var(--navy); background:var(--paper); box-shadow:var(--shadow); } .masthead { display:flex; align-items:center; justify-content:space-between; padding:27px 0 22px; border-bottom:1px solid var(--line); } .brand { display:flex; align-items:center; gap:10px; color:var(--navy); font-size:16px; font-weight:700; letter-spacing:-.03em; } .mark { display:grid; width:27px; height:27px; place-items:center; border-radius:50%; color:white; background:var(--navy); font:13px/1 Georgia,serif; } .doc-kind { color:var(--muted); font:10px \"DM Mono\",monospace; letter-spacing:.08em; text-transform:uppercase; }\n    .cover { position:relative; padding:40px 0 27px; } .cover::after { position:absolute; right:0; bottom:0; left:0; height:1px; background:repeating-linear-gradient(90deg,var(--navy) 0 3px,transparent 3px 7px); content:\"\"; } .eyebrow { color:var(--signal); font:500 10px \"DM Mono\",monospace; letter-spacing:.12em; text-transform:uppercase; } h1 { max-width:680px; margin:16px 0 16px; font:700 49px/.98 Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; letter-spacing:-.05em; } .lede { max-width:610px; margin:0; color:var(--muted); font-size:15px; line-height:1.35; }\n    .cover-meta { display:grid; grid-template-columns:1.45fr 1fr 1fr 1.05fr; gap:0; margin-top:24px; padding:15px 16px; border:1px solid var(--line); border-radius:var(--radius); background:var(--surface); } .cover-meta div { padding:0 17px; } .cover-meta div:first-child { padding-left:0; } .cover-meta div:last-child { padding-right:0; } .cover-meta div + div { border-left:1px solid var(--line); } .cover-meta div span { display:block; margin-bottom:5px; color:var(--muted); font:10px \"DM Mono\",monospace; letter-spacing:.08em; text-transform:uppercase; } .cover-meta div b { display:block; color:var(--ink); font-size:12px; font-weight:600; line-height:1.4; } .cover-meta .delivery b { color:var(--navy); }\n    section { margin-top:31px; } .section-head { display:flex; align-items:baseline; gap:11px; margin-bottom:13px; } .section-no { color:var(--signal); font:600 20px/1 \"Roboto Condensed\",Inter,sans-serif; letter-spacing:-.055em; } h2 { margin:0; color:var(--ink); font-size:20px; line-height:1; letter-spacing:-.035em; } .summary { position:relative; display:grid; grid-template-columns:1.18fr .82fr; gap:25px; padding:24px 26px 24px 34px; border-radius:var(--radius); background:var(--navy-soft); } .summary::before { position:absolute; top:18px; bottom:18px; left:0; width:4px; border-radius:0 99px 99px 0; background:var(--signal); content:\"\"; } .summary p { margin:0; color:var(--muted); font-size:13px; line-height:1.7; } .summary strong { color:var(--ink); } .summary-side { padding-left:24px; border-left:1px solid var(--line); } .summary-side span { display:block; margin-bottom:7px; color:var(--muted); font:10px \"DM Mono\",monospace; letter-spacing:.08em; text-transform:uppercase; } .summary-side b { display:block; color:var(--ink); font-size:13px; line-height:1.45; }\n    .approach { display:grid; grid-template-columns:repeat(3,1fr); overflow:hidden; border:1px solid var(--line); border-radius:var(--radius); } .workstream { min-height:147px; padding:18px 17px 15px; } .workstream:nth-child(2) { background:var(--surface); } .workstream .number { color:var(--signal); font:10px \"DM Mono\",monospace; } .workstream h3 { margin:10px 0 6px; color:var(--ink); font-size:13px; letter-spacing:-.02em; } .workstream p { margin:0; color:var(--muted); font-size:12px; line-height:1.55; }\n    .success-criteria { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:15px; } .criterion { position:relative; min-height:150px; padding:18px; border:0; border-radius:var(--radius-small); background:var(--navy-soft); } .criterion:not(:last-child)::after { position:absolute; top:50%; right:-20px; z-index:1; width:15px; height:10px; background:var(--signal); clip-path:polygon(0 38%,64% 38%,64% 0,100% 50%,64% 100%,64% 62%,0 62%); content:\"\"; transform:translateY(-50%); } .criterion span { display:block; margin-bottom:10px; color:var(--signal); font:10px \"DM Mono\",monospace; letter-spacing:.08em; text-transform:uppercase; } .criterion b { display:block; margin-bottom:6px; color:var(--ink); font-size:14px; line-height:1.3; } .criterion p { margin:0; color:var(--muted); font-size:12px; line-height:1.55; }\n    .scope { display:grid; grid-template-columns:1fr 1fr; gap:18px; } .scope-card { padding:18px; border:0; border-radius:var(--radius); background:var(--navy-soft); } .scope-card--pending { border:1px dashed rgba(60,143,216,.58); } .scope-card h3 { margin:0 0 11px; color:var(--ink); font-size:12px; } .scope-card ul { display:grid; gap:8px; margin:0; padding:0; list-style:none; color:var(--muted); font-size:12px; } .scope-card li { display:flex; gap:10px; } .scope-card li::before { width:6px; height:6px; flex:0 0 6px; margin-top:6px; border-radius:50%; background:var(--signal); content:\"\"; }\n    .timeline { width:100%; overflow:hidden; border:1px solid var(--line); border-spacing:0; border-radius:var(--radius); border-collapse:separate; } .timeline th { padding:13px 16px; color:var(--muted); background:var(--navy-soft); font:10px \"DM Mono\",monospace; letter-spacing:.08em; text-align:left; text-transform:uppercase; } .timeline th + th,.timeline td + td { border-left:1px solid var(--line); } .timeline td { padding:15px 16px; color:var(--muted); font-size:12px; vertical-align:middle; } .timeline tbody tr:nth-child(even) td { background:var(--surface); } .timeline td:first-child { width:25%; color:var(--ink); font-weight:600; } .timeline td:nth-child(2),.timeline td:last-child { color:var(--navy); font-size:12px; font-weight:400; }\n    .operating-grid { display:grid; grid-template-columns:1.18fr .82fr; gap:18px; margin-top:18px; } .operating-card { padding:19px 20px 18px; border:0; border-radius:var(--radius); background:var(--navy-soft); } .operating-card .card-kicker { display:block; margin-bottom:11px; color:var(--signal); font:10px \"DM Mono\",monospace; letter-spacing:.09em; text-transform:uppercase; } .operating-card h3 { margin:0 0 9px; color:var(--ink); font-size:13px; line-height:1.35; } .operating-card p { margin:0; color:var(--muted); font-size:12px; line-height:1.6; } .role-list { display:grid; gap:0; margin:0; padding:2px 0 0; list-style:none; } .role-list li { display:grid; grid-template-columns:128px minmax(0,1fr); gap:14px; padding:10px 0; color:var(--muted); border-bottom:1px solid var(--line); font-size:12px; line-height:1.45; } .role-list li:last-child { padding-bottom:0; border-bottom:0; } .role-list b { color:var(--ink); font-size:12px; } .assumption-card { border:1px dashed rgba(60,143,216,.42); } .assumption-card h3 { color:var(--ink); }\n    .next { display:grid; grid-template-columns:1fr auto; align-items:end; gap:26px; padding:21px 23px; border-radius:var(--radius); color:white; background:var(--navy); } .next .label { margin-bottom:5px; color:rgba(255,255,255,.72); font:10px \"DM Mono\",monospace; letter-spacing:.09em; text-transform:uppercase; } .next b { display:block; max-width:500px; font-size:13px; line-height:1.45; } .next span { color:rgba(255,255,255,.86); font:10px \"DM Mono\",monospace; white-space:nowrap; }\n    footer { display:flex; justify-content:space-between; gap:12px; margin-top:18px; padding-top:14px; border-top:1px solid var(--line); color:var(--muted); font:10px \"DM Mono\",monospace; opacity:.72; }\n    @media (max-width:680px) { body { padding:0; } .document { min-height:100vh; padding:0 25px 30px; box-shadow:none; } .masthead { padding:23px 0 19px; } .cover { padding:40px 0 29px; } h1 { font-size:37px; } .cover-meta,.summary,.scope,.operating-grid { grid-template-columns:1fr; } .cover-meta div,.cover-meta div:first-child,.cover-meta div:last-child { padding:11px 0; } .cover-meta div + div { border-top:1px solid var(--line); border-left:0; } .summary-side { padding:17px 0 0; border-top:1px solid var(--sand); border-left:0; } .approach,.success-criteria { grid-template-columns:1fr; } .workstream { border-right:0; border-bottom:1px solid var(--line); } .workstream:last-child { border-bottom:0; } .criterion { padding:13px 18px; border-right:0; border-bottom:1px solid var(--sand); } .criterion:not(:last-child)::after { display:none; } .criterion:last-child { border-bottom:0; } .role-list li { grid-template-columns:1fr; gap:2px; } .next { grid-template-columns:1fr; } }\n  </style>\n</head>\n<body>\n  <main class=\"document\">\n    <header class=\"masthead\"><div class=\"brand\"><span class=\"mark\">O</span>Open Design</div><div class=\"doc-kind\">Template pilot proposal · v1.0</div></header>\n    <section class=\"cover\">\n      <div class=\"eyebrow\">Prepared for a design partner · to be confirmed</div>\n      <h1>Document Template Pilot</h1>\n      <p class=\"lede\">A focused collaboration to turn high-value document workflows into reusable, review-ready templates for Open Design.</p>\n      <div class=\"cover-meta\"><div><span>Document</span><b>Open Design template pilot proposal</b></div><div><span>Prepared by</span><b>Open Design</b></div><div><span>Commercial terms</span><b>To be confirmed</b></div><div class=\"delivery\"><span>Delivery</span><b>Editable DOCX delivery</b></div></div>\n    </section>\n    <section><div class=\"section-head\"><span class=\"section-no\">01</span><h2>Executive recommendation</h2></div><div class=\"summary\"><p>We recommend a four-phase pilot that aligns the partner and Open Design on the highest-value document workflows, turns those workflows into usable templates, and leaves the team with a <strong>review-ready system</strong> for continued iteration.</p><div class=\"summary-side\"><span>Decision requested</span><b>Confirm the first three document workflows and appoint a project sponsor.</b></div></div><div class=\"success-criteria\"><article class=\"criterion\"><span>Success 01</span><b>Priorities become actionable</b><p>Three workflows are agreed, mapped and ready to move into template production.</p></article><article class=\"criterion\"><span>Success 02</span><b>Reviews reach decisions</b><p>Each pilot template has clear owners, acceptance criteria and one captured approval path.</p></article><article class=\"criterion\"><span>Success 03</span><b>Handoff stays usable</b><p>Teams receive editable DOCX foundations and concise rules for the next iteration.</p></article></div></section>\n    <section><div class=\"section-head\"><span class=\"section-no\">02</span><h2>Proposed approach</h2></div><div class=\"approach\"><article class=\"workstream\"><div class=\"number\">01 · Discover</div><h3>Map the work</h3><p>Identify the document tasks, source inputs and review moments that create the most friction or repetition.</p></article><article class=\"workstream\"><div class=\"number\">02 · Design</div><h3>Shape the templates</h3><p>Turn priority workflows into clear document structures, visual directions and editable template rules.</p></article><article class=\"workstream\"><div class=\"number\">03 · Validate &amp; handoff</div><h3>Make them usable</h3><p>Review the examples, capture template decisions and prepare the next iteration for contributors.</p></article></div></section>\n    <section><div class=\"section-head\"><span class=\"section-no\">03</span><h2>Scope and deliverables</h2></div><div class=\"scope\"><div class=\"scope-card\"><h3>Included</h3><ul><li>Workflow blueprint for the first template directions</li><li>Review-ready example documents for each agreed priority</li><li>Template rules and editable DOCX delivery foundations</li></ul></div><div class=\"scope-card scope-card--pending\"><h3>To confirm together</h3><ul><li>Priority workflows, source material and brand constraints</li><li>Project timing, commercial terms and review cadence</li><li>Named sponsor and contributor participants</li></ul></div></div></section>\n    <section><div class=\"section-head\"><span class=\"section-no\">04</span><h2>Delivery and governance</h2></div><table class=\"timeline\"><thead><tr><th>Phase</th><th>Focus</th><th>Key outcome</th></tr></thead><tbody><tr><td>Discover</td><td>Workflow priorities, source context and constraints</td><td>Shared template brief</td></tr><tr><td>Design</td><td>Structure, copy and visual direction</td><td>Review-ready templates</td></tr><tr><td>Validate</td><td>Feedback and scenario checks</td><td>Decisions captured</td></tr><tr><td>Handoff</td><td>Template rules and delivery alignment</td><td>Editable implementation package</td></tr></tbody></table><div class=\"operating-grid\"><article class=\"operating-card\"><span class=\"card-kicker\">Roles &amp; cadence</span><h3>A small decision group keeps the pilot moving.</h3><ul class=\"role-list\"><li><b>Partner sponsor</b><span>Sets priorities, resolves trade-offs and approves each phase outcome.</span></li><li><b>Contributor group</b><span>Supplies source material and joins one focused review each week.</span></li><li><b>Open Design</b><span>Facilitates working sessions, produces the template system and records decisions.</span></li></ul></article><article class=\"operating-card assumption-card\"><span class=\"card-kicker\">Commercial assumptions</span><h3>Scope stays transparent as the pilot develops.</h3><p>Timing, commercial terms and any additional workflow requests are confirmed in the statement of work. The pilot assumes timely source access, one named sponsor and consolidated feedback from the partner team.</p></article></div></section>\n    <section class=\"next\"><div><div class=\"label\">Next action</div><b>Confirm the first three document workflows and project sponsor for the pilot.</b></div><span>Timing · To be confirmed</span></section>\n    <footer><span>Open Design · Document Template Pilot</span><span>Proposal · Editable DOCX</span><span>Internal draft</span></footer>\n  </main>\n</body>\n</html>\n"
}
