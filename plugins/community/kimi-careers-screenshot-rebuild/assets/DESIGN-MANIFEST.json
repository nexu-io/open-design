      "scaleUI": { "t1": "18/26", "t2": "16/24", "b1": "15/22", "b2": "14/20", "c1": "12/18", "c2": "10/14" },
      "scaleMD": { "h1": "20/32", "h2": "18/28", "b1": "16/26", "b2": "15/24", "b3": "14/22" }
    },
    "spacing": { "base": "4px", "unit": "--spacing:.25rem" },
    "radius": { "md": "6px", "sm": "2px", "lg": "8px", "xl": "12px", "measured": ["md"], "derived": ["sm", "lg", "xl"] },
    "shadow": { "measured": false, "note": "no custom shadow tokens at source; dark uses Kimi-blue glow", "glow": "0 0 0 1px #1a88ff40, 0 0 28px #1a88ff33" }
  },
  "interactions": [
    { "name": "recruitment-map-glow-ray", "source": "RecruitmentMap module", "css": "hoverRayFade .12s; hoverRayGlow opacity 0->.95->.42" },
    { "name": "shuffle-char-scroll", "source": ".shuffle-char-wrapper", "desc": "per-character flip/scroll text reveal" },
    { "name": "retro-cursor", "source": "RetroCursorTheme", "desc": "pixel retro cursor on dark canvas" }
  ],
  "responsiveViewports": [360, 390, 430, 768, 834, 1024, 1280, 1440],
  "implementationChecklist": [
    "All colors via var(--*); no off-system hardcoded hex",
    "Kimi blue used <= 2 times per screen",
    "Text uses white/black alpha steps, not solid gray",
    "Dark layering via lightness + glow, no conventional shadows",
    "Numerals/labels in Fusion Pixel signature font",
    "No emoji icons; 1.7px monoline SVG",
    "No horizontal scroll across the 8 viewports"
  ]
