      "brandHover": { "light": "#167ff7", "dark": "#258eff" },
      "brandFocus": { "light": "#1783ff33", "dark": "#1a88ff33" },
      "success": { "light": "#16c456", "dark": "#16c456" },
      "warning": { "light": "#ff9500", "dark": "#ff9f0a" },
      "danger": { "light": "#ff3849", "dark": "#ff4756" },
      "yellow": { "light": "#ffd230", "dark": "#ffd230" },
      "neon": { "light": "#32ff7d", "dark": "#32ff7d" },
      "text1": { "light": "#000000e6", "dark": "#ffffffd6" },
      "text2": { "light": "#0009", "dark": "#ffffff8f" },
      "text3": { "light": "#00000073", "dark": "#ffffff6b" },
      "text4": { "light": "#0000004d", "dark": "#ffffff42" },
      "bg": { "light": "#f9fbfc", "dark": "#161717" },
      "bgSecondary": { "light": "#f5f5f5", "dark": "#121212" },
      "surface1": { "light": "#ffffff", "dark": "#1f1f1f" },
      "surface2": { "light": "#f5f5f5", "dark": "#292929" },
      "border": { "light": "#00000021", "dark": "#ffffff1f" },
      "line": { "light": "#0000000d", "dark": "#ffffff14" }
    },
    "typography": {
      "sans": "ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
