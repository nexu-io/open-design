{
  "name": "codex-motion-plugin",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build:studio && node --experimental-strip-types server.ts",
    "mcp": "node --experimental-strip-types mcp.ts",
    "start": "node --experimental-strip-types server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "node --experimental-strip-types scripts/check.ts",
    "package:plugin": "node --experimental-strip-types scripts/package.ts",
    "package:phase1": "npm run build:studio && node --experimental-strip-types scripts/package.ts --mcp-profile=phase1",
    "package:test": "node scripts/test-package.mjs",
    "package:npm": "npm run build:studio && node scripts/package-npm.mjs",
    "build:studio": "vite build --config studio/vite.config.ts",
    "typecheck:studio": "tsc -p studio/tsconfig.json",
    "design:tokens": "node --experimental-strip-types scripts/design-tokens.ts",
    "design:check": "node --experimental-strip-types scripts/design-check.ts",
    "pretest": "npm run build:studio",
    "prepackage:plugin": "npm run build:studio",
    "test:studio": "vitest run --config studio/vitest.config.ts",
    "verify:export": "node --experimental-strip-types scripts/verify-export.ts",
    "catalog:import": "node --experimental-strip-types scripts/import-hyperframes.ts",
    "catalog:covers": "node --experimental-strip-types scripts/cache-template-covers.ts",
    "catalog:metadata": "node --experimental-strip-types scripts/sync-template-metadata.ts",
    "export:adapters": "node --experimental-strip-types scripts/export-adapters.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.40.0",
    "@hyperframes/core": "0.9.7",
    "@hyperframes/parsers": "0.9.7",
    "@hyperframes/player": "0.9.7",
    "@hyperframes/sdk": "0.9.7",
    "@hyperframes/shader-transitions": "0.9.7",
    "@hyperframes/studio-server": "0.9.7",
    "@lezer/highlight": "1.2.5",
    "@mcp-b/global": "5.0.1",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.25",
    "acorn": "8.19.0",
    "cn": "0.2.4",
    "dockview-react": "8.3.1",
    "gsap": "3.15.0",
    "hyperframes": "0.9.7",
    "mediabunny": "1.45.3",
    "puppeteer-core": "25.16.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zustand": "5.0.11"
  },
  "overrides": {
    "undici": "7.30.1",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
